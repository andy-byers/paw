inline struct Tiny1 {
    x: char,
}

inline struct Tiny3 {
    x: char,
    y: char,
    z: char,
}

#[extern] pub fn get_tiny1(x: char) -> Tiny1;
#[extern] pub fn get_tiny3(x: char, y: char, z: char) -> Tiny3;

inline struct Small2 {
    x: char,
    y: int,
}

inline struct Small3 {
    x: bool,
    y: char,
    z: float,
}

#[extern] pub fn get_small2(x: char, y: int) -> Small2; 
#[extern] pub fn get_small3(x: bool, y: char, z: float) -> Small3 ;

inline struct Large3 {
    x: float,
    y: float,
    z: bool,
}

inline struct Large5 {
    x: int,
    y: int,
    z: Large3,
}

#[extern] pub fn get_large3(x: float, y: float, z: bool) -> Large3; 
#[extern] pub fn get_large5(x: int, y: int, z: Large3) -> Large5;

inline struct HFA2 {
    x: float,
    y: float,
}

inline struct HFA4 {
    x: float,
    y: HFA2,
    z: float,
}

#[extern] pub fn get_hfa2(x: float, y: float) -> HFA2;
#[extern] pub fn get_hfa4(x: float, y: HFA2, z: float) -> HFA4;

pub fn main(args: [str]) -> int {
    let Tiny1{x} = get_tiny1('a');
    assert(x == 'a');

    let Tiny3{x, y, z} = get_tiny3('A', 'B', 'C');
    assert(x == 'A');
    assert(y == 'B');
    assert(z == 'C');
    0
}

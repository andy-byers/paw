inline struct Tiny {
    x: char,
    y: char,
    z: char,
}

inline struct Small {
    x: char,
    y: int,
}

inline struct Large {
    x: int,
    y: float,
    z: bool,
}

inline struct HFA {
    x: float,
    y: float,
}

#[extern] pub fn get_tiny(x: char, y: char, z: char) -> Tiny;
#[extern] pub fn get_small(x: char, y: int) -> Small; 
#[extern] pub fn get_large(x: int, y: float, z: bool) -> Large; 
#[extern] pub fn get_hfa(x: float, y: float) -> HFA;

pub fn main(args: [str]) {
    println("running FFI test...");

    let Tiny{x, y, z} = get_tiny('A', 'B', 'C');
    assert(x == 'A');
    assert(y == 'B');
    assert(z == 'C');

    let Small{x, y} = get_small('1', 2);
    assert(x == '1');
    assert(y == 2);

    let Large{x, y, z} = get_large(1, 2.0, true);
    assert(x == 1);
    assert(y == 2.0);
    assert(z == true);

    let HFA{x, y} = get_hfa(10.0, 20.0);
    assert(x == 10.0);
    assert(y == 20.0);

    println("[PASS]");
}

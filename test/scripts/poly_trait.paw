// poly_trait.paw

// `T` can only be determined by unifying a concrete `ToSlice` trait
// reference from an impl block or generic bound
fn as_slice<S: ToSlice<T>, T>(value: S) -> []T {
    value.to_slice()
}

fn as_slice_2<S: ToSlice<T>, T>(value: S) -> []T {
    as_slice(value)
}

fn as_slice_str<S: ToSlice<str>>(value: S) -> []str {
    as_slice_2(value)
}

use list::List;

#[test]
pub fn infer_using_impl_trait_obligation() {
    let _ = as_slice([1, 2, 3]);
    let _ = as_slice_2([false, true]);
    let _ = as_slice_str(["x", "y", "z"]);
}


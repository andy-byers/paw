// disambiguate_using_projection.paw

struct Struct;

impl Eq<Struct> for Struct {
    fn eq(*self, rhs: *Struct) -> bool {
        true
    }
}

impl Eq<int64> for Struct {
    fn eq(*self, rhs: *int64) -> bool {
        false
    }
}

fn eq<X: Eq<int64> + Eq<X>>(t: X) {
    assert(<X as Eq<X>>::eq(&t, &t));
    assert(!<X as Eq<int64>>::eq(&t, &123));
}

#[test]
pub fn test() {
    eq(Struct);
    assert(<Struct as Eq<Struct>>::eq(&Struct, &Struct));
    assert(!<Struct as Eq<int64>>::eq(&Struct, &123));
}

// deferred_trait_selection.paw

// TODO: To make this work, add type annotations to `*32_key` variables and use that info to select the correct method, like we do with call args
//       Won't work otherwise b/c binary operators, "==" in this case, don't unify the lhs and rhs types when the lhs is a type variable (adds an 
//       obligation `Lhs: Op<Rhs>` to be proven later, but the binary op traits don't require lhs and rhs to be the same type, so `Lhs` cannot
//       be determined)

trait Key { fn key() -> Self; }
impl Key for int32 { fn key() -> Self {123} }
impl Key for uint32 { fn key() -> Self {456} }
pub fn key<T: Key>() -> T { T::key() }

#[test]
pub fn test() {
    let i32_key = key();
    let u32_key = key();
    assert(i32_key == 123i32);
    assert(u32_key == 456u32);
}

// test_list.paw

use list::List;

#[test]
pub fn push_and_pop() {
    let v = List::new();
    v.push(v.len());
    v.push(v.len());

    assert(v.len() == 2);
    assert(v[0] == 0);
    assert(v[1] == 1);

    while v.len() > 0 {
        v.pop();
    }
    assert(v.len() == 0);
}

fn list_from_iterator<I: IntoIterator>(iter: I) -> List<I::Item> {
    let list = List::new();
    for value in iter {
        list.push(value).unwrap();
    }
    list
}

fn test_list(n: int) -> List<int> {
    list_from_iterator(1..=n)
}

#[test]
pub fn iterate_over_empty_list() {
    let list = List::<int>::new();
    let iter = list.into_iter();
    assert(iter.next().is_none());
    assert(iter.next().is_none());
}

#[test]
pub fn iterate_over_nonempty_list() {
    let list = test_list(3);
    let iter = list.into_iter();
    assert(iter.next().unwrap() == 1);
    assert(iter.next().unwrap() == 2);
    assert(iter.next().unwrap() == 3);
    assert(iter.next().is_none());
    assert(iter.next().is_none());
}

#[test]
pub fn extend_list_with_list() {
    let list = List::<str>::new();
    list.push("a").unwrap();
    list.push("b").unwrap();
    list.push("c").unwrap();

    let list2 = List::new();
    list2.extend(&list).unwrap();
    assert(list2[0] == "a");
    assert(list2[1] == "b");
    assert(list2[2] == "c");

    let list2 = List::new();
    list2.push("x").unwrap();
    list2.extend_from_slice(list.to_slice()).unwrap();
    assert(list2[0] == "x");
    assert(list2[1] == "a");
    assert(list2[2] == "b");
    assert(list2[3] == "c");
}


// alias.paw

#[test]
pub fn test_primitive() {
    type I = int64;
    let i: I = 123;
    assert(i == 123);

    type S = str;
    let s: S = "abc";
    assert(s == "abc");
}

#[test]
pub fn test_tuple() {
    type U = ();
    let u: U = ();

    type T = (int64, str);
    let t: T = (123, "abc");
    assert(t.0 == 123);
    assert(t.1 == "abc");
}

use list;
use hashmap;

#[test]
pub fn test_container() {
    type L<T> = list::List<T>;
    let l: L<int64> = L::new();
    list_function(l);
}

fn list_function<T>(list: list::List<T>) {}


struct Mono {
    pub value: int64,
}

fn check_mono(m: Mono, n: int64) {
    assert(m.value == n);
}

#[test]
pub fn test_mono() {
    type M = Mono;

    let m: M = M{value: 123};
    check_mono(m, 123);

    let m = M{value: 456};
    check_mono(m, 456);
}

struct Poly<P> {
    pub value: P,
}

fn accepts_poly<T>(p: Poly<T>) { }

fn check_poly<T2>(p: Poly<T2>) {
    accepts_poly(p);
}

#[test]
pub fn test_poly() {
    type P<X> = Poly<X>;

    let p: P<int64> = P{value: 123};
    check_poly(p);

    let p = P{value: 456};
    check_poly(p);
}

struct Poly2<A, B> {
    pub first: A,
    pub second: B,
}

fn accepts_poly2<S, T>(p: Poly2<S, T>) { }

fn check_poly2<S2, T2>(p: Poly2<S2, T2>) {
    accepts_poly2(p);
}

#[test]
pub fn test_poly2() {
    type P<X, Y> = Poly2<X, Y>;

    let p: P<int64, str> = P{
        first: 123,
        second: "abc",
    };
    check_poly2(p);

    let p = P{
        first: 45.6,
        second: 789,
    };
    check_poly2(p);
}

#[test]
pub fn test_poly2_partial() {
    type P1<X> = Poly2<X, str>;

    let p: P1<int64> = P1{
        first: 123,
        second: "abc",
    };
    check_poly2(p);

    let p = P1{
        first: 456,
        second: "def",
    };
    check_poly2(p);

    type P2<Y> = Poly2<int64, Y>;

    let p: P2<str> = P2{
        first: 123,
        second: "abc",
    };
    check_poly2(p);

    let p = P2{
        first: 456,
        second: "def",
    };
    check_poly2(p);
}

fn check_nested_poly<T: Clone>(t: T) -> T {
    type P = Poly2<T, T>;

    check_poly2(P{
        first: t.clone(),
        second: t.clone(),
    });

    let p = P{
        first: t.clone(),
        second: t.clone(),
    };
    p.second.clone()
}

fn check_nested_poly2<T: Clone>(t: T) -> T {
    type P<X> = Poly2<X, T>;

    check_poly2(P{
        first: 456,
        second: t.clone(),
    });

    let p = P{
        first: 456,
        second: t.clone(),
    };
    p.second.clone()
}

#[test]
pub fn test_nested_poly() {
    assert(check_nested_poly("abc") == "abc");
    assert(check_nested_poly(123) == 123);
    assert(check_nested_poly2(4.56) == 4.56);
    assert(check_nested_poly2(true) == true);
}

#[test]
pub fn test_dependent() {
    type P<X> = Poly<X>;
    type L<Y> = list::List<P<Y>>;
    type M<Z> = hashmap::HashMap<int64, L<Z>>;
    let m: M<int64> = M::new();
    m.insert(123, L::new()).unwrap();
}

#[test]
pub fn test_global() {
    let gi: GI = 123;
    assert(gi == 123);

    let gf: GF = 4.56;
    assert(gf == 4.56);

    let gp = GP{value: gf};
    assert(gp.value == 4.56);

    let gp2 = GP2{
        first: gp,
        second: gf,
    };
    assert(gp2.first.value == gf);
    assert(gp2.second == gf);
}

type GI = int64;
type GF = float64;
type GP = Poly<GF>;
type GP2<X> = Poly2<Poly<X>, X>;

#[test]
pub fn test_imported() {
    type O<T> = Obj<T>;
    let o = O::new(123);
    assert(o.get_t() == 123);

    type P<T> = PolyExternal<T>;
    let p = P{value: 456};
}

#[test]
pub fn test_imported2() {
    type O<T> = mod_c::Obj<T>;
    let o = O{value: 789};
}


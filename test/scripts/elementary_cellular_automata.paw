// elementary_cellular_automata.paw

const INVERT_COLORS: bool = true;
const PADDING_VALUE: int = 0;

const OFF: int = 0;
const ON: int = 1;

use io;
use list::List;
use string::String;
use string_builder;

pub fn eca(num: int, rows: int, cols: int) -> mem::Result<String> {
    //
    //  4 | 8
    // ---+---
    //  1 | 2
    //
    let charset = [
        " ", "▖", "▗", "▄", 
        "▘", "▌", "▚", "▙", 
        "▝", "▞", "▐", "▟",
        "▀", "▛", "▜", "█",
    ];    

    let rule = List::new();
    for i in 0..8 {
        rule.push((num >> i) & 1);
    }

    let grid = List::new();
    while grid.len() < cols {
        grid.push(OFF)?;
    }
    grid[cols / 2] = ON;

    for r in 0..rows-1 {
        for c in 0..cols {
            let i = r * cols + c;

            let middle = grid[i];
            let high = if c > 0 { grid[i - 1] } else { PADDING_VALUE };
            let low = if c < cols-1 { grid[i + 1] } else { PADDING_VALUE };

            grid.push(rule[low + middle*2 + high*4]);
        }
    }

    let b = string_builder::Builder::new();
    for i in 0..rows/2 {
        for j in 0..cols/2 {
            let (r, c) = (i * 2, j * 2);
            let upper = r * cols + c;
            let lower = (r + 1) * cols + c;

            let LL = grid[lower];
            let Lr = grid[lower + 1] << 1;
            let uL = grid[upper] << 2;
            let ur = grid[upper + 1] << 3;

            let index = LL + Lr + uL + ur;
            if INVERT_COLORS { index = -index - 1; }
            b.append(charset[index])?;
        }
        b.append_char('\n')?;
    }
    Ok(b.string())
}


#[test]
pub fn test() {
    let result = eca(110, 96, 160).unwrap();
}



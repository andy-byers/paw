// chain.paw

fn positive_option(i: int64) -> Option<int64> {
    if i > 0 { 
        Some(i) 
    } else { 
        None 
    }
}

fn positive_even_option(i: int64) -> Option<int64> {
    i = positive_option(i)?;
    if i % 2 == 0 { 
        Some(i) 
    } else { 
        None 
    }
}

#[test]
pub fn test_option() {
    assert(positive_even_option(-2).is_none());
    assert(positive_even_option(1).is_none());
    assert(positive_even_option(2).unwrap() == 2);
}

fn positive_result(i: int64) -> Result<int64, str> {
    if i > 0 { 
        Ok(i) 
    } else { 
        Err("not positive") 
    }
}

fn positive_even_result(i: int64) -> Result<int64, str> {
    i = positive_result(i)?;
    if i % 2 == 0 { 
        Ok(i) 
    } else { 
        Err("not even")
    }
}

#[test]
pub fn test_result() {
    assert(positive_even_result(-2).unwrap_err() == "not positive");
    assert(positive_even_result(1).unwrap_err() == "not even");
    assert(positive_even_result(2).unwrap() == 2);
}

struct Padding;

struct Padded<T> {
    pub padding: Padding,
    pub padding2: Padding,
    pub value: T,
}

impl<T> Padded<T> {
    pub fn new(value: T) -> Self {
        Self{value, padding: Padding, padding2: Padding}
    }
}

fn different_positive_option(p: Padded<int64>) -> Option<Padded<int64>> {
    if p.value > 0 { 
        Some(p) 
    } else { 
        None 
    }
}

fn different_positive_even_option(p: Padded<int64>) -> Option<int64> {
    p = different_positive_option(p)?;
    if p.value % 2 == 0 { 
        Some(p.value) 
    } else { 
        None 
    }
}

#[test]
pub fn test_different_option() {
    assert(different_positive_option(Padded::new(-2)).is_none());

    assert(different_positive_even_option(Padded::new(-2)).is_none());
    assert(different_positive_even_option(Padded::new(1)).is_none());
    assert(different_positive_even_option(Padded::new(2)).unwrap() == 2);
}

fn different_positive_result(p: Padded<int64>) -> Result<Padded<int64>, str> {
    if p.value > 0 { 
        Ok(p) 
    } else { 
        Err("not positive") 
    }
}

fn different_positive_even_result(p: Padded<int64>) -> Result<int64, str> {
    p = different_positive_result(p)?;
    if p.value % 2 == 0 { 
        Ok(p.value) 
    } else { 
        Err("not even")
    }
}

#[test]
pub fn test_different_result() {
    assert(different_positive_even_result(Padded::new(-2)).unwrap_err() == "not positive");
    assert(different_positive_even_result(Padded::new(1)).unwrap_err() == "not even");
    assert(different_positive_even_result(Padded::new(2)).unwrap() == 2);
}

fn id<T>(value: T) -> T { value }

fn nonnegative(value: int64) -> Option<int64> {
    if value < 0 { return None }
    Some(value)
}

fn chain_stack_value(i: int64) -> Option<int64> {
    Some(id(nonnegative(i)?))
}

#[test]
pub fn test_chain_stack_value() {
    assert(chain_stack_value(-1).is_none());
    assert(chain_stack_value(1).unwrap() == 1);
}

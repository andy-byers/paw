// trait_impl.paw

use list::List;
use string::String;

pub trait TestAdd<Rhs> {
    type Output;

    fn test_add(*self, rhs: *Rhs) -> Self::Output;
}

struct Values<T> {
    pub values: List<T>,
}

impl<T: TestAdd<T, Output = T>> TestAdd<Self> for Values<T> {
    type Output = Self;
    fn test_add(*self, rhs: *Self) -> Self {
        let values = List::new();
        for i in 0..self.values.len() {
            let value = self.values[i].test_add(&rhs.values[i]);
            values.push(value).unwrap();
        }
        Self{values}
    }
}

impl TestAdd<Self> for int64 {
    type Output = Self;
    fn test_add(*self, rhs: *Self) -> Self {
        *self + *rhs
    }
}

impl TestAdd<Self> for String {
    type Output = Self;
    fn test_add(*self, rhs: *Self) -> Self {
        let result = Self::new();
        result.extend(self.to_slice()).unwrap();
        result.extend(rhs.to_slice()).unwrap();
        result
    }
}

#[test]
pub fn test_methods() {
    let x = Values{values: List::from_array([1, 2]).unwrap()};
    let y = Values{values: List::from_array([3, 4]).unwrap()};
    let z = x.test_add(&y);
    assert(z.values[0] == 4);
    assert(z.values[1] == 6);

    let x = Values{values: List::from_array([f"1".unwrap(), f"2".unwrap()]).unwrap()};
    let y = Values{values: List::from_array([f"3".unwrap(), f"4".unwrap()]).unwrap()};
    let z = x.test_add(&y);
    assert(z.values[0].as_str() == "13");
    assert(z.values[1].as_str() == "24");
}

fn call_methods<T: TestAdd<T, Output = T>>(u: List<T>, v: List<T>) -> Values<T> {
    let x = Values{values: u};
    let y = Values{values: v};
    x.test_add(&y)
}

#[test]
pub fn test_nested_methods() {
    let z = call_methods(
        List::from_array([10, 20]).unwrap(), 
        List::from_array([30, 40]).unwrap());
    assert(z.values[0] == 40);
    assert(z.values[1] == 60);

    let z = call_methods(
        List::from_array([f"10".unwrap(), f"20".unwrap()]).unwrap(), 
        List::from_array([f"30".unwrap(), f"40".unwrap()]).unwrap());
    assert(z.values[0].as_str() == "1030");
    assert(z.values[1].as_str() == "2040");
}


fn check_tuple_bindings(target: (int64, (int64, int64))) -> int64 {
    match target {
        (x, (1, 1))
        | (2, (x, 2))
        | (3, (3, x)) => {return x;},

        (1, 
            (y, 3)
            | (2, y)
            | (9, y)) => {return y;},

        _ => {return 6;},
    };
}

#[test]
pub fn test_tuple_bindings() {
    assert(check_tuple_bindings((1, (1, 1))) == 1);
    assert(check_tuple_bindings((2, (2, 2))) == 2);
    assert(check_tuple_bindings((3, (3, 3))) == 3);
    assert(check_tuple_bindings((4, (1, 1))) == 4);
    assert(check_tuple_bindings((2, (5, 2))) == 5);
    assert(check_tuple_bindings((3, (3, 6))) == 6);
}

fn check_int_bindings(target: int64) -> int64 {
    match target {
        x | x | x => x,
    }
}

#[test]
pub fn test_int_bindings() {
    assert(check_int_bindings(1) == 1);
    assert(check_int_bindings(11) == 11);
    assert(check_int_bindings(111) == 111);
}

fn check_match_tuple(target: (((int64,), int64), int64)) -> int64 {
    match target {
        (((a,), 1), 1)
        | (((2,), a), 2)
        | (((3,), 3), a) => {
            return a;
        },
        (((b,), 2)
        | ((1,), b), c)
        | (((3,), b), c) => {
            return b + c;
        },
        _ => {
            return -1;
        }
    };
}

#[test]
pub fn test_match_tuple() {
    let check = check_match_tuple;
    assert(check((((1,), 1), 1)) == 1);
    assert(check((((2,), 2), 2)) == 2);
    assert(check((((3,), 3), 3)) == 3);
    assert(check((((4,), 1), 1)) == 4);
    assert(check((((2,), 5), 2)) == 5);
    assert(check((((3,), 3), 6)) == 6);

    assert(check((((1,), 2), 3)) == 1 + 3);
    assert(check((((1,), 3), 2)) == 3 + 2);
    assert(check((((3,), 1), 2)) == 1 + 2);
}

struct Single<T> {
    pub value: T,
}

impl<T: Copy> Copy for Single<T> {}

fn check_match_struct_with_one_field(target: Single<int64>) -> int64 {
    match target {
        Single{value: 1 | 2 | 3} => {return 1;},
        Single{value: v} => {return v;},
    };
}

#[test]
pub fn test_match_struct_with_one_field() {
    let check = check_match_struct_with_one_field;
    assert(check(Single{value: 0}) == 0);
    assert(check(Single{value: 1}) == 1);
    assert(check(Single{value: 2}) == 1);
    assert(check(Single{value: 3}) == 1);
    assert(check(Single{value: 4}) == 4);
}

struct Multiple<T> {
    pub a: T,
    pub b: T,
    pub c: T,
}

impl<T: Copy> Copy for Multiple<T> {}

fn check_match_struct_with_multiple_fields(target: Multiple<int64>) -> int64 {
    match target {
        Multiple{
            b: 1 | 2 | 3,
            c: 1 | 2 | 3,
            a: 1 | 2 | 3,
        } => {
            return 1;
        },

        Multiple{b: 5, a: 4, c: 6}
        | Multiple{b: 6, a: 5, c: 7} 
        | Multiple{b: 7, a: 6, c: 8} => {
            return 2;
        },

        _ => {
            return 3;
        },
    };
}

#[test]
pub fn test_match_struct_with_multiple_fields() {
    let check = check_match_struct_with_multiple_fields;
    assert(check(Multiple{a: 4, b: 5, c: 6}) == 2);
}

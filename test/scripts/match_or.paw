// match_or.paw

fn check_int(target: int64) -> int64 {
    match target {
        0 | 2 => {return 1;},
        1 | 3 | 5 => {return 2;},
        4 | 6 => {return 3;},
        _ => {return 4;},
    };
}

#[test]
pub fn test_int() {
    assert(check_int(-1) == 4);
    assert(check_int(0) == 1);
    assert(check_int(1) == 2);
    assert(check_int(2) == 1);
    assert(check_int(3) == 2);
    assert(check_int(4) == 3);
    assert(check_int(5) == 2);
    assert(check_int(6) == 3);
    assert(check_int(7) == 4);
}


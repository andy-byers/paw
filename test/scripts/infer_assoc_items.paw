// infer_assoc_items.paw

struct Unit;

#[test]
pub fn test_option() {
    let o: Option<int64> = Some(123);
    let o = Some(1); 
    let o = None;
    o = Some(None); 
    o = Some(Some(Unit));
}

#[test]
pub fn test_result() {
    // o: Result<int64, str>
    let o = Ok(1); 
    o = Err("two");

    // o: Result<Result<bool, bool>, Unit>
    let o = Err(Unit);
    o = Ok(Ok(true)); 
    o = Ok(Err(false));
}

struct Obj<T> {
    inner: T,
}

impl<T: Copy> Obj<T> {
    pub fn new(x: T) -> Self {
        return Obj{inner: x};
    }

    pub fn get(self) -> T {
        return self.inner;
    }
}

#[test]
pub fn test_user_adt() {
    let o = Obj::new(123);
    assert(o.get() == 123);
}

fn infer_using_result() -> Option<Unit> {
    return None;
}

#[test]
pub fn test_infer_functions() {
    infer_using_result();

    let f = |x| Some(x);
    assert(f(123).unwrap() == 123);
}


struct Pair<A, B> {
    pub a: A,
    pub b: B,
}

#[test]
pub fn test_adt() {
    let v: Pair<int64, _> = Pair::<_, _>{a: 1, b: "b"};
    let v: Pair<_, _> = Pair::<_, str>{a: 1, b: "b"};
    let v: Pair<int64, str> = Pair::<_, _>{a: 1, b: "b"};
    let v: Pair<_, _> = Pair{a: 1, b: "b"};

    let v: Pair<_, _>; 
    v = Pair{a: 1, b: "b"};
}

#[test]
pub fn test_tuple() {
    let v: (_, _, _) = ("a", 2, 3.0);
    let v: (str, _, _) = ("b", 3, 4.0);
    let v: (str, int64, _) = ("c", 4, 5.0);

    let v: (_, _, _);
    v = ("d", 5, 6.0);
}

struct Unit<T>;

impl<T> Unit<T> {
    pub fn f(self, _: T) {}
}

#[test]
pub fn test_unit_struct() {
    let v: Unit<_> = Unit;
    v.f(123);

    let v = Unit::<_>;
    v.f("abc");
}


enum Enum<T> {
    First,
    Second(T),
    Third((T, T)),
}

fn match_enum(e: Enum<int64>) -> int64 {
    match e {
        Enum::First => 1,
        Enum::Second(a) => a,
        Enum::Third((a, b)) => a + b,
    }
}

#[test]
pub fn test_enum() {
    let a = Enum::<int64>::First;
    let b = Enum::<int64>::Second(123);
    let c = Enum::<int64>::Third((456, 789));

    assert(match_enum(Enum::First) == 1);
    assert(match_enum(Enum::Second(2)) == 2);
    assert(match_enum(Enum::Third((3, 4))) == 7);
}

struct Struct {
    pub x: (int64, [1]Option<*Struct>),
}

#[test]
pub fn test_misc() {
    let s = Struct{x: (1, [None])}; 
    assert(s.x.0 == 1);
    assert(s.x.1[0].is_none());

    let inner = Struct{x: (2, [None])};
    s.x.1[0] = Some(&inner);
    assert(s.x.0 == 1);
    assert(s.x.1[0].unwrap().x.0 == 2);
    assert(s.x.1[0].unwrap().x.1[0].is_none());
}

struct SpecialCase1 {
    pub string: str,
    pub array: [1]int64,
}

#[test]
pub fn test_special_case_1() {
    let data = [
        SpecialCase1{
            string: "a",
            array: [12],
        },
        SpecialCase1{
            string: "b",
            array: [34],
        },
    ];

    assert(data[0].array[0] == 12);
    assert(data[1].array[0] == 34);
}

struct SpecialCase2 {
    pub a: (int64, int64),
    pub b: int64,
}

fn get_b(s: SpecialCase2) -> int64 { s.b }

#[test]
pub fn test_special_case_2() {
    let x = SpecialCase2{
        a: (1, 2),
        b: 3, 
    };
    assert(get_b(x) == 3);
}

struct SpecialCase3 {
    pub value: Inner3,
}

enum Inner3 {
    First,
    Second(int64),
}

impl Inner3 {
    pub fn method(*self) {}
}

#[test]
pub fn test_special_case_3() {
    let s = SpecialCase3{
        value: Inner3::First,
    };

    s.value.method();
}

enum ZeroOrTwo {
    Zero,
    Two(str, str),
}

#[test]
pub fn test_enum_special_case_1() {
    let array = [ZeroOrTwo::Zero];

    match &array[0] {
        *ZeroOrTwo::Zero => (),
        _ => (),
    }
}

enum OneOrTwo {
    One(str),
    Two(str, str),
}

#[test]
pub fn test_enum_special_case_2() {
    let array = [OneOrTwo::One("x")];

    match &array[0] {
        *OneOrTwo::One(x) => (),
        _ => (),
    }
}

struct Empty;

impl Empty {
    pub fn method(*self) {}
}

fn id<T>(t: T) -> T { t }

#[test]
pub fn test_empty_struct() {
    let e = Empty;
    e.method();

    e = id(e);
}

// Return value of last function call in block result position must
// be moved to where the "inner" variable is stored for the outer
// call to "black_box".
#[test]
pub fn test_move_to_outer_stack() {
    let outer = black_box({
        let inner = black_box(1);
        black_box(black_box)(inner + 41)
    });
    assert(outer == 42);
}

// Same as "test_move_to_outer_stack", except the value that needs
// to be moved to the outer stack has a size of 2 VM registers.
#[test]
pub fn test_move_to_outer_stack_2() {
    let outer = black_box({
        let inner = black_box(1);
        let inner2 = black_box(2);
        black_box(black_box)((inner + 41, inner2 + 121))
    });
    assert(outer.0 == 42);
    assert(outer.1 == 123);
}

// Same as "test_move_to_outer_stack", except the value that needs
// to be overwritten is occupied by the first field of a tuple.
#[test]
pub fn test_move_to_outer_stack_3() {
    let outer = black_box({
        black_box(black_box)((0, 42)).1
    });
    assert(outer == 42);
}

// Same as "test_move_to_outer_stack_3", except the value that needs
// to be moved has a size of 2 VM registers.
#[test]
pub fn test_move_to_outer_stack_4() {
    let outer = black_box({
        black_box(black_box)((0u8, (42u8, 123u8))).1
    });
    assert(outer.0 == 42);
    assert(outer.1 == 123);
}

#[test]
pub fn array_literals() {
    let a: [0]int64 = [];
    let b: [1]int32 = [1];
    let c: [2]int16 = [2, 3];
    let d: [3]_ = [4, 5, 6_i8];
    let e = [7, 8, 9, 10];
}


// builtin_impl.paw

pub trait Repr {
    fn repr(&self) -> str;
}

impl Repr for int64 {
    fn repr(&self) -> str {
        self.to_str()
    }
}

impl Repr for str {
    fn repr(&self) -> str {
        "\"\{self}\""
    }
}

pub trait Combine<R: Repr> {
    fn combine(&self, r: R);
}

impl Combine<int64> for str {
    fn combine(&self, r: int64) {
        self ++= r.to_str();
    }
}

impl<R: Repr> Combine<R> for int64 {
    fn combine(&self, r: R) {
        self += #r.repr();
    }
}

pub fn combine_reprs<R: Repr + Combine<T>, T: Repr>(r: R, t: T) -> str {
    r.combine(t);
    r.repr()
}

#[test]
pub fn test() {
    assert(combine_reprs("abcdef", 123456) == "\"abcdef123456\"");
    assert(combine_reprs(123456, "abcdef") == "123464");
}


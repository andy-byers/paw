// mod_a.paw

use mod_b;

#[test]
pub fn test_external() {
    let e = mod_b::external("hello");
    assert(e.value == "hello");

    let e = mod_b::External{value: "world"};
    assert(e.value == "world");

    let e = mod_b::poly_external(42);
    assert(e.value == 42);

    let e = mod_b::PolyExternal{value: true};
    assert(e.value == true);
}

pub fn recursive(n: int) -> int {
    if n > 0 {
        return mod_b::recursive(n - 1) + 1;
    }
    return 0;
}

pub trait GetValue {
    fn get_value(*self) -> int;
}

pub fn poly_recursive<T: GetValue>(n: int, t: T, value: int) -> int {
    if n > 0 {
        return mod_b::poly_recursive(n - 1, t, value + t.get_value());
    }
    value
}

pub struct Test;

impl GetValue for Test {
    fn get_value(*self) -> int {
        123
    }
}

fn check_poly_recursive(n: int) {
    let result = poly_recursive(n, Test, 0);
    let expected = Test.get_value() 
        * (if n < 0 {0} else {n});
    assert(result == expected);
}

#[test]
pub fn test_recursive() {
    check_poly_recursive(-1);
    check_poly_recursive(1);
    check_poly_recursive(10);
}

pub fn should_never_run() {
    panic("this function should never be called");
}

pub fn get_test(k: str) -> fn() {
    if k == "external" {
        return test_external;
    } else if k == "recursive" {
        return test_recursive;
    } else {
        return should_never_run;
    }
}

pub fn return_42() -> int {
    return 42;
}

pub struct Obj<T> {
    t: T,
}

impl<T> Obj<T> {
    pub fn new(x: T) -> Self {
        return Self{t: x};
    }
    
    pub fn get_t(self) -> T {
        return self.t;
    }
}

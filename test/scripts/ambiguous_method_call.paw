// ambiguous_method_call.paw

// TODO: This test throws an error because it cannot find a method to call
//       due to the uninferred type argument. Requires multiple type
//       checker passes to resolve correctly.
//       On each pass, refine a list of candidates for each associated
//       function call. There should be only 1 candidate for each call at
//       the end of type checking.

pub trait Trait<T> {
    fn method(*self);
}

enum Type<T> {
    First, Second(T)
}

impl Trait<int> for Type<int> {
    fn method(*self) {}
}

impl Trait<float> for Type<float> {
    fn method(*self) {}
}

#[test]
pub fn test() {
    let e = Type::First;
    // TODO: should the following line be allowed? need to either resolve the method call in a separate pass over the fn body or keep a candidate list at the time the call site is visited and narrow it down as types are inferred... is it even worth it?
    e.method(); // e: Type<_>
    e = Type::Second(456);
    e.method(); // e: Type<int>
}


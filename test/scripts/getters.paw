// getters.paw

struct Test<T> {
    pub value: T,
}

#[test]
pub fn index_and_field_getters() {
    let x = [false];
    if x[0] {}

    let x = Test{value: false};
    if x.value {}

    let x = [Test{value: false}];
    if x[0].value {}

    let x = Test{value: [Test{value: false}]};
    if x.value[0].value {}
}


// short_circuiting.paw

#[test]
pub fn test() {
    let counts = (0, 0, 0);
    let pcounts = &counts;
    let check2 = |a: int64, b: int64| {
        assert(pcounts.0 == a);
        assert(pcounts.1 == b);
        pcounts.0 = 0;
        pcounts.1 = 0;
    };
    let A = |value: int64| -> bool {
        pcounts.0 = pcounts.0 + 1;
        return value as bool;
    };
    let B = |value: int64| -> bool {
        pcounts.1 = pcounts.1 + 1;
        return value as bool;
    };
    let C = |value: int64| -> bool {
        pcounts.2 = pcounts.2 + 1;
        return value as bool;
    };

    let or = |a: int64, b: int64| -> bool {
        return A(a) || B(b);
    };
    assert(!or(0, 0));
    check2(1, 1);
    assert(or(0, 1));
    check2(1, 1);
    assert(or(1, 0));
    check2(1, 0);
    assert(or(1, 1));
    check2(1, 0);

    let and = |a: int64, b: int64| -> bool {
        return A(a) && B(b);
    };
    assert(!and(0, 0));
    check2(1, 0);
    assert(!and(0, 1));
    check2(1, 0);
    assert(!and(1, 0));
    check2(1, 1);
    assert(and(1, 1));
    check2(1, 1);

    let check3 = |a: int64, b: int64, c: int64| {
        check2(a, b);
        assert(pcounts.2 == c);
        pcounts.2 = 0;
    };

    let and_or = |a: int64, b: int64, c: int64| -> bool {
        return A(a) && B(b) || C(c);
    };
    assert(!and_or(0, 0, 0));
    check3(1, 0, 1);
    assert(!and_or(1, 0, 0));
    check3(1, 1, 1);
    assert(!and_or(0, 1, 0));
    check3(1, 0, 1);
    assert(and_or(0, 0, 1));
    check3(1, 0, 1);
    assert(and_or(1, 1, 0));
    check3(1, 1, 0);
    assert(and_or(0, 1, 1));
    check3(1, 0, 1);
    assert(and_or(1, 0, 1));
    check3(1, 1, 1);
    assert(and_or(1, 1, 1));
    check3(1, 1, 0);
}

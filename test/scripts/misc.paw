// misc.paw

use list::List;

use io;
use io::File;

fn file_size(f: *File) -> int64 {
    f.seek(0, io::Seek::End);
    f.tell().unwrap()
}

#[test]
pub fn test_io() {
    let test = "test string";
    let file = File::open("abc.txt".to_slice(), "w+".to_slice()).unwrap();
    assert(file_size(&file) == 0);
    let n = file.write(test.to_slice()).unwrap();
    assert(n == test.len());

    let data = List::<char>::with_length(test.len()).unwrap();
    file.seek(0, io::Seek::Begin);
    assert(file.read(data.to_slice()).unwrap() == test.len());
    assert(file.tell().unwrap() as usize == n);
    assert(file_size(&file) as usize == n);
    assert(data.to_slice().eq(&test.to_slice()));
    let _ = file.close();
}


// poly_function.paw

use list::List;
use hashmap::HashMap;

fn map<A, B>(f: fn(A) -> B, a: List<A>) -> List<B> {
    let b = List::new();
    for v in a {
        b.push(f(v)).unwrap();
    }
    b
}

fn f2i(f: float) -> int {
    f as int
}

#[test]
pub fn test_explicit_instantiation() {
    let source = List::new();
    source.push(0.5).unwrap();
    source.push(1.6).unwrap();
    source.push(2.7).unwrap();
    source.push(3.8).unwrap();
    source.push(4.9).unwrap();

    let target = map::<float, int>(f2i, source);
    assert(target.len() == 5);
    assert(target[0] == 0);
    assert(target[1] == 1);
    assert(target[2] == 2);
    assert(target[3] == 3);
    assert(target[4] == 4);
}

fn self_recursive<T>(t: T, i: int) {
    if i > 0 {
        self_recursive(t, i - 1);
    }
}

#[test]
pub fn test_self_recursion() {
    self_recursive(true, 10);
    self_recursive(2, 11);
    let f = self_recursive::<float>;
    self_recursive(f, 12);
}

fn first_recursive<A, B, C>(a: A, b: B, c: C) {
    second_recursive(a, b, c);
}

fn second_recursive<X, Y, Z>(x: X, y: Y, z: Z) {
    if false {
        first_recursive(y, z, x);
    }
}

#[test]
pub fn test_recursive_instantiation() {
    first_recursive(1, 2.0, "three");
    second_recursive("four", 5.0, 6);
    second_recursive(|| 42, [f2i], map::<int, bool>);
}

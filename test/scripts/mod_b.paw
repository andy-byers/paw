// mod_b.paw

use mod_a;

pub struct External {
    pub value: str,
}

pub struct PolyExternal<T> {
    pub value: T,
}

impl<T: Clone> Clone for PolyExternal<T> {
    fn clone(*self) -> Self {
        Self{value: self.value.clone()}
    }
}

pub fn external(value: str) -> External {
    return External{value: value};
}

pub fn poly_external<X>(value: X) -> PolyExternal<X> {
    return PolyExternal{value: value};
}

pub fn recursive(n: int) -> int {
    if n > 0 {
        return mod_a::recursive(n - 1) + 1;
    }
    return 0;
}

pub fn poly_recursive<T: Clone + mod_a::GetValue>(n: int, t: T, value: int) -> int {
    if n > 0 {
        return mod_a::poly_recursive(n - 1, t.clone(), value + t.get_value());
    }
    value
}

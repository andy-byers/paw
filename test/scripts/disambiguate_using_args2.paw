// disambiguate_using_args2.paw

struct X;

trait A {
    fn func(*self, x: bool) -> int64;
}

trait B {
    fn func(*self, x: float64) -> int64;
}

impl A for X {
    fn func(*self, x: bool) -> int64 {
        1
    }
}
impl B for X {
    fn func(*self, x: float64) -> int64 {
        2
    }
}

fn funcs<T: A + B>(t: *T) -> (int64, int64) {
    (t.func(true), t.func(1.23))
}

#[test]
pub fn test() {
    let x = X;

    assert(x.func(false) == 1);
    assert(x.func(1.23) == 2);

    assert(funcs(&x).0 == 1);
    assert(funcs(&x).1 == 2);
}

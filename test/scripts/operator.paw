// operator.paw

#[test]
pub fn test_operator_precedence() {
    assert(5 == 1 + 2 * 3 - 4 / 2);
    assert(8 == 1 << 2 * 2 >> 1);
    assert(-3 == 1 | ~2 ^ 3 & 4);

    // "==" and "!=" bind tighter than "&&" and "||"
    assert(1 == 1 && 2 == 2) ;

    // Bitwise operators bind tighter than comparisons
    assert(4 & 5 == 4);
    assert(!((4 & (5 == 4) as int) as bool));
}

fn check_cmpc(a: char, b: char) {
    assert(a == a);
    assert(a != b);
    assert(a <= a);
    assert(a <= b);
    assert(a >= a);
    assert(b >= a);
    assert(a < b);
    assert(b > a);
}

fn check_cmpi(a: int, b: int) {
    assert(a == a);
    assert(a != b);
    assert(a <= a);
    assert(a <= b);
    assert(a >= a);
    assert(b >= a);
    assert(a < b);
    assert(b > a);
}

fn check_cmpf(a: float, b: float) {
    assert(a == a);
    assert(a != b);
    assert(a <= a);
    assert(a <= b);
    assert(a >= a);
    assert(b >= a);
    assert(a < b);
    assert(b > a);
}

fn check_cmps(a: str, b: str) {
    assert(a == a);
    assert(a != b);
    assert(a <= a);
    assert(a <= b);
    assert(a >= a);
    assert(b >= a);
    assert(a < b);
    assert(b > a);
}

#[test]
pub fn test_comparisons() {
    check_cmpc('a', 'b');
    check_cmpc('\x00', '\x01');
    check_cmpc('\xFE', '\xFF');

    check_cmpi(1, 2);
    check_cmpi(-1, 1);
    check_cmpi(123, 124);

    check_cmpf(1.1, 2.2);
    check_cmpf(-1.1, 1.2);
    check_cmpf(123.1, 124.2);

    check_cmps("a", "b");
    check_cmps("ab", "abc");
    check_cmps("abc", "abd");
}

#[test]
pub fn test_conversions() {
    assert(1 == true as int);
    assert(1.0 == true as float);
    assert(1 == 1 as int);
    assert(1.0 == 1 as float);
}

#[test]
pub fn test_bitwise_ops() {
    assert(0b0111 == 0b0110 | 0b0011);
    assert(0b0010 == 0b0110 & 0b0011);
    assert(0b0101 == 0b0110 ^ 0b0011);
}

#[test]
pub fn test_float_ops() {
    let _ = -0.5;
    let _ = 1.23 % 0.5;
}

// prevent constant folding
fn ten() -> int {10}

#[test]
pub fn test_operator_assignment() {
    let v = ten();
    v += 1;
    assert(v == 11);

    let v = ten();
    v -= 4;
    assert(v == 6);

    let v = ten();
    v *= 10;
    assert(v == 100);

    let v = ten();
    v /= -5;
    assert(v == -2);

    let v = ten();
    v %= 3;
    assert(v == 1);

    let v = ten();
    v &= 1;
    assert(v == 0);

    let v = ten();
    v |= 1;
    assert(v == 11);

    let v = ten();
    v ^= 10;
    assert(v == 0);

    let v = ten();
    v <<= 1;
    assert(v == 20);

    let v = ten();
    v >>= 1;
    assert(v == 5);
}

// prevent constant folding
fn nested_ten() -> [1](int,) {
    [(10,)]
}

#[test]
pub fn test_operator_assignment_projections() {
    let v = nested_ten();
    v[0].0 += 101;
    assert(v[0].0 == 111);
}

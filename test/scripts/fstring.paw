// fstring.paw

use io;
use fmt;
use string::String;

fn check_fstring(lhs: fmt::Result<String>, rhs: str) {
    let lhs = lhs.unwrap().to_slice();
    assert(lhs.eq(&rhs.to_slice()));
}

#[test]
pub fn test() {
    check_fstring(f"", "");
    check_fstring(f"abc", "abc");
    check_fstring(f"\{0x7B}", "123");
    check_fstring(f"abc\{123u8}def\{456i32}ghi", "abc123def456ghi");
}

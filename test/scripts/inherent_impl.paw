// inherent_impl.paw

use list::List;

struct Single<T> {
    value: T,
}

impl<T: Copy> Copy for Single<T> {}
impl<T: Copy> Copy for (Single<T>, Single<T>) {}

impl<T: Clone> Clone for Single<T> {
    fn clone(*self) -> Self {
        Self{value: self.value.clone()}
    }
}

impl<T: Clone> Clone for (Single<T>, Single<T>) {
    fn clone(*self) -> Self {
        (self.0.clone(), self.1.clone())
    }
}

impl<T: Clone> Single<T> {
    pub fn new(value: T) -> Self {
        Self{value}
    }

    pub fn value(*self) -> *T {
        &self.value
    }
}

impl Single<int64> {
    pub fn merge(*self, rhs: Self) {
        self.value += rhs.value;
    }
}

impl Single<float64> {
    pub fn merge(*self, rhs: Self) {
        self.value += rhs.value;
    }
}

impl Single<(Single<int64>, Single<int64>)> {
    pub fn sum(*self) -> int64 {
        *self.value.0.clone().value()
            + *self.value.1.clone().value()
    }
}

#[test]
pub fn test_methods() {
    let t = Single::new(1);
    assert(*t.value() == 1);
    t.merge(Single::new(2));
    assert(*t.value() == 3);

    let t = Single::new(1.0);
    assert(*t.value() == 1.0);
    t.merge(Single::new(2.0));
    assert(*t.value() == 3.0);

    let t = Single::new((Single::new(123), Single::new(0)));
    assert(t.sum() == 123);
    t.value().1 = Single::new(456);
    assert(t.sum() == 579);
}

fn call_methods<T: Clone>(t: T) -> T {
    Single::new(t).value().clone()
}

#[test]
pub fn test_nested_methods() {
    assert(call_methods(1) == 1);
    assert(call_methods("two") == "two");
}

struct Pair<X, Y> {
    first: X,
    second: Y,
}

impl<A: Copy, B: Copy> Pair<A, B> {
    pub fn new(first: A, second: B) -> Self {
        Self{first, second}
    }

    pub fn first(*self) -> A {
        self.first
    }

    pub fn second(*self) -> B {
        self.second
    }
}

// NOTE: order of type arguments is reversed
impl<X: Copy, Y: Copy> Pair<Y, X> {
    pub fn first2(*self) -> Y {
        self.first
    }

    pub fn second2(*self) -> X {
        self.second
    }
}

impl<T: Copy> Pair<T, T> {
    pub fn swap_fields(*self) {
        let temp = self.first;
        self.first = self.second;
        self.second = temp;
    }
}

#[test]
pub fn test_methods2() {
    let p = Pair::new(1, "two");
    assert(p.first() == 1);
    assert(p.second() == "two");
    assert(p.first2() == 1);
    assert(p.second2() == "two");

    let p = Pair::new(1, 2);
    p.swap_fields();
    assert(p.first() == 2);
    assert(p.second() == 1);
}

fn call_methods2<X: Copy, Y: Copy>(x: X, y: Y) -> (X, Y) {
    let p = Pair::new(x, y);
    (p.first(), p.second())
}

#[test]
pub fn test_nested_methods2() {
    let t = call_methods2(10, "20");
    assert(t.0 == 10);
    assert(t.1 == "20");
}


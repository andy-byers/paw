// test_map.paw

use hashmap::HashMap;

#[test]
pub fn get_from_empty_map() {
    let map = HashMap::<int64, int64>::new();
    assert(map.len() == 0);
    assert(map.get(&42).is_none());
}

#[test]
pub fn insert_and_get() {
    let map = HashMap::new();
    map.insert(1, 11).unwrap().unwrap_none();
    map.insert(2, 22).unwrap().unwrap_none();
    map.insert(3, 33).unwrap().unwrap_none();
    assert(*map.get(&1).unwrap() == 11);
    assert(*map.get(&2).unwrap() == 22);
    assert(*map.get(&3).unwrap() == 33);
    assert(map.len() == 3);
}

#[test]
pub fn index_operator() {
    let map = HashMap::new();
    map.insert(100, 111).unwrap().unwrap_none();
    assert(map[&100] == 111);
}

#[test]
pub fn handles_duplicate_keys() {
    let map = HashMap::new();
    map.insert(1, 10).unwrap().unwrap_none();
    assert(map.insert(1, 100).unwrap().unwrap() == 10);
    assert(map.len() == 1);

    assert(map.remove(&1).unwrap() == 100);
    map.remove(&1).unwrap_none();
    assert(map.len() == 0);
}

#[test]
pub fn stress_test() {
    let map = HashMap::<int64, int64>::new();
    let N = 2;

    for i in 0..N {
        map.insert(i, i + 1).unwrap().unwrap_none();
    }
    for i in N/2..N {
        assert(map.remove(&i).unwrap() == i + 1);
    }
    for i in -N/2..0 {
        map.insert(i, i - 100).unwrap().unwrap_none();
    }
    for i in 0..N/2 {
        assert(map.insert(i, i).unwrap().unwrap() == i + 1);
    }
    for i in N/2..N {
        map.insert(i, i + 100).unwrap().unwrap_none();
    }
    assert(map.len() as int64 == N + N / 2);

    for i in -N/2..0 {
        assert(map.remove(&i).unwrap() == i - 100);
    }
    for i in 0..N/2 {
        assert(map.remove(&i).unwrap() == i);
    }
    for i in N/2..N {
        assert(map.remove(&i).unwrap() == i + 100);
    }
    assert(map.len() == 0);
}

struct BadKey {
    pub value: int64,
}

impl Hash for BadKey {
    // cause a collision on each insertion
    fn hash(*self) -> uint64 { 0 }
}

impl Eq<Self> for BadKey {
    fn eq(*self, rhs: *Self) -> bool {
        self.value == rhs.value
    }
}

pub fn bk(value: int64) -> BadKey {
    BadKey{value}
}

#[test]
pub fn handles_lots_of_collisions() {
    let m = HashMap::new();
    let N = 500;

    m.insert(bk(-1), -1).unwrap().unwrap_none();
    m.insert(bk(-2), -2).unwrap().unwrap_none();
    m.insert(bk(-3), -3).unwrap().unwrap_none();

    for i in 0..N {
        m.insert(bk(i), i).unwrap().unwrap_none();
    }

    for i in 0..N {
        assert(m[&bk(i)] == i);
    }

    for i in 0..N {
        assert(m.remove(&bk(i)).unwrap() == i);
    }

    assert(*m.get(&bk(-1)).unwrap() == -1);
    assert(*m.get(&bk(-2)).unwrap() == -2);
    assert(*m.get(&bk(-3)).unwrap() == -3);
}

struct Int2 {
    pub x: int64,
    pub y: int64,
}

impl Int2 {
    pub fn new(x: int64, y: int64) -> Self {
        Self{x, y}
    }
}

impl Hash for Int2 {
    fn hash(*self) -> uint64 {
        self.x.hash() ^ self.y.hash()
    }
}
    
impl Eq<Self> for Int2 {
    fn eq(*self, rhs: *Self) -> bool {
        self.x == rhs.x && self.y == rhs.y
    }
}

#[test]
pub fn handles_large_items() {
    let map = HashMap::new();

    map.insert(Int2::new(-1, -2), -3).unwrap().unwrap_none();

    map.insert(Int2::new(1, 2), 12).unwrap();
    map.insert(Int2::new(3, 4), 34).unwrap();
    map.insert(Int2::new(5, 6), 56).unwrap();

    assert(map[&Int2::new(1, 2)] == 12);
    assert(map[&Int2::new(3, 4)] == 34);
    assert(map[&Int2::new(5, 6)] == 56);

    map.insert(Int2::new(1, 2), 21).unwrap().unwrap();
    map.insert(Int2::new(3, 3), 33).unwrap().unwrap_none();

    assert(map[&Int2::new(1, 2)] == 21);
    assert(map[&Int2::new(3, 3)] == 33);
    assert(map[&Int2::new(3, 4)] == 34);
    assert(map[&Int2::new(5, 6)] == 56);

    assert(map[&Int2::new(-1, -2)] == -3);
}

#[test]
pub fn strings_can_be_hashmap_keys() {
    let map = HashMap::<str, str>::new();
    map.insert("a", "A").unwrap().unwrap_none();
    map.insert("b", "B").unwrap().unwrap_none();
    map.insert("c", "C").unwrap().unwrap_none();
    assert(map[&"a"] == "A");
    assert(map[&"b"] == "B");
    assert(map[&"c"] == "C");
}

// basic.paw

pub fn function_syntax
(
    a
    : int64
    , b: int64) -> int64
{
    return
        a
        + b;
}

#[test]
pub fn test_syntax() 
{
    let x: int64 = 0;
    {;;;};;;{};;;
    {; x = 1; assert(x == 1);};
    x = x
      + 0 +
        1;
    assert(24 == function_syntax(1, 23));
}

fn call() {}

#[test]
pub fn test_expr_stmts() {
    let x = 1;
    2;
    "abc";
    x + 3;
    call();
}


// Translated from https://github.com/attractivechaos/plb2/blob/master/src/lua/matmul.lua

use list::List;

fn matgen(n: usize) -> List<List<float64>> {
    let tmp = 1.0 /
              n as float64 /
              n as float64;
    let a = List::new();
    for i in 0..n {
        let b = List::new();
        for j in 0..n {
            let x = tmp
                  * (i - j) as float64
                  * (i + j) as float64;
            b.push(x);
        }
        a.push(b);
    }
    a
}

fn matmul(n: usize, a: List<List<float64>>, b: List<List<float64>>) -> List<List<float64>> {
    let c = List::new();
    let i = 0;
    while i < n {
        let ci = List::new();
        let j = 0;
        while j < n {
            ci.push(0.0);
            j = j + 1;
        }
        let k = 0;
        while k < n {
            let aik = a[i][k];
            let bk = &b[k];
            let j = 0;
            while j < n {
                ci[j] = ci[j] + aik * bk[j];
                j = j + 1;
            }
            k = k + 1;
        }
        c.push(ci);
        i = i + 1;
    }
    return c;
}


#[test]
pub fn test() {
    let a = List::new();
    {
        let row = List::new();
        row.push(0.0);
        row.push(2.0);
        row.push(3.0);
        a.push(row);

        let row = List::new();
        row.push(1.0);
        row.push(2.0);
        row.push(3.0);
        a.push(row);

        let row = List::new();
        row.push(1.0);
        row.push(2.0);
        row.push(3.0);
        a.push(row);
    }

    let b = List::new();
    {
        let row = List::new();
        row.push(1.0);
        row.push(1.0);
        row.push(1.0);
        b.push(row);

        let row = List::new();
        row.push(2.0);
        row.push(2.0);
        row.push(2.0);
        b.push(row);

        let row = List::new();
        row.push(3.0);
        row.push(3.0);
        row.push(0.0);
        b.push(row);
    }

    let c = matmul(3, a, b);
    assert(c[0][0] == 13.0);
    assert(c[0][1] == 13.0);
    assert(c[0][2] == 4.0);
    assert(c[1][0] == 14.0);
    assert(c[1][1] == 14.0);
    assert(c[1][2] == 5.0);
    assert(c[2][0] == 14.0);
    assert(c[2][1] == 14.0);
    assert(c[2][2] == 5.0);
}

use io;

pub fn main() {
    let n = 100;
//    if #args > 1 {
//        n = args[1].parse_int().unwrap();
//    }
    let a = matgen(n);
    let b = matgen(n);
    let c = matmul(n, a, b);

//    print("\{c[n / 2][n / 2]}\n");
}

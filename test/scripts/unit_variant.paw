// unit_variant.paw

enum Unit {
    U,
}

impl Copy for Unit {}

impl Unit {
    pub fn method(self) {}
    pub fn assoc_function() {}
}


#[test]
pub fn test_init() {
    let u = Unit::U;
}

#[test]
pub fn test_init_annotated() {
    let u: Unit = Unit::U;
}

#[test]
pub fn test_copy() {
    let u = Unit::U;
    let u2 = u;
}

fn noop(_: Unit) {}

#[test]
pub fn test_as_argument() {
    let u = Unit::U;

    noop(u);
    noop(Unit::U);
}

#[test]
pub fn test_call_method() {
    Unit::U.method();
    Unit::assoc_function();

    let u = Unit::U;
    u.method();
}


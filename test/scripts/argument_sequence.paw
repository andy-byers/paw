// argument_sequence.paw

fn f<X, Y, Z>(x: X, y: Y, z: Z) -> (X, Y, Z) {
    (x, y, z)
}

#[test]
pub fn variable_assignment() {
    let v = 1;
    let t = f(v, v = 2, v);
    assert(t.0 == 1);
    assert(t.2 == 2);
}

#[test]
pub fn field_assignment() {
    let v = (0, 1);
    let t = f(v, v.1 = 2, v);
    assert(t.0.1 == 1);
    assert(t.2.1 == 2);
}


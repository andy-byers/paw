use list::List;

pub trait Key {
    fn key(self) -> int64;
}

struct Type<T> {
    pub value: T,
}

impl Key for int64 {
    fn key(self) -> int64 { 
        self 
    }
}

impl Key for List<str> {
    fn key(self) -> int64 {  
        let result = 0;
        for elem in self {
            result += elem.parse_int().unwrap();
        }
        result
    }
}

impl<Ty: Key> Key for Type<List<Ty>> {
    fn key(self) -> int64 { 
        let result = 0;
        for elem in &self.value {
            result += elem.key();
        }
        result
    }
}

impl<X, Y> Key for Type<(X, Y)> {
    fn key(self) -> int64 { 42 }
}

fn key<T: Key>(t: T) -> int64 {
    t.key()
}

fn unary_list<T>(t: T) -> List<T> {
    let list = List::new();
    list.push(t).unwrap();
    list
}

#[test]
pub fn test_polymorphic() {
    let strings = List::<str>::new();
    let k = key(strings);
    assert(k == 123);

    let string_lists = List::<List<_>>::new();
    string_lists.push({
        let inner = List::new();
        inner.push("1").unwrap();
        inner
    });
}

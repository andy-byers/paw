// float64.paw

#[test]
pub fn test_zeros() {
    assert(0.0 == 0.0);
    assert(0.00 == 0.0);
    assert(0.0e0 == 0.0);
    assert(0.0e1 == 0.0);
}

#[test]
pub fn test_exponents() {
    assert(1e1 == 10.0);
    assert(10e-1 == 1.0);
    assert(10e+1 == 100.0);
    assert(10e-001 == 1.0);
    assert(10e+001 == 100.0);
}

fn check_parse(s: str, o: Result<float64, ParseFloatError>) {
    match (s.parse_float(), o) {
        (Ok(a), Ok(b)) => assert(a == b),
        (Err(a), Err(b)) => assert(a.eq(&b)),
        _ => panic("check failed"),
    }
}

#[test]
pub fn test_parse_valid() {
    check_parse("0.0", Ok(0.0));
    check_parse("1.0", Ok(1.0));
    check_parse("10.0", Ok(10.0));
    check_parse("1e10", Ok(1e10));
    check_parse("1E10", Ok(1e10));
    check_parse("1e+10", Ok(1e+10));
}

#[test]
pub fn handles_empty_string() {
    check_parse("", Err(ParseFloatError::Empty));
}

#[test]
pub fn handles_invalid_chars() {
    check_parse("  1.0", Err(ParseFloatError::InvalidChar));
    check_parse("1.0  ", Err(ParseFloatError::InvalidChar));
    check_parse("  -1.0", Err(ParseFloatError::InvalidChar));
    check_parse("-1.0  ", Err(ParseFloatError::InvalidChar));
}

#[test]
pub fn test_parse_integer_as_float() {
    check_parse("0", Ok(0.0));
    check_parse("1", Ok(1.0));
    check_parse("100", Ok(100.0));
}

#[test]
pub fn test_parse_missing_leading_zero() {
    check_parse(".0", Ok(0.0));
}

#[test]
pub fn test_parse_missing_trailing_zero() {
    check_parse("0.", Ok(0.0));
}

#[test]
pub fn test_digit_separators() {
    assert(10_e1_0_0_ == 10e100);
    assert(1_0_.0_0e100 == 10e100);
}

#[test]
pub fn test_parse_int() {
    assert("123".parse_int_radix(10).unwrap() == 123);
}

#[test]
pub fn test_str_starts_with() {
    assert("abc".starts_with("a"));
    assert("abc".starts_with("ab"));
    assert("abc".starts_with("abc"));

    assert(!"abc".starts_with("b"));
    assert(!"abc".starts_with("bc"));
    assert(!"abc".starts_with("abcc"));
}

#[test]
pub fn test_str_ends_with() {
    assert("abc".ends_with("c"));
    assert("abc".ends_with("bc"));
    assert("abc".ends_with("abc"));

    assert(!"abc".ends_with("b"));
    assert(!"abc".ends_with("ab"));
    assert(!"abc".ends_with("aabc"));
}

use io;

#[test]
pub fn test_file() {
    let file = io::File::open("newfile", "w+").unwrap();
    file.write("this is a float \{"1.23".parse_float().unwrap()}!!").unwrap();
}

#[test]
pub fn test_list_of_str() {
    let list = ["a", "b", "c"];
    list.push("x");
    println(", ".join(list));
}

#[test]
pub fn test_nested_inout() {
    let inner = |&x: int| {
        x += 1;
    };

    let outer = |&x: int| {
        inner(x);
    };

    let n = 0;
    outer(n);
    assert(n == 1);
    outer(n);
    outer(n);
    assert(n == 3);
}

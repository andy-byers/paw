////////pub fn unification_special_case() -> int {
////////    match None {
////////        Some(v) => v,
////////        None => return -1,
////////    }
////////}
////////
////////pub fn try_operator_special_case() -> Option<int> {
////////    Some(Some(None?)?)
////////}

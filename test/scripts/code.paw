////////#[test]
////////pub fn test_list_push() {
////////    let list = [];
////////    list.push(1);
////////    list.push(2);
////////    list.push(3);
////////
////////    assert(#list == 3);
////////    assert(list[0] == 1);
////////    assert(list[-3] == 1);
////////    assert(list[1] == 2);
////////    assert(list[-2] == 2);
////////    assert(list[2] == 3);
////////    assert(list[-1] == 3);
////////}

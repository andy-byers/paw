////////#[test]
////////pub fn test_list() {
////////    let list = [
////////        1,
////////        2,
////////        3,
////////    ];
////////
////////    assert(list[0] == 1);
////////    assert(list[1] == 2);
////////    assert(list[2] == 3);
////////
////////    let v = list[0];
////////    list[0] = list[1];
////////    list[1] = list[2];
////////    list[2] = v;
////////
////////    assert(list[0] == 2);
////////    assert(list[1] == 3);
////////    assert(list[2] == 1);
////////}

////////pub inline struct Pair<T> {
////////    pub first: T,
////////    pub second: T,
////////}
////////
////////pub struct BoxedListWrapper { 
////////    pub list: [Pair<Option<str>>],
////////}
////////
////////#[test]
////////pub fn test_boxed_list_wrapper() {
////////    let blw = BoxedListWrapper{
////////        list: [
////////            Pair{first: Some("10"), second: None},
////////            Pair{first: Some("30"), second: None},
////////        ],
////////    };
////////
////////    match blw.list[0].first {Some(x) => assert(x == "10"), None => panic("A")}
////////    match blw.list[0].second {Some(_) => panic("B"), None => println("b")}
////////    match blw.list[1].first {Some(x) => assert(x == "30"), None => panic("C")}
////////    match blw.list[1].second {Some(_) => panic("D"), None => println("d")}
////////}

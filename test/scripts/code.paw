////////inline struct Functions {
////////    pub callees: (
////////        fn(int) -> int,
////////        fn(int) -> int)
////////}
////////
////////#[test]
////////pub fn test_fn_in_object() {
////////    let closure = |i| i + 1;
////////    
////////    let object = Functions{callees: (not_closure, closure)};
////////    assert(object.callees.0(1) == 1);
////////    assert(object.callees.1(2) == 3);
////////}
////////
////////#[test]
////////pub fn test_fn_in_container() {
////////    let closure = |i| i + 1;
////////    
////////    let list = [not_closure, closure];
////////    assert(list[0](1) == 1);
////////    assert(list[1](2) == 3);
////////}

////////struct Test<T> {
////////    pub value: T,
////////}
////////
////////pub trait Trait {
////////    type Type;
////////
////////    fn get(*self) -> Self::Type;
////////    fn set(*self, t: Self::Type);
////////}
////////
////////impl Trait for Test<int> {
////////    type Type = int;
////////
////////    fn get(*self) -> Self::Type {
////////        self.value
////////    }
////////    fn set(*self, t: Self::Type) {
////////        self.value = t;
////////    }
////////}
////////
////////impl Trait for Test<float> {
////////    type Type = float;
////////
////////    fn get(*self) -> Self::Type {
////////        self.value
////////    }
////////    fn set(*self, t: Self::Type) {
////////        self.value = t;
////////    }
////////}
////////
////////pub fn function<Ty: Trait>(t: Ty) -> Ty::Type {
////////    t.get()
////////}
////////
////////#[test]
////////pub fn test() {
////////    let t = Test{value: 123};
////////    t.set(456);
////////    let i = function(t);
////////    assert(i == 456);
////////
////////    let t = Test{value: 1.23};
////////    t.set(4.56);
////////    let f = function(t);
////////    assert(f == 4.56);
////////}

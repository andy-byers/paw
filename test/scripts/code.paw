////////pub fn map_test(map: [int: str], n: int, filter: int) {
////////    let i = 0;
////////    while i < n {
////////        if i % filter == 0 {
////////            map[i] = "abc";
////////        }
////////        i += 1;
////////    }
////////
////////    let i = 0;
////////    while i < n {
////////        if i % filter == 0 {
////////            assert(map[i] == "abc");
////////        }
////////        i += 1;
////////    }
////////}
////////
////////#[test]
////////pub fn test_map() {
////////    map_test([:], 10, 3);
////////    map_getset_no_collisions(10);
////////    map_getset_no_collisions(100);
////////}
////////
////////pub fn map_getset_no_collisions(n: int) {
////////    let map = [:];
////////
////////    let i = 1;
////////    while i < n {
////////        map[i] = i;
////////        i += 1;
////////    }
////////
////////    let i = 1;
////////    while i < n {
////////        assert(map[i] == i);
////////        i += 1;
////////    }
////////}
////////
////////pub fn map_getset(n: int) {
////////    let map = [:];
////////
////////    let i = n;
////////    while i > 0 {
////////        map[i] = i;
////////        i -= 1;
////////    }
////////
////////    let i = n;
////////    while i > 0 {
////////        assert(map[i] == i);
////////        i -= 1;
////////    }
////////}
////////
////////pub fn map_ops(n: int) {
////////    let map = [:];
////////
////////    let i = n;
////////    while i > 0 {
////////        map[i] = i;
////////        i -= 1;
////////    }
////////
////////    let i = n / 2;
////////    while i > 0 {
////////        map.remove(i);
////////        i -= 1;
////////    }
////////
////////
////////    let i = n;
////////    while i > n / 2 {
////////        assert(map.get_or(i, -1) == i);
////////        i -= 1;
////////    }
////////    while i > 0 {
////////        assert(map.get_or(i, -1) == -1);
////////        i -= 1;
////////    }
////////}
////////
////////pub fn fib(n: int) -> int {
////////    if n < 2 { return n }
////////    fib(n - 2) + fib(n - 1)
////////}
////////
////////pub fn limited_fib(n: int) -> Option<int> {
////////    let LIMIT = 35;
////////    if n < 2 { 
////////        Some(n)
////////    } else if n <= LIMIT { 
////////        Some(limited_fib(n - 2).unwrap() 
////////            + limited_fib(n - 1).unwrap())
////////    } else {
////////        None
////////    }
////////}

////////#[test]
////////pub fn test_nested_inout() {
////////    let inner = |*x| {
////////        x += 1;
////////    };
////////
////////    let outer = |*x| {
////////        inner(x);
////////    };
////////
////////    let n = 0;
////////    outer(n);
////////    assert(n == 1);
////////    outer(n);
////////    outer(n);
////////    assert(n == 3);
////////}

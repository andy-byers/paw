////////#[test]
////////pub fn test_upvalues() {
////////    let f = {
////////        let a = 1;
////////        let f = || {
////////            a += 1;
////////            a
////////        };
////////        assert(a == 1);
////////        assert(f() == 2);
////////        assert(a == 2);
////////        f
////////    };
////////    assert(f() == 3);
////////    assert(f() == 4);
////////    assert(f() == 5);
////////}
////////
////////#[test]
////////pub fn test_upvalues_2() {
////////    let a = 1;
////////    let f = || {
////////        let b = 2;
////////        let g = || {
////////            let c = 3;
////////            let h = || {
////////                a + b + c
////////            };
////////            h()
////////        };
////////        g()
////////    };
////////    assert(f() == 1 + 2 + 3);
////////}
////////
////////#[test]
////////pub fn test_upvalues_3() {
////////    let a = 1;
////////    let f = || {
////////        let b = 2;
////////        || {
////////            let c = 3;
////////            a + b + c
////////        }
////////    };
////////    assert(f()() == 1 + 2 + 3);
////////}
////////
////////#[test]
////////pub fn test_upvalues_4() {
////////    let a = 1;
////////    let f = || {
////////        let b = 2;
////////        || {
////////            let c = 3;
////////            || {
////////                a + b + c
////////            }
////////        }
////////    };
////////    assert(f()()() == 1 + 2 + 3);
////////}

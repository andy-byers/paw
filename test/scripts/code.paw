// code.paw
  
inline struct InlineFlat1 {
    pub v: int,
}

pub fn create_flat1(v: int) -> InlineFlat1 {
    InlineFlat1{v}
}

pub fn check_flat1(s: InlineFlat1, v: int) {
    assert(s.v == v);
}

inline struct InlineFlatN {
    pub a: int,
    pub b: char,
    pub c: bool,
}

pub fn create_flatn(a: int, b: char, c: bool) -> InlineFlatN {
    InlineFlatN{a, b, c}
}

pub fn check_flatn(s: InlineFlatN, a: int, b: char, c: bool) {
    assert(s.a == a);
    assert(s.b == b);
    assert(s.c == c);
}

inline struct InlineNested1 {
    pub v: InlineFlat1,
}

pub fn create_nested1(v: int) -> InlineNested1 {
    InlineNested1{v: InlineFlat1{v}}
}

pub fn check_nested1(s: InlineNested1, v: int) {
    assert(s.v.v == v);
}

inline struct InlineNestedN {
    pub a: InlineFlat1,
    pub b: InlineNested1,
    pub c: InlineFlatN,
}

pub fn create_nestedn(v: int, vv: int, a: int, b: char, c: bool) -> InlineNestedN {
    InlineNestedN{a: InlineFlat1{v}, b: InlineNested1{v: InlineFlat1{v: vv}}, c: InlineFlatN{a, b, c}}
}

pub fn check_nestedn(s: InlineNestedN, v: int, vv: int, a: int, b: char, c: bool) {
    assert(s.a.v == v);
    assert(s.b.v.v == vv);
    assert(s.c.a == a);
    assert(s.c.b == b);
    assert(s.c.c == c);
}

#[test]
pub fn test_flat1() {
    let s = create_flat1(1);
    check_flat1(s, 1);
    s = create_flat1(2);
    check_flat1(s, 2);

    let sa = create_flat1(1);
    let sb = sa;
    sb.v = 2;
    check_flat1(sa, 1);
    check_flat1(sb, 2);
}

#[test]
pub fn test_flatn() {
    let s = create_flatn(2, '1', false);
    check_flatn(s, 2, '1', false);
    s = create_flatn(3, '2', true);
    check_flatn(s, 3, '2', true);

    let sa = create_flatn(0, '0', false);
    let sb = sa;
    sb.a = 1;
    sb.c = true;
    check_flatn(sa, 0, '0', false);
    check_flatn(sb, 1, '0', true);
}

#[test]
pub fn test_nested1() {
    let s = create_nested1(1);
    check_nested1(s, 1);
    s = create_nested1(2);
    check_nested1(s, 2);

    let sa = create_nested1(1);
    let sb = sa;
    sb.v.v = 2;
    check_nested1(sa, 1);
    check_nested1(sb, 2);
}

#[test]
pub fn test_nestedn() {
    let s = create_nestedn(1, 1, 1, '1', true);
    check_nestedn(s, 1, 1, 1, '1', true);
    s = create_nestedn(1, 2, 3, '4', false);
    check_nestedn(s, 1, 2, 3, '4', false);

    let sa = create_nestedn(0, 0, 0, '0', false);
    let sb = sa;
    sb.b.v.v = 2;
    sb.c.a = 3;
    sb.c.c = true;
    check_nestedn(sa, 0, 0, 0, '0', false);
    check_nestedn(sb, 0, 2, 3, '0', true);
}

#[test]
pub fn test_list() {
    let list = [
        1,
        2,
        3,
    ];

    assert(list[0] == 1);
    assert(list[1] == 2);
    assert(list[2] == 3);

    let v = list[0];
    list[0] = list[1];
    list[1] = list[2];
    list[2] = v;

    assert(list[0] == 2);
    assert(list[1] == 3);
    assert(list[2] == 1);
}

#[test]
pub fn test_flat1_list() {
    let list = [
        create_flat1(1),
        create_flat1(2),
        create_flat1(3),
    ];
    check_flat1(list[0], 1);
    check_flat1(list[1], 2);
    assert(list[2].v == 3);

    list[1].v = 20;
    list[2] = InlineFlat1{v: 30};

    check_flat1(list[0], 1);
    check_flat1(list[1], 20);
    check_flat1(list[2], 30);
}

#[test]
pub fn test_flatn_list() {
    let list = [
        create_flatn(1, '1', false),
        create_flatn(2, '2', false),
        create_flatn(3, '3', false),
    ];
    check_flatn(list[0], 1, '1', false);
    check_flatn(list[1], 2, '2', false);
    assert(list[2].a == 3);
    assert(list[2].b == '3');
    assert(list[2].c == false);

    list[1].a = 20;
    list[1].c = true;
    list[2] = InlineFlatN{a: 30, b: list[2].b, c: true};

    check_flatn(list[0], 1, '1', false);
    check_flatn(list[1], 20, '2', true);
    check_flatn(list[2], 30, '3', true);
}

#[test]
pub fn test_nested1_list() {
    let list = [
        create_nested1(1),
        create_nested1(2),
        create_nested1(3),
    ];
    check_nested1(list[0], 1);
    check_nested1(list[1], 2);
    assert(list[2].v.v == 3);

    list[1].v.v = 20;
    list[2] = InlineNested1{v: InlineFlat1{v: 30}};

    check_nested1(list[0], 1);
    check_nested1(list[1], 20);
    check_nested1(list[2], 30);
}

#[test]
pub fn test_nestedn_list() {
    let list = [
        create_nestedn(1, 1, 1, '1', false),
        create_nestedn(2, 2, 2, '2', false),
        create_nestedn(3, 3, 3, '3', false),
    ];
    check_nestedn(list[0], 1, 1, 1, '1', false);
    check_nestedn(list[1], 2, 2, 2, '2', false);
    assert(list[2].a.v == 3);
    assert(list[2].b.v.v == 3);
    assert(list[2].c.a == 3);
    assert(list[2].c.b == '3');
    assert(list[2].c.c == false);

    list[1].b.v.v = 20;
    list[1].c.b = 'X';
    list[1].c.c = true;
    list[2] = create_nestedn(1, 2, 3, '4', true);

    check_nestedn(list[0], 1, 1, 1, '1', false);
    check_nestedn(list[1], 2, 20, 2, 'X', true);
    check_nestedn(list[2], 1, 2, 3, '4', true);
}

pub inline struct Pair<T> {
    pub first: T,
    pub second: T,
}

pub struct BoxedListWrapper { 
    pub list: [Pair<Option<str>>],
}

#[test]
pub fn test_boxed_list_wrapper() {
    let blw = BoxedListWrapper{
        list: [
            Pair{first: Some("10"), second: None},
            Pair{first: Some("30"), second: None},
        ],
    };

    match blw.list[0].first {Some(x) => assert(x == "10"), None => panic("A")}
    match blw.list[0].second {Some(_) => panic("B"), None => println("b")}
    match blw.list[1].first {Some(x) => assert(x == "30"), None => panic("C")}
    match blw.list[1].second {Some(_) => panic("D"), None => println("d")}
}

pub fn map_test(map: [int: str], n: int, filter: int) {
    let i = 0;
    while i < n {
        if i % filter == 0 {
            map[i] = "abc";
        }
        i += 1;
    }

    let i = 0;
    while i < n {
        if i % filter == 0 {
            assert(map[i] == "abc");
        }
        i += 1;
    }
}

#[test]
pub fn test_map() {
    map_test([:], 10, 3);
    map_getset_no_collisions(10);
    map_getset_no_collisions(100);
}
pub fn map_getset_no_collisions(n: int) {
    let map = [:];

    let i = 1;
    while i < n {
        map[i] = i;
        i += 1;
    }

    let i = 1;
    while i < n {
        assert(map[i] == i);
        i += 1;
    }
}

pub fn map_getset(n: int) {
    let map = [:];

    let i = n;
    while i > 0 {
        map[i] = i;
        i -= 1;
    }

    let i = n;
    while i > 0 {
        assert(map[i] == i);
        i -= 1;
    }
}

pub fn map_ops(n: int) {
    let map = [:];

    let i = n;
    while i > 0 {
        map[i] = i;
        i -= 1;
    }

    let i = n / 2;
    while i > 0 {
        map.remove(i);
        i -= 1;
    }


    let i = n;
    while i > n / 2 {
        assert(map.get_or(i, -1) == i);
        i -= 1;
    }
    while i > 0 {
        assert(map.get_or(i, -1) == -1);
        i -= 1;
    }
}

pub fn fib(n: int) -> int {
    if n < 2 { return n }
    fib(n - 2) + fib(n - 1)
}

pub fn limited_fib(n: int) -> Option<int> {
    let LIMIT = 35;
    if n < 2 { 
        Some(n)
    } else if n <= LIMIT { 
        Some(limited_fib(n - 2).unwrap() 
            + limited_fib(n - 1).unwrap())
    } else {
        None
    }
}

#[test]
pub fn mandelbrot() {
    let charmap = [
        " ", ".", ":", "-", "=",
        "+", "*", "#", "%", "@",
    ];

    let x0 = -2.1;
    let x1 = 0.9;
    let nx = 80;
    let y0 = -1.3;
    let y1 = 1.3;
    let ny = 24;

    assert(nx > 0 && ny > 0);
    let dy = (y1 - y0) / (ny - 1) as float;
    let dx = (x1 - x0) / (nx - 1) as float;

    let i = 0;
    while i < ny {
        let j = 0;
        let y = y0 + i as float * dy;
        while j < nx {
            let x = x0 + j as float * dx;
            let zi = 0.0;
            let zr = 0.0;
            let i = 0;
            while i < 100 {
                if zi*zi+zr*zr >= 4.0 {
                    break;
                }
                let zz = zr*zr - zi*zi + x;
                zi = 2.0*zr*zi + y;
                zr = zz;
                i = i + 1;
            }
            print(charmap[i % 10]);
            j += 1;
        }
        print("\n");
        i += 1;
    }
}

inline struct Abc {
    pub value: int,
    pub fn alter(&self, value: int) -> Self {
        self.value = value + 1;
        self
    }
}

#[test]
pub fn test_self_pointer() {
    let abc = Abc{value: 123};
    assert(abc.value == 123);
    abc.alter(100);
    assert(abc.value == 101);

    let abc = Abc{value: 123};
    assert(abc.alter(100).value == 101);
    assert(abc.value == 101);
}

#[test]
pub fn test_upvalues() {
    let f = {
        let a = 1;
        let f = || {
            a += 1;
            a
        };
        assert(a == 1);
        assert(f() == 2);
        assert(a == 2);
        f
    };
    assert(f() == 3);
    assert(f() == 4);
    assert(f() == 5);
}

#[test]
pub fn test_upvalues_2() {
    let a = 1;
    let f = || {
        let b = 2;
        let g = || {
            let c = 3;
            let h = || {
                a + b + c
            };
            h()
        };
        g()
    };
    assert(f() == 1 + 2 + 3);
}

#[test]
pub fn test_upvalues_3() {
    let a = 1;
    let f = || {
        let b = 2;
        || {
            let c = 3;
            a + b + c
        }
    };
    assert(f()() == 1 + 2 + 3);
}

#[test]
pub fn test_upvalues_4() {
    let a = 1;
    let f = || {
        let b = 2;
        || {
            let c = 3;
            || {
                a + b + c
            }
        }
    };
    assert(f()()() == 1 + 2 + 3);
}

fn random(n: int) -> [int] {
    let a = [];
    let x = n;
    while #a < n {
        x = (140_671_485 * x + 12_820_163) % 16_777_216;
        a.push(x);
    }
    return a;
}

fn bubble(n: int) -> [int] {
    let a = random(n);
    while true {
        let swapped = false;
        let i = 1;
        while i < n {
            if a[i] < a[i - 1] {
                let t = a[i];
                a[i] = a[i - 1];
                a[i - 1] = t;
                swapped = true;
            }
            i = i + 1;
        }
        if !swapped {
            break;
        }
    }
    return a;
}

#[test]
pub fn test_bubble() {
    let n = 2000;
    bubble(n);
}

#[test]
pub fn test_list_push() {
    let list = [];
    list.push(1);
    list.push(2);
    list.push(3);

    assert(#list == 3);
    assert(list[0] == 1);
    assert(list[-3] == 1);
    assert(list[1] == 2);
    assert(list[-2] == 2);
    assert(list[2] == 3);
    assert(list[-1] == 3);
}

pub fn get_fn(v: int) -> (fn() -> int) {
    || v
}

pub fn get_fn2(v: int) -> (fn() -> fn() -> int) {
    || || v
}

#[test]
pub fn test_return_fn() {
    let f = get_fn(1);
    assert(f() == 1);

    let f = get_fn2(2);
    assert(f()() == 2);
}

fn not_closure(i: int) -> int { i }

#[test]
pub fn test_fn_argument() {
    let call_fn = |f: fn(int) -> int| {
        assert(f(1) == 1);
    };
    let closure = |i| i + 1;
    let call_fns = |f: fn(int) -> int, g: fn(int) -> int| {
        assert(f(2) == g(1));
    };
    call_fns(not_closure, closure);
}

inline struct Functions {
    pub callees: (
        fn(int) -> int,
        fn(int) -> int)
}

#[test]
pub fn test_fn_in_object() {
    let closure = |i| i + 1;
    
    let object = Functions{callees: (not_closure, closure)};
    assert(object.callees.0(1) == 1);
    assert(object.callees.1(2) == 3);
}

#[test]
pub fn test_fn_in_container() {
    let closure = |i| i + 1;
    
    let list = [not_closure, closure];
    assert(list[0](1) == 1);
    assert(list[1](2) == 3);
}

#[test]
pub fn test_range_iterator() {
    let range = 1..3;
    assert(range.start == 1);
    assert(range.end == 3);
    let iter = RangeIterator::new(range);
    assert(iter.next().unwrap() == 1);
    assert(iter.next().unwrap() == 2);
    assert(iter.next().is_none());
}

#[test]
pub fn test_range_inclusive_iterator() {
    let range = 1..=3;
    assert(range.start == 1);
    assert(range.end == 3);
    let iter = RangeInclusiveIterator::new(range);
    assert(iter.next().unwrap() == 1);
    assert(iter.next().unwrap() == 2);
    assert(iter.next().unwrap() == 3);
    assert(iter.next().is_none());
}

#[test]
pub fn test_to_str() {
    assert("\{'x'}" == "x");
    assert("\{123}" == "123");
}


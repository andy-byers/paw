// unit_struct.paw

struct Unit;

impl Unit {
    pub fn method(self) {}
    pub fn assoc_function() {}
}

#[test]
pub fn test_init() {
    let u = Unit;
}

#[test]
pub fn test_init_annotated() {
    let u: Unit = Unit;
}

#[test]
pub fn test_copy() {
    let u = Unit;
    let u2 = u;
}

#[test]
pub fn test_as_argument() {
    let u = Unit;
    let f = |x| {};

    f(u);
    f(Unit);
}

#[test]
pub fn test_call_method() {
    // looks strange, since "Unit" is in both a value (nullary type 
    // constructor) and a type
    Unit.method();
    Unit::assoc_function();

    let u = Unit;
    u.method();
}


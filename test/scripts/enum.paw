// enum.paw

enum Unit {
    X,
}

enum Unit2 {
    X,
    Y,
}

#[test]
pub fn test_unit_enum() {
    let e = Unit::X;
    e = Unit::X;

    let e = Unit2::X;
    e = Unit2::Y;
}

enum Data {
    X,
    Y(int),
}

fn move_data_enum(e: Data) -> Data {
    let e2 = e;
    return e2;
}

#[test]
pub fn test_data_enum() {
    let e = Data::X;
    e = Data::Y(42);

    let e = move_data_enum(Data::X);
    let e = move_data_enum(Data::Y(42));
}


// tuple_impl.paw

impl (int, bool) {
    pub fn set_values(*self) {
        self.0 = -1;
        self.1 = false;
    }
}

impl<T: Copy> (T, T) {
    pub fn set_values(*self, t: T) {
        self.0 = t;
        self.1 = t;
    }
}

impl<X, Y: Copy> (X, (Y, Y)) {
    pub fn set_values(*self, x: X, y: Y) {
        self.0 = x;
        self.1.0 = y;
        self.1.1 = y;
    }
}

#[test]
pub fn tuple_inherent_methods() {
    let t = (1, true);
    t.set_values();
    assert(t.0 == -1);
    assert(t.1 == false);

    let t = ("a", "b");
    t.set_values("abc");
    assert(t.0 == "abc");
    assert(t.1 == "abc");

    let t = ((0,), (1, 2));
    t.set_values((1,), 2);
    assert(t.0.0 == 1);
    assert(t.1.0 == 2);
    assert(t.1.1 == 2);
}

pub trait Key<T: Copy> {
    fn key(*self) -> T;
}

impl Key<int> for (int, int) {
    fn key(*self) -> int {
        self.0 + self.1
    }
}

impl<T: Copy> Key<T> for (bool, T, T) {
    fn key(*self) -> T {
        if self.0 { 
            self.1 
        } else { 
            self.2 
        } 
    }
}

fn call_key<K: Key<T>, T>(k: K) -> T {
    k.key()
}

fn ifelse<T: Copy>(b: bool, x: T, y: T) -> T {
    call_key((b, x, y))
}

#[test]
pub fn tuple_trait_methods() {
    let t = (1, 23);
    assert(call_key(t) == 24);

    assert(ifelse(false, 10, 11) == 11);
    assert(ifelse(true, 10, 11) == 10);
}

// iterator.paw

use list::List;
use hashmap::HashMap;

#[test]
pub fn test_iterator_for_loop() {
    let i = 1;
    let list = List::new();
    list.push(1).unwrap();
    list.push(2).unwrap();
    list.push(3).unwrap();
    for e in list {
        assert(e == i);
        i = i + 1;
    }

    let i = 0;
    let map = HashMap::new();
    map.insert(1, 1).unwrap().unwrap_none();
    map.insert(2, 2).unwrap().unwrap_none();
    map.insert(3, 3).unwrap().unwrap_none();
    for (k, v) in map {
        assert(k == v);
        i = i + v;
    }
    assert(i == 6);
}

fn test_list<I: IntoIterator<Item = int>>(iter: I) -> List<int> {
    let list = List::new();
    for i in iter { list.push(i).unwrap() }
    list
}

#[test]
pub fn test_misc() {
    let N = 2;
    {
        let a = List::new();
        for i in 0..N {
            for j in test_list(0..=0) {
                a.push(i + j).unwrap();
            }
        }
        assert(a.len() == 2);
        assert(a[0] == 0);
        assert(a[1] == 1);
    }
    {
        let a = List::new();
        for i in 0..N {
            let j = 0;
            while j < N {
                a.push(i + j).unwrap();
                j = j + 1;
            }
        }
        assert(a.len() == 4);
        assert(a[0] == 0);
        assert(a[1] == 1);
        assert(a[2] == 1);
        assert(a[3] == 2);
    }
    {
        let a = List::new();
        for i in 0..N {
            for j in test_list(0..=0) {
                let k = 0;
                while k < N {
                    a.push(i + j + k).unwrap();
                    k = k + 1;
                }
            }
        }
        assert(a.len() == 4);
        assert(a[0] == 0);
        assert(a[1] == 1);
        assert(a[2] == 1);
        assert(a[3] == 2);
    }
    {
        let I = test_list(0..4);
        for i in 0..4 {
            assert(i == I[i]);
        }

        let n = 0;
        let I = test_list(2..=3);
        for i in 2..4 {
            assert(i == I[n]);
            n = n + 1;
        }
    }

    {
        let n = 0;
        for i in 0..8 {
            n = n + 1;
            break;
        }
        assert(n == 1);
    }

    {
        let a = 42;
        while true {
            let b = 1;
            while true {
                break;
            }
            {
                assert(b == 1);
                break;
            }
            let c = 2;
            let d = 3;
        }
        assert(a == 42);
    }
}


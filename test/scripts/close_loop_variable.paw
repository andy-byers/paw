// close_loop_variable.paw: Ensure that "for" loops close over the loop variable
//     at the end of each iteration. This causes the captured upvalue to retain
//     the value it had when it was captured, rather than the value taken during 
//     the last iteration.

pub fn run_close_test(f: fn(int64) -> int64, lower: int64, upper: int64) {
    assert(f(-1) == lower);
    assert(f(10) == upper);
    for i in 0..10 {
        assert(f(i) == i);
    }
}

pub fn check_close_by_return(n: int64) -> int64 {
    let closure = None;
    for i in 0..10 {
        if i == n {
            closure = Some(|| i);
            break;
        }        
    }
    match closure {
        Some(f) => f(),
        None => -1,
    }
}

#[test]
pub fn test_close_by_return() {
    run_close_test(check_close_by_return, -1, -1);
}

pub fn check_close_by_scope_exit(n: int64) -> int64 {
    let closure = None;
    for i in 0..10 {
        if i == n {
            closure = Some(|| i);
        }        
    }
    match closure {
        Some(f) => f(),
        None => -1,
    }
}

#[test]
pub fn test_close_by_scope_exit() {
    run_close_test(check_close_by_scope_exit, -1, -1);
}

pub fn check_close_by_break(n: int64) -> int64 {
    let closure = None;
    for i in 0..10 {
        // NOTE: ">=" instead of ">", to test that "break" exits the loop
        if i >= n {
            closure = Some(|| i);
            break;
        }        
    }
    match closure {
        Some(f) => f(),
        None => -1,
    }
}

#[test]
pub fn test_close_by_break() {
    run_close_test(check_close_by_break, 0, -1);
}

pub fn check_close_by_continue(n: int64) -> int64 {
    let closure = None;
    for i in 0..10 {
        if i == n {
            closure = Some(|| i);
            continue;
        } 
    }
    match closure {
        Some(f) => f(),
        None => -1,
    }
}

#[test]
pub fn test_close_by_continue() {
    run_close_test(check_close_by_continue, -1, -1);
}

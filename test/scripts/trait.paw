// trait.paw

pub trait InstanceGet {
    fn get(*self) -> int64;
}

pub trait AssociatedGet {
    fn get_default() -> int64;
}

struct Int {
    pub value: int64,
}

impl InstanceGet for Int {
    fn get(*self) -> int64 {
        self.value
    }
}

impl AssociatedGet for Int {
    fn get_default() -> int64 {
        42
    }
}

#[test]
pub fn test_call_method() {
    let i = Int{value: 123};
    assert(i.get() == 123);
}

fn call_method<Ty: InstanceGet>(t: *Ty) -> int64 {
    t.get()
}

fn call_call_method<Ty: InstanceGet>(t: *Ty) -> int64 {
    call_method(t)
}

#[test]
pub fn test_indirect_call_method() {
    let i = Int{value: 42};
    assert(call_method(&i) == 42);
    assert(call_call_method(&i) == 42);
}

#[test]
pub fn test_call_associated_fn() {
    assert(Int::get_default() == 42);
}

fn call_both_functions<Ty: InstanceGet + AssociatedGet>(t: *Ty) -> int64 {
    t.get() + Ty::get_default()
}

fn call_call_both_functions<Ty: AssociatedGet + InstanceGet>(t: *Ty) -> int64 {
    call_both_functions::<Ty>(t)
}

#[test]
pub fn test_indirect_call_both_functions() {
    let i = Int{value: 123};
    assert(call_both_functions(&i) == 123 + 42);
    assert(call_call_both_functions(&i) == 123 + 42);
}

pub trait TestDefault {
    fn default() -> Self;
    fn get(*self) -> str;
}

struct TestDefaultStructA {
    pub value: str,    
}

impl TestDefault for TestDefaultStructA {
    fn default() -> Self {
        Self{value: "A"}
    }
    fn get(*self) -> str {
        self.value
    }
}

struct TestDefaultStructB {
    pub value: str,    
}

impl TestDefault for TestDefaultStructB {
    fn default() -> Self {
        Self{value: "B"}
    }
    fn get(*self) -> str {
        self.value
    }
}

// Type parameter "T" appears in the function body, but not the signature
fn generics_not_in_signature<T: TestDefault>() -> str {
    T::default().get()
}

#[test]
pub fn test_generics_not_in_signature() {
    assert(generics_not_in_signature::<TestDefaultStructA>() == "A");
    assert(generics_not_in_signature::<TestDefaultStructB>() == "B");
}

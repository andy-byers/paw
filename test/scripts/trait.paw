pub trait InstanceGet {
    fn get(self) -> int;
}

pub trait AssociatedGet {
    fn get_default() -> int;
}

fn call_inst<Ty: InstanceGet>(t: Ty) -> int {
    // fn InstanceGet::get(self) -> int
    // fn Ty::get() -> int
    t.get()
}



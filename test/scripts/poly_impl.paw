// poly_impl.paw

pub trait Key {
    fn key(*self) -> int64;
}

impl Key for int64 {
    fn key(*self) -> int64 {
        *self
    }
}

impl Key for str {
    fn key(*self) -> int64 {
        self.len() as int64
    }
}

pub trait Key2<K: Key> {
    fn key2(*self) -> int64;
}

struct Poly<T> {
    pub value: T,
}

impl<T: Key> Key2<T> for Poly<T> {
    fn key2(*self) -> int64 {
        self.value.key()
    }
}

pub fn call_key2<K: Key>(p: *Poly<K>) -> int64 {
    p.key2()
}

#[test]
pub fn test() {
    let p = Poly{value: 123};
    assert(p.key2() == 123);
    assert(call_key2(&p) == 123);

    let p = Poly{value: "abc"};
    assert(p.key2() == 3);
    assert(call_key2(&p) == 3);
}


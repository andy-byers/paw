// bubble.paw

use list::List;

fn random(n: int) -> List<int> {
    let a = List::new();
    let x = n;
    while a.len() < n {
        x = (140_671_485 * x + 12_820_163) % 16_777_216;
        a.push(x);
    }
    a
}

fn bubble(n: int) -> List<int> {
    let a = random(n);
    while true {
        let swapped = false;
        let i = 1;
        while i < n {
            if a[i] < a[i - 1] {
                let t = a[i];
                a[i] = a[i - 1];
                a[i - 1] = t;
                swapped = true;
            }
            i = i + 1;
        }
        if !swapped {
            break;
        }
    }
    return a;
}


#[test]
pub fn test() {
    let sorted = bubble(1000);
    for i in 1..sorted.len() {
        assert(sorted[i - 1] <= sorted[i]);
    }
}


use io;

pub fn main() -> int {
//    let n = if #args > 1 {

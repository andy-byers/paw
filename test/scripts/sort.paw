// sort.paw

use array;
use iter;

fn check_sort_unstable<A: ToSlice<int>>(unsorted: A, sorted: A) {
    let unsorted = unsorted.to_slice();
    let sorted = sorted.to_slice();
    unsorted.sort_unstable();
    for (a, b) in iter::zip(unsorted, sorted) {
        match a.cmp(b) {
            Ordering::Equal => (),
            _ => panic("elements are out of order"),
        }
    }
}

#[test]
pub fn test_sort_unstable() {
    check_sort_unstable([], []);
    check_sort_unstable([1], [1]);
    check_sort_unstable(
        [1, 2, 7, 0], 
        [0, 1, 2, 7]);
    check_sort_unstable(
        [9, 2, 4, 1, 5, 7, 0], 
        [0, 1, 2, 4, 5, 7, 9]);
}


// loop.paw

use list::List;
use hashmap::HashMap;

#[test]
pub fn test_basic_loop() {
    let n = 0;
    for i in 0..3 { 
        n = n + i;
    }
    assert(n == 3);
}

#[test]
pub fn test_basic_loop_2() {
    let one = 1;
    for i in 0..8 {
        let a = -1;
        let b = -1;
    }
    let two = 2;
    for i in 1..8 {
        for j in 1..i {}
    }
    assert(one + two == 3);
}

#[test]
pub fn test_inclusive_loop() {
    let n = 0;
    for i in 0..=3 { 
        n = n + i;
    }
    assert(n == 6);
}

#[test]
pub fn test_numeric_for_loop() {
    let test = |start: int64, end: int64| -> int64 {
        let n = 0;
        for i in start..end {
            n = n + 1;
        }
        n
    };
    assert(test(0, 0) == 0);
    assert(test(0, -1) == 0);
    assert(test(-1, 1) == 2);
    assert(test(-10, 10) == 20);

    // Loop bounds are copied onto the stack when the loop starts. Changing them
    // during the loop has no effect.
    let n = 0;
    let N = 10;
    for i in 0..N {
        n = n + 1;
        N = 0;
    }
    assert(n == 10);

    let test = |n| {
        let f = None;
        for i in 0..100 {
            if i == n {
                // Capture "i", the loop variable, when it is equal to "n". It should
                // retain this value in the closure, since "i" is closed over at the
                // end of the loop iteration.
                f = Some(|| i);
            }
        }
        f.unwrap()
    };
    assert(test(0)() == 0);
    assert(test(10)() == 10);
    assert(test(50)() == 50);
}

#[test]
pub fn test_nested_loops() {
    for i in 0..=8 {
        for j in 0..i {
            for k in j..=8 {
                assert(j < i);
                assert(j <= k);
            }
        }
    }
}

#[test]
pub fn test_capture_loop_var_0() {
    let test = |n| {
        let f = None;
        for i in 0..100{
            if i == n {
                f = Some(|| i);
            }
        }
        f.unwrap()
    };
    let t = test(10);
    assert(t() == 10);
    assert(t() == 10);
    let t = test(50);
    assert(t() == 50);
    assert(t() == 50);
}

#[test]
pub fn test_capture_loop_var_1() {
    let test = |n| {
        for i in 0..100 {
            if i == n {
                return Some(|| {
                    i + n
                });
            }
        }
        None
    };
    assert(test(-1).is_none());

    let t = test(10).unwrap();
    assert(t() == 20);
    assert(t() == 20);
}

fn check_capture_loop_var_2(b: bool) -> int64 {
    let f = None;
    let n = 0;
    for i in 0..8 {
        {
            n = n + 1;
            let m = n;
            f = Some(|| m + n);

            // Need to emit instructions to close "m" at the break and continue
            // statements.
            if b {
                break;
            } else {
                continue;
            }
        }
    }
    f.unwrap()()
}

#[test]
pub fn test_capture_loop_var_continue() {
    assert(check_capture_loop_var_2(false) == 16);
}

#[test]
pub fn test_capture_loop_var_break() {
    assert(check_capture_loop_var_2(true) == 2);
}

#[test]
pub fn test_while_loop() {
    let test = |n| {
        let count = 0;
        while count < n {
            count = count + 1;
        }
        return count;
    };
    assert(test(0) == 0);
    assert(test(1) == 1);
    assert(test(10) == 10);
}

#[test]
pub fn test_break_continue_0() {
    let a = "A";
    let b = "B";
    for i in 0..100 {
        let b = "C";
        let c = "C";
        let d = "D";
        a = c;
        b = d;
        if i == 10 {
            break;
        } else {
            continue;
        }
    }
    let a = a;
    let b = b;
    assert(a == "C");
    assert(b == "B");
}

#[test]
pub fn test_break_continue_1() {
    let a = "A";
    let b = "B";
    for i in 0..100 {
        let b = "C";
        let c = "C";
        let d = "D";
        a = c;
        b = d; // "b" shadowed
        if i == 10 {
            break;
        } else {
            continue;
        }
    }
    let a = a;
    let b = b;
    assert(a == "C");
    assert(b == "B");
}

#[test]
pub fn test_break_continue_2() {
    let n = -1;
    for i in 0..3 {
        if i == 2 {
            break;
        }
        n = i;
    }
    assert(n == 1);

    let n = -1;
    for i in 0..3 {
        if i == 2 {
            continue;
        }
        n = i;
    }
    assert(n == 1);

    // Capture loop variable "i" as an upvalue.
    let test = |n| {
        let f = None;
        for i in 0..100 {
            if i == n {
                let u = i;
                f = Some(|| -> int64 {
                    n + i + u
                });
                break;
            }
        }
        f.unwrap()
    };
    assert(test(0)() == 0);
    assert(test(10)() == 30);
    assert(test(50)() == 150);

    let i = 0;
    while true {
        i = i + 1;
        break;
    }

    assert(i == 1);

    let i = 0;
    while true {
        if i == 10 {
            break;
        }
        i = i + 1;
    }

    assert(i == 10);

    let i = 0;
    while true {
        i = i + 1;
        if i >= 10 { 
            break; 
        } else {
            continue;
        }
    } 

    assert(i == 10);

    let i = 0;
    let n = 0;
    while true {
        i = i + 1;
        if i & 1 != 0 {
            continue;
        }
        n = n + 1;
        if i >= 10 { break; }
    }

    assert(n == 5);

    let i = 0;
    let n = 0;
    while true {
        i = i + 1;
        if i & 1 != 0 {
            continue;
        } else if i == 10 {
            break;
        }
        n = n + 1;
    }

    assert(n == 4);
} 

#[test]
pub fn test_loop_bounds_are_constant() {
    let n = 0;
    let N = 10;
    for i in 0..N {
        n = n + 1;
        N = 0;
    }
    assert(n == 10);
}

#[test]
pub fn test_break_continue_3() {
    let n = 0;
    for i in 0..8 {
        n = n + 1;
        break;
    }
    assert(n == 1);

    let test = |n: int64| -> int64 {
        let count = 0;
        for i in 0..100 {
            if i == n {
                break;
            }
            count = count + 1;
            continue;
        }
        return count;
    };
    assert(test(-1) == 100);
    assert(test(0) == 0);
    assert(test(25) == 25);
    assert(test(50) == 50);
}

#[test]
pub fn test_shadowed_by_loop_var() {
    let i = -1;

    // "i" shadowed by loop variable.
    for i in 0..8 {}
    assert(i == -1);
}

#[test]
pub fn test_load_and_store_instruction() {
    let i = 0;
    while true {
        i = i + 1;
        if i == 10 { 
            break; 
        }
    }
}


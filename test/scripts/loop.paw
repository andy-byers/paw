pub struct CustomRangeElement {
    pub value: int64,
}

impl Clone for CustomRangeElement {
    fn clone(*self) -> Self {
        Self{value: self.value}
    }
}

impl Eq<Self> for CustomRangeElement {
    fn eq(*self, rhs: *Self) -> bool {
        self.value == rhs.value
    }
}

impl Ord<Self> for CustomRangeElement {
    fn cmp(*self, rhs: *Self) -> Ordering {
        if self.value < rhs.value {
            Ordering::Less
        } else if self.value > rhs.value {
            Ordering::Greater
        } else {
            Ordering::Equal
        }
    }
}

impl Increment for CustomRangeElement {
    fn increment(*self) {
        self.value += 1;
    }
}

#[test]
pub fn test_custom_range() {
    let start = CustomRangeElement{value: 1};
    let end = CustomRangeElement{value: 10};
    let index = start.value;
    for i in start..end {
        assert(i.value == index);
        index = index + 1;
    }
}

pub struct CustomIterator<T> {
    pub self: CustomIterable<T>,
    pub iter: usize,
}

impl<T: Clone> Iterator for CustomIterator<T> {
    type Item = (usize, T);
    fn next(*self) -> Option<(usize, T)> {
        let iter = self.iter;
        if iter < self.self.elems.len() {
            self.iter = self.iter + 1;
            Some((iter, self.self.elems[iter].clone()))
        } else {
            None
        }
    }
}

pub struct CustomIterable<T> {
    pub elems: List<T>,
}

impl<T: Clone> IntoIterator for CustomIterable<T> {
    type Item = (usize, T);
    type IntoIter = CustomIterator<T>;
    fn into_iter(self) -> CustomIterator<T> {
        CustomIterator{self, iter: 0}
    }
}

#[test]
pub fn test_custom_iterator() {
    let c = CustomIterable{
        elems: List::from_array([1, 2, 3, 4, 5]).unwrap(),
    };
    let index = 0;
    for (x, y) in c {
        assert(x == y - 1);
    }
}

fn bare_loop_with_break() {
    loop {
        break;
    }
}

fn bare_loop_with_return(v: int64) -> int64 {
    loop {
        return v;
    }
}

fn bare_loop_with_conditional_break(v: int64) {
    loop {
        if v != 0 {
            break;
        }
    }
}

fn bare_loop_with_conditional_return(v: int64) -> int64 {
    loop {
        if v != 0 {
            return v;
        }
    }
}

fn bare_loop_with_conditional_return_or_break(v: int64) -> int64 {
    loop {
        if v != 0 {
            return v;
        } else {
            break;
        }
    }
    assert(v == 0);
    v + 1
}

#[test]
pub fn test_bare_loop() {
    bare_loop_with_break();
    assert(bare_loop_with_return(1) == 1);
    bare_loop_with_conditional_break(2);
    assert(bare_loop_with_conditional_return(3) == 3);
    
    assert(bare_loop_with_conditional_return_or_break(0) == 1);
    assert(bare_loop_with_conditional_return_or_break(4) == 4);
}

#[test]
pub fn test_loop_from() {
    for i in 10.. {
        assert(i == 10);
        break;
    }

    for i in 10.. {
        if i > 100 {
            break;
        }
    }
}

#[test]
pub fn test_range_from_loop_syntax_special_case() {
    for i in 0..{0; break} { 
        // not part of loop
    }
}

#[test]
pub fn test_range_loop_syntax_special_case_2() {
    for i in {0}..if true {1} else {2} - 1 { 
        panic("should never run");
    }
}

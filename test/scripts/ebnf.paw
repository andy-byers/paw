//
// File I/O
//

use fmt;
use io;
use hashmap::HashMap;
use list::List;
use os;
use string::String;
use string_builder;

const CHUNK_SIZE: int64 = 1 << 12;

fn read_to_string(path: str) -> io::Result<String> {
    let file = io::File::open(path, "r")?;

    let chunk = List::<char>::with_length(CHUNK_SIZE);
    let result = string_builder::Builder::new();
    loop {
        match file.read(chunk.to_slice())? {
            0 => return Ok(result.string()),
            n => result.append(chunk),
        };
    }
}


//
// Tokenizer
//

fn is_alpha(c: char) -> bool {
    ('a'..='z').contains(c) || ('A'..='Z').contains(c)
}

fn is_numeric(c: char) -> bool {
    ('0'..='9').contains(c)
}

fn is_alnum(c: char) -> bool {
    is_alpha(c) || is_numeric(c)
}

fn is_hex(c: char) -> bool {
    ('a'..='f').contains(c) || ('A'..='F').contains(c) || is_numeric(c)
}

struct SourceLoc {
    pub line: int64,
    pub column: int64,
}

impl SourceLoc {
    pub fn to_string(self) -> String {
        f"\{self.line}:\{self.column}".unwrap()
    }
}

struct Scanner {
    token: Token,
    location: SourceLoc,
    source: str,
    index: usize,
}

impl Scanner {
    pub fn new(source: str) -> Self {
        let location = SourceLoc{line: 0, column: 0};
        let scanner = Self{
            token: Token{kind: TokenKind::Eof, data: "", location},
            index: 0,
            location,
            source,
        };
        scanner.skip();
        scanner
    }

    pub fn location(self) -> SourceLoc {
        self.location
    }

    pub fn token(self) -> Token {
        self.token
    }

    pub fn skip(self) {
        self.token = self.advance();
    }

    fn get_char(self) -> char {
        if self.index < self.source.len() {
            let c = self.source[self.index];
            if c == '\r' || c == '\n' {
                self.location.line += 1;
                self.location.column = 0;
            }
            c
        } else {
            '\0'
        }
    }

    fn peek_char(self, n: usize) -> char {
        if self.index < self.source.len() - n {
            self.source[self.index + n]
        } else {
            '\0'
        }
    }

    fn skip_char(self) {
        self.location.column += 1;
        self.index += 1;
    }

    fn advance(self) -> Token {
        self.skip_whitespace();

        let loc = self.location;
        let kind = match self.get_char() {
            '"' => return self.scan_string(),
            c if is_alpha(c) || c == '_' => return self.scan_ident(),
            '(' if self.peek_char(1) == '*' => return self.scan_comment(),
            '.' if self.peek_char(1) == '.' => {
                self.skip_char(); // skip '.'
                TokenKind::DotDot
            },

            '|' => TokenKind::Pipe,
            '.' => TokenKind::Dot,
            '=' => TokenKind::Equals,
            '(' => TokenKind::LeftParen,
            ')' => TokenKind::RightParen,
            '[' => TokenKind::LeftSquare,
            ']' => TokenKind::RightSquare,
            '{' => TokenKind::LeftCurly,
            '}' => TokenKind::RightCurly,
            '-' => TokenKind::Hyphen,
            '\0' => TokenKind::Eof,

            c => TokenKind::Error(TokenErrorKind::UnknownToken),
        };
        self.skip_char();
        self.new_token(loc, kind, "")
    }

    fn skip_whitespace(self) {
        loop {
            match self.get_char() {
                ' ' | '\r' | '\n' | '\t' | '\f' | '\v' 
                    => self.skip_char(),
                _ => break,
            }
        }
    }

    fn new_token(self, location: SourceLoc, kind: TokenKind, data: str) -> Token {
        Token{data: data, kind, location}
    }

    fn new_error(self, location: SourceLoc, kind: TokenErrorKind, data: str) -> Token {
        self.new_token(location, TokenKind::Error(kind), data)
    }

    fn scan_comment(self) -> Token {
        self.skip_char(); // skip '('
        self.skip_char(); // skip '*'

        let loc = self.location;
        let data = string_builder::Builder::new();

        loop {
            match self.get_char() {
                // reached EOF: block comment was not terminated
                '\0' => return self.new_error(loc, TokenErrorKind::UnterminatedComment, data.string()),

                '*' if self.peek_char(1) == ')' => {
                    self.skip_char(); // skip '*'
                    self.skip_char(); // skip ')'
                    return self.new_token(loc, TokenKind::Comment, data.string());
                },

                c => {
                    self.skip_char();
                    data.append_char(c).unwrap();
                },
            }
        }
    }

    fn scan_ident(self) -> Token {
        let loc = self.location;
        let data = string_builder::Builder::new();

        loop {
            let c = self.get_char();
            if is_alnum(c) || c == '_' {
                self.skip_char();
                data.append_char(c).unwrap();
            } else {
                return self.new_token(loc, TokenKind::Ident, data.string());
            }
        }
    }

    fn scan_string(self) -> Token {
        self.skip_char(); // """

        let string_loc = self.location;
        let data = string_builder::Builder::new();

        loop {
            let char_loc = self.location;
            match self.get_char() {
                '\\' => {
                    self.skip_char(); // skip '\'
                    match self.get_char() {
                        '\\' => data.append_char('\\').unwrap(),
                        '"' => data.append_char('\"').unwrap(),
                        '/' => data.append_char('/').unwrap(),
                        'b' => data.append_char('\b').unwrap(),
                        'v' => data.append_char('\v').unwrap(),
                        'f' => data.append_char('\f').unwrap(),
                        'n' => data.append_char('\n').unwrap(),
                        'r' => data.append_char('\r').unwrap(),
                        't' => data.append_char('\t').unwrap(),
                        'x' => {
                            self.skip_char();
                            let upper = self.get_char();
                            self.skip_char();
                            let lower = self.get_char();
                            if is_hex(upper) && is_hex(lower) {
                                data.append_char(upper).unwrap();
                                data.append_char(lower).unwrap();
                            } else {
                                return self.new_error(char_loc, 
                                    TokenErrorKind::InvalidHexEscape, 
                                    f"\\x\{upper}\{lower}".unwrap());
                            }
                        },
                        c => return self.new_error(char_loc, 
                                TokenErrorKind::InvalidEscapeChar, 
                                f"'\{c}'".unwrap()),
                    }
                },
                '"' => {
                    self.skip_char(); // skip '"'
                    return self.new_token(string_loc, TokenKind::String, data.string());
                },
                '\0' | '\r' | '\n' => break,
                c => data.append_char(c).unwrap(),
            }
            self.skip_char();
        }

        self.new_error(self.location, TokenErrorKind::UnterminatedString, data.string())
    }
}

struct Token {
    pub location: SourceLoc,
    pub kind: TokenKind,
    pub data: String,
}

impl fmt::Display for Token {
    fn fmt(*self, f: *fmt::Formatter) -> fmt::Result<()> {
        match self.kind {
            TokenKind::Ident => f.write(self.data),
            TokenKind::String => {
                f.write_char('\"')?;
                f.write(self.data)?;
                f.write_char('\"')
            },
            TokenKind::Comment =>  {
                f.write("(* ")?;
                f.write(self.data)?;
                f.write(" *)")
            },
            TokenKind::LeftParen => f.write_char('('),
            TokenKind::RightParen => f.write_char(')'),
            TokenKind::LeftSquare => f.write_char('['),
            TokenKind::RightSquare => f.write_char(']'),
            TokenKind::LeftCurly => f.write_char('{'),
            TokenKind::RightCurly => f.write_char('}'),
            TokenKind::Pipe => f.write_char('|'),
            TokenKind::Equals => f.write_char('='),
            TokenKind::Hyphen => f.write_char('-'),
            TokenKind::DotDot => f.write(".."),
            TokenKind::Dot => f.write_char('.'),
            TokenKind::Eof => Ok(()),

            TokenKind::Error(e) => e.fmt(f), // TODO: separate into Error type and use Result
        }
    }
}

enum TokenKind {
    Ident,
    String,
    Comment,
    LeftParen,
    RightParen,
    LeftSquare,
    RightSquare,
    LeftCurly,
    RightCurly,
    Pipe,
    Equals,
    Hyphen,
    DotDot,
    Dot,

    Eof,
    Error(TokenErrorKind),
}

impl TokenKind {
    pub fn to_string(self) -> String {
        match self {
            TokenKind::Ident => f"<ident>".unwrap(),
            TokenKind::String => f"<string>".unwrap(),
            TokenKind::Comment => f"<comment>".unwrap(),
            TokenKind::LeftParen => f"(".unwrap(),
            TokenKind::RightParen => f")".unwrap(),
            TokenKind::LeftSquare => f"[".unwrap(),
            TokenKind::RightSquare => f"]".unwrap(),
            TokenKind::LeftCurly => f"{".unwrap(),
            TokenKind::RightCurly => f"}".unwrap(),
            TokenKind::Pipe => f"|".unwrap(),
            TokenKind::Equals => f"=".unwrap(),
            TokenKind::Hyphen => f"-".unwrap(),
            TokenKind::DotDot => f"..".unwrap(),
            TokenKind::Dot => f".".unwrap(),
            TokenKind::Eof => String::new(),
            TokenKind::Error(e) => e.to_string(),
        }
    }

    pub fn equals(self, k: TokenKind) -> bool {
        match (self, k) {
            (TokenKind::Ident, TokenKind::Ident)
            | (TokenKind::String, TokenKind::String)
            | (TokenKind::Comment, TokenKind::Comment)
            | (TokenKind::LeftParen, TokenKind::LeftParen)
            | (TokenKind::RightParen, TokenKind::RightParen)
            | (TokenKind::LeftSquare, TokenKind::LeftSquare)
            | (TokenKind::RightSquare,TokenKind::RightSquare)
            | (TokenKind::LeftCurly,  TokenKind::LeftCurly)
            | (TokenKind::RightCurly, TokenKind::RightCurly)
            | (TokenKind::Pipe, TokenKind::Pipe)
            | (TokenKind::Equals, TokenKind::Equals)
            | (TokenKind::Hyphen, TokenKind::Hyphen)
            | (TokenKind::DotDot, TokenKind::DotDot)
            | (TokenKind::Dot, TokenKind::Dot)
            | (TokenKind::Eof, TokenKind::Eof) => true,
            (TokenKind::Error(a), TokenKind::Error(b)) => a.equals(b),
            _ => false,
        }
    }
}

enum TokenErrorKind {
    UnknownToken,
    UnterminatedString,
    UnterminatedComment,
    InvalidEscapeChar,
    InvalidHexEscape,
}

impl TokenErrorKind {
//    pub fn to_str(self) -> str {
//        match self {
//            TokenErrorKind::UnknownToken => "unknown token",
//            TokenErrorKind::UnterminatedString => "unterminated string",
//            TokenErrorKind::UnterminatedComment => "unterminated comment",
//            TokenErrorKind::InvalidEscapeChar => "invalid escape character",
//            TokenErrorKind::InvalidHexEscape => "invalid hex escape",
//        }
//    }

    pub fn equals(self, k: TokenErrorKind) -> bool {
        match (self, k) {
            (TokenErrorKind::UnknownToken, TokenErrorKind::UnknownToken)
            | (TokenErrorKind::UnterminatedString, TokenErrorKind::UnterminatedString)
            | (TokenErrorKind::UnterminatedComment, TokenErrorKind::UnterminatedComment)
            | (TokenErrorKind::InvalidEscapeChar, TokenErrorKind::InvalidEscapeChar)
            | (TokenErrorKind::InvalidHexEscape, TokenErrorKind::InvalidHexEscape) => true,
            _ => false,
        }
    }
}


//
// Parser
//

type ParseResult<T> = Result<T, ParseError>;

struct ParseError {
    pub kind: ParseErrorKind,
    pub location: SourceLoc,
}

impl ParseError {
    pub fn to_string(self) -> String {
        f"\{self.location}: \{self.kind}".unwrap()
    }
}

enum ParseErrorKind {
    UnterminatedComment,
    UnterminatedString(str),

    ExpectedToken(TokenKind, Token),
    UnexpectedToken(Token),
}

impl ParseErrorKind {
    pub fn to_str(self) -> String {
        match self {
            ParseErrorKind::UnterminatedString(s) => f"unterminated string \"\{s}\"".unwrap(),
            ParseErrorKind::UnterminatedComment => f"unterminated comment".unwrap(),
            ParseErrorKind::ExpectedToken(k, t) => f"expected token \"\{k}\" but have \"\{t}\"".unwrap(),
            ParseErrorKind::UnexpectedToken(t) => f"unexpected token \"\{t}\"".unwrap(),
        }
    }
}

struct Grammer {
    pub productions: List<Production>,
}

impl Grammer {
    pub fn new(productions: List<Production>) -> Self {
        Self{productions}
    }

    pub fn to_string(self) -> String {
        let result = string_builder::Builder::new();
        for p in self.productions {
            result.append(p.to_string()).unwrap();
        }
        result.string()
    }
}

struct Production {
    pub ident: str,
    pub expr: Expression,
}

impl Production {
    pub fn to_string(self) -> String {
        f"\{self.ident} = \{self.expr} .".unwrap()
    }
}

struct Expression {
    pub alts: List<Alternative>,
}

impl Expression {
    pub fn to_string(self) -> String {
        let result = string_builder::Builder::new();
        for a in self.alts {
            if result.len() > 0 { result.append(" | ").unwrap(); }
            result.append(a.to_string()).unwrap();
        }
        result.string()
    }
}

struct Alternative {
    pub terms: List<Term>,
}

impl Alternative {
    pub fn to_string(self) -> String {
        let result = string_builder::Builder::new();
        for t in self.terms {
            if result.len() > 0 { result.append_char(' ').unwrap(); }
            result.append(t.to_string()).unwrap();
        }
        result.string()
    }
}

enum Term {
    Ident(String),
    Terminal(String),
    Range(String, String),
    Exception(Term, Term),
    Group(Expression),
    Option(Expression),
    Repetition(Expression),
}

impl Term {
    pub fn to_string(self) -> String {
        match self {
            Term::Ident(data) => data,
            Term::Terminal(data) => f"\"\{data}\"".unwrap(),
            Term::Range(lhs, rhs) => f"\"\{lhs}\"..\"\{rhs}\"".unwrap(),
            Term::Exception(lhs, rhs) =>  f"\{lhs} - \{rhs}".unwrap(),
            Term::Group(expr) => f"(\{expr})".unwrap(),
            Term::Option(expr) =>  f"[\{expr}]".unwrap(),
            Term::Repetition(expr) =>  f"{\{expr}}".unwrap(),
        }
    }
}

struct Parser;

impl Parser {
    pub fn new() -> Self {
        Self
    }

    pub fn parse(self, s: Scanner) -> ParseResult<Grammer> {
        let result = List::new();
        while !self.is_finished(s) {
            result.push(self.production(s)?);
        }
        Ok(Grammer::new(result))
    }

    fn is_finished(self, s: Scanner) -> bool {
        match self.token(s).kind {
            TokenKind::Eof => true,
            _ => false,
        }
    }

    fn token(self, s: Scanner) -> Token {
        loop {
            let t = s.token();
            match t.kind {
                TokenKind::Comment => s.skip(),
                _ => return t,
            }
        }
    }

    fn check(self, s: Scanner, k: TokenKind) -> bool {
        self.token(s).kind.equals(k)
    }

    fn check_next(self, s: Scanner, k: TokenKind) -> bool {
        if self.check(s, k) {
            s.skip();
            true
        } else {
            false
        }
    }

    fn expect(self, s: Scanner, k: TokenKind) -> ParseResult<Token> {
        match self.token(s) {
            t if t.kind.equals(k) => Ok(t),
            t => Self::expected_token(s, k, t),
        }
    }

    fn expect_next(self, s: Scanner, k: TokenKind) -> ParseResult<Token> {
        let token = self.expect(s, k)?;
        s.skip();
        Ok(token)
    }

    fn unexpected_token<T>(s: Scanner, t: Token) -> ParseResult<T> {
        Err(ParseError{
            kind: ParseErrorKind::UnexpectedToken(t),
            location: s.location(),
        })
    }

    fn expected_token<T>(s: Scanner, want: TokenKind, have: Token) -> ParseResult<T> {
        Err(ParseError{
            kind: ParseErrorKind::ExpectedToken(want, have),
            location: s.location(),
        })
    }

    fn production(self, s: Scanner) -> ParseResult<Production> {
        let ident = self.expect_next(s, TokenKind::Ident)?;
        self.expect_next(s, TokenKind::Equals)?;
        let expr = self.expression(s)?;
        self.expect_next(s, TokenKind::Dot)?;

        Ok(Production{ident: ident.data, expr})
    }

    fn expression(self, s: Scanner) -> ParseResult<Expression> {
        let alts = self.alternatives(s)?;
        Ok(Expression{alts})
    }

    fn alternatives(self, s: Scanner) -> ParseResult<List<Alternative>> {
        let result = List::new();
        loop {
            result.push(self.alternative(s)?);
            if self.check(s, TokenKind::Pipe) {
                s.skip(); // skip "|"
            } else {
                return Ok(result);
            }
        }
    }

    fn alternative(self, s: Scanner) -> ParseResult<Alternative> {
        let terms = self.terms(s)?;
        Ok(Alternative{terms})
    }

    fn terms(self, s: Scanner) -> ParseResult<List<Term>> {
        let result = List::new();
        loop {
            let term = self.term(s)?;
            result.push(term);

            let t = self.token(s);
            match t.kind {
                TokenKind::Dot
                | TokenKind::Pipe
                | TokenKind::RightParen
                | TokenKind::RightSquare
                | TokenKind::RightCurly
                | TokenKind::Eof => break,
                _ => (),
            }
        }
        if result.len() == 0 {
            assert(false);
            //return Self::expected_term();
        }
        Ok(result)
    }

    fn term(self, s: Scanner) -> ParseResult<Term> {
        let token = self.token(s);
        let term = match token.kind {
            TokenKind::Ident => self.new_ident(s, token),
            TokenKind::String => self.terminal_or_range(s, token)?,
            TokenKind::LeftParen => self.grouping(s)?,
            TokenKind::LeftSquare => self.option(s)?,
            TokenKind::LeftCurly => self.repetition(s)?,
            _ => return Self::unexpected_token(s, token),
        };
        let term = if self.check(s, TokenKind::Hyphen) {
            self.exception(s, term)?
        } else {
            term
        };
        Ok(term)
    }

    fn new_ident(self, s: Scanner, t: Token) -> Term {
        s.skip(); // skip identifier
        Term::Ident(t.data)
    }

    fn terminal_or_range(self, s: Scanner, t: Token) -> ParseResult<Term> {
        s.skip(); // skip string
        if self.check(s, TokenKind::DotDot) {
            s.skip(); // skip ".."
            let t2 = self.expect_next(s, TokenKind::String)?;
            Ok(Term::Range(t.data, t2.data))
        } else {
            Ok(Term::Terminal(t.data))
        }
    }

    fn exception(self, s: Scanner, lhs: Term) -> ParseResult<Term> {
        s.skip(); // skip "-"
        let rhs = self.term(s)?;
        Ok(Term::Exception(lhs, rhs))
    }

    fn grouping(self, s: Scanner) -> ParseResult<Term> {
        s.skip(); // skip "("
        let expr = self.expression(s)?;
        self.expect_next(s, TokenKind::RightParen)?;
        Ok(Term::Group(expr))
    }

    fn option(self, s: Scanner) -> ParseResult<Term> {
        s.skip(); // skip "["
        let expr = self.expression(s)?;
        self.expect_next(s, TokenKind::RightSquare)?;
        Ok(Term::Option(expr))
    }

    fn repetition(self, s: Scanner) -> ParseResult<Term> {
        s.skip(); // skip "{"
        let expr = self.expression(s)?;
        self.expect_next(s, TokenKind::RightCurly)?;
        Ok(Term::Repetition(expr))
    }
}

fn foreach_ident(expr: Expression, callback: fn(str)) {
    for Alternative{terms} in expr.alts {
        for t in terms {
            match t {
                Term::Group(e) | Term::Option(e) | Term::Repetition(e)
                    => foreach_ident(e, callback),
                Term::Ident(s) => callback(s),
                _ => (),
            }
        }
    }
}

enum Analysis {
    DuplicateIdent(String),
    ReservedIdent(String),
    UnrecognizedIdent(String),
    Ok(HashMap<String, Expression>),
}

fn analyze_definitions(g: Grammer, reserved: HashMap<str, ()>) -> Analysis {
    let idents = HashMap::new();
    let result = HashMap::new();

    for Production{ident, expr} in g.productions {
        if result.contains(ident) {
            return Analysis::DuplicateIdent(ident);
        }
        if reserved.contains(ident.as_str()) {
            return Analysis::ReservedIdent(ident);
        }
        result[ident] = expr;

        foreach_ident(expr, |ident: String| {
            if !reserved.contains(ident.as_str()) {
                idents[ident] = ();
            }
        });
    }
    for ident in idents {
        if !result.contains(ident) {
            return Analysis::UnrecognizedIdent(ident);
        }
    }
    Analysis::Ok(result)
}

enum Verbosity {
    Quiet,
    Verbose,
}

impl Verbosity {
    // TODO: unused
    pub fn should_print_error(self) -> bool {
        match self {
            Verbosity::Quiet => false,
            _ => true,
        }
    }

    pub fn should_print_info(self) -> bool {
        match self {
            Verbosity::Verbose => true,
            _ => false,
        }
    }
}

struct App {
    pub verbosity: Verbosity,
    pub program_name: str,
}

impl App {
    pub fn new(program_name: str) -> Self {
        Self{
            verbosity: Verbosity::Verbose,
            program_name,
        }
    }

    pub fn info(self, message: str) {
        if self.verbosity.should_print_info() {
            io::println(message);
        }
    }

    pub fn error(self, message: str) -> ! {
        let parts = self.program_name.split("/");
        panic(f"\{parts[-1]}: \{message}\n".unwrap());
    }

    pub fn help(self) {
        self.info(f"paw \{self.program_name} PATH\n==========================================\nPATH: Path to file containing EBNF grammer".unwrap());
    }
}


const TEST_OK: int64 = 0;
const TEST_PARSE_ERROR: int64 = -1;
const TEST_ANALYSIS_ERROR: int64 = -2;

fn test_check(source: str) -> int64 {
    let builtins = HashMap::new();
    let scanner = Scanner::new(source);
    let parser = Parser::new();
    match parser.parse(scanner) {
        Ok(grammer) => match analyze_definitions(grammer, builtins) {
            Analysis::Ok(_) => TEST_OK,
            _ => TEST_ANALYSIS_ERROR,
        },
        _ => TEST_PARSE_ERROR,
    }
}

fn test_expect(name: str, source: str, result: int64) -> fmt::Result<()> {
    if test_check(source) != result {
        panic(f"failed testcase \"\{name}\""?);
    }
}

#[test]
pub fn test_ok() {
    let test = |name, source| {
        test_expect(name, source, TEST_OK).unwrap();
    };

    test("empty grammer", "");
    test("one production", "Ident = \"Terminal\" .");
    test("two productions", "A = \"a\" .B = \"b\" .");
    test("one dependency", "A = B . B = \"x\" .");
    test("two dependencies", "A = B . B = C . C = \"x\" .");
}

#[test]
pub fn test_parse_error() {
    let test = |name, source| {
        test_expect(name, source, TEST_PARSE_ERROR);
    };

    test("stray equals sign", "=");
    test("stray identifier", "Lhs");
    test("missing RHS", "Lhs =");
    test("empty RHS", "Lhs = .");
    test("missing terminator", "Lhs = \"x\"");
    test("missing equals sign", "Lhs \"x\"");
    test("missing terminator between", "A = \"a\" B = \"b\" ."); 
    test("string missing left quote", "X = x\" .");
    test("string missing right quote", "X = \"x .");
}

#[test]
pub fn test_analysis_error() {
    let test = |name, source| {
        test_expect(name, source, TEST_ANALYSIS_ERROR);
    };

    test("unrecognized identifier", "Lhs = Rhs .");
    // TODO: circular definitions should be disallowed
}


const SUCCESS: int64 = 0;
const FAILURE: int64 = 1;


fn run_app() -> Result<(), ()> {
    let args = os::args();
    let app = App::new(args.get(0).unwrap_or("ebnf"));
    let builtins = HashMap::new();

    let path = if args.len() < 2 {
        app.error("missing PATH argument");
    } else {
        args[1]
    };

    let source = match read_to_string(path) {
        Err(e) => app.error(f"unable to read EBNF file \"\{path}\" (\{e})".unwrap()),
        Ok(s) => s,
    };

    let scanner = Scanner::new(source);

    // Parse the token stream into a tree describing the given grammer. If "Parser::parse()"
    // completes without encountering an error, then the EBNF is syntactically correct.
    let parser = Parser::new();
    let grammer = match parser.parse(scanner) {
        Err(e) => app.error(f"\{e}".unwrap()),
        Ok(g) => g,
    };

    // Ensure that all identifiers are defined.
    let mapping = match analyze_definitions(grammer, builtins) {
        Analysis::DuplicateIdent(ident) =>
            app.error(f"duplicate identifier \"\{ident}\"".unwrap()),
        Analysis::ReservedIdent(ident) =>
            app.error(f"definition of builtin identifier \"\{ident}\"".unwrap()),
        Analysis::UnrecognizedIdent(ident) =>
            app.error(f"missing identifier \"\{ident}\"".unwrap()),
        Analysis::Ok(r) => r,
    };

    app.info("OK");
    Ok(())
}

pub fn main() {
    let args = os::args();
    let app = App::new(args.get(0).unwrap_or("ebnf"));
    let builtins = HashMap::new();

    let path = if args.len() < 2 {
        app.error("missing PATH argument");
    } else {
        args[1]
    };

    let source = match read_to_string(path) {
        Err(e) => app.error(f"unable to read EBNF file \"\{path}\" (\{e})".unwrap()),
        Ok(s) => s,
    };

    let scanner = Scanner::new(source);

    // Parse the token stream into a tree describing the given grammer. If "Parser::parse()"
    // completes without encountering an error, then the EBNF is syntactically correct.
    let parser = Parser::new();
    let grammer = match parser.parse(scanner) {
        Err(e) => app.error(f"\{e}".unwrap()),
        Ok(g) => g,
    };

    // Ensure that all identifiers are defined.
    let mapping = match analyze_definitions(grammer, builtins) {
        Analysis::DuplicateIdent(ident) =>
            app.error(f"duplicate identifier \"\{ident}\"".unwrap()),
        Analysis::ReservedIdent(ident) =>
            app.error(f"definition of builtin identifier \"\{ident}\"".unwrap()),
        Analysis::UnrecognizedIdent(ident) =>
            app.error(f"missing identifier \"\{ident}\"".unwrap()),
        Analysis::Ok(r) => r,
    };

    app.info("OK");
}


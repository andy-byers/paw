// poly_enum.paw

enum Enum<T> {
    X,
    Y(T),
    Z(T, T),
}

#[test]
pub fn test_initialization() {
    let ex = Enum::<int64>::X;
    let ey = Enum::<int64>::Y(1);
    let ez = Enum::<int64>::Z(2, 3);
}

fn noop(e: Enum<int64>) -> Enum<int64> {
    let e2 = e;
    return e2;
}

#[test]
pub fn test_arguments() {
    noop(Enum::<int64>::X);
    noop(Enum::<int64>::Y(1));
    noop(Enum::<int64>::Z(2, 3));
}

#[test]
pub fn test_assignment() {
    let ex = Enum::<int64>::X;
    let ey = Enum::<int64>::Y(1);
    let ez = Enum::<int64>::Z(2, 3);

    ez = ex;
    ex = ey;
    ey = ez;
}

struct Struct<T> {
    pub x: Enum<int64>,
    pub y: Enum<T>,
}

#[test]
pub fn test_fields() {
    let s = Struct::<bool>{
        x: Enum::<int64>::X,
        y: Enum::<bool>::Y(true),
    };
    let s = Struct::<float64>{
        x: Enum::<int64>::Y(1),
        y: Enum::<float64>::Z(2.0, 3.0),
    };
}

fn option(b: bool) -> Option<int64> {
    if b {
        Option::<int64>::Some(42)
    } else {
        Option::<int64>::None
    }
}

#[test]
pub fn test_chain_option() {
    let val = -1;
    let test = || -> Option<int64> {
        let i = option(true)?;
        val = i;
        return Option::<int64>::Some(i);
    };
    test();
    assert(val == 42);

    let test = || -> Option<int64> {
        let i = option(false)?;
        assert(false);
        return Option::<int64>::Some(i);
    };
    test();

    let test = |o: Option<int64>| {};
    test(Option::<int64>::Some(123));
    test(Option::<int64>::None);
}

fn option2<Ty>(b: bool, v: Ty) -> Option<Ty> {
    if b {
        return Option::<Ty>::Some(v);
    } else {
        return Option::<Ty>::None;
    }
}

fn chain_option2_aux<Ty2>(v: Ty2) -> Option<Ty2> {
    let t = option2(false, v)?;
    assert(false);
    return Option::<Ty2>::Some(t);
}

#[test]
pub fn test_chain_option2() {
    chain_option2_aux(123);
    chain_option2_aux("abc");
}

fn result(b: bool) -> Result<int64, str> {
    if b {
        return Result::<int64, str>::Ok(42);
    } else {
        return Result::<int64, str>::Err("bad");
    }
}

#[test]
pub fn test_chain_result() {
    let val = -1;
    let test = || -> Result<int64, str> {
        let i = result(true)?;
        val = i;
        return Result::<int64, str>::Ok(i);
    };
    test();
    assert(val == 42);

    let test = || -> Result<int64, str> {
        let i = result(false)?;
        assert(false);
        return Result::<int64, str>::Ok(i);
    };
    test();
}

struct Inner<T> {
    pub val: T,
}

struct Outer<T> {
    pub option: Option<Inner<T>>
}

fn construct_option<Ty3>(t: Ty3, a: bool, b: bool) -> Option<Outer<Ty3>> {
    if a {
        if b {
            return Option::<Outer<Ty3>>::Some(Outer::<Ty3>{
                option: Option::<Inner<Ty3>>::Some(Inner::<Ty3>{val: t}),
            });
        } else {
            return Option::<Outer<Ty3>>::Some(Outer::<Ty3>{
                option: Option::<Inner<Ty3>>::None,
            });
        }
    } else {
        return Option::<Outer<Ty3>>::None;
    }
}

#[test]
pub fn test_option_construction() {
    construct_option(42, true, true);
    construct_option(42, true, false);
    construct_option(42, false, false);
}

#[test]
pub fn test_option_methods() {
    let o = Option::<int64>::Some(123);
    assert(o.is_some());
    assert(o.unwrap() == 123);
    assert(o.unwrap_or(456) == 123);

    let o = Option::<int64>::None;
    assert(o.is_none());
    assert(o.unwrap_or(456) == 456);
}

#[test]
pub fn test_result_methods() {
    let o = Result::<int64, str>::Ok(123);
    assert(o.is_ok());
    assert(o.unwrap() == 123);
    assert(o.unwrap_or(456) == 123);

    let o = Result::<int64, str>::Err("abc");
    assert(o.is_err());
    assert(o.unwrap_or(456) == 456);
}

fn map_literals() {
    let map = [:];
    map = [1: 2];
}

fn select_element(x: (int64,)) -> int64 {
    x.0
}

fn loop_continue() {
    while true {
        continue;
    }
}

fn infer_type() {
    let infer_inner: [_] = [1, 2, 3];
}

fn type_alias() {
    type I = int64;
}

fn match_tuple_or(t: (int64,)) {
    match t {
        (1 | 2 | 3,) => {},
        _ => {},
    }
}

fn chain_and_guard(x: Option<int64>) -> Option<int64> {
    match x? {
        123 => {},
        i if i < 0 => {},
        _ => {},
    }
    x
}

fn takes_function_as_argument(f: fn() -> int64) -> int64 {
    f()
}

pub fn main(args: [str]) -> int64 {
    takes_function_as_argument(|| -> int64 {123});
    0
}

// blanket_impl.paw

pub trait Trait {
    fn f(self) -> int64;
}

struct Struct;

impl<T> Trait for T {
    fn f(self) -> int64 { 
        42 
    }
}

#[test]
pub fn test_blanket_impl() {
    assert(Struct.f() == 42);
    // TODO: this should work on integer inference vars, i.e. `123.f()`
    assert(123usize.f() == 42);
    assert("abc".f() == 42);
}

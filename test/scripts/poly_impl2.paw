// poly_impl2.paw

pub trait TestFrom<T> {
    fn test_from(value: T) -> Self;
}

pub trait TestInto<T: Clone> {
    fn test_into(*self) -> T;
}

pub struct CustomType<T> {
    pub value: T,
}

impl<T> TestFrom<T> for CustomType<T> {
    fn test_from(value: T) -> Self {
        Self{value}
    }
}

impl<T: Clone> TestInto<T> for CustomType<T> {
    fn test_into(*self) -> T {
        self.value.clone()
    }
}

fn roundtrip<T: Clone>(value: T) -> T {
    let t = CustomType::test_from(value);
    t.test_into()
}

#[test]
pub fn test() {
    assert(roundtrip(123) == 123);
}

// poly_impl2.paw

pub trait TestFrom<T> {
    fn from(value: T) -> Self;
}

pub trait TestInto<T> {
    fn into(*self) -> T;
}

pub struct CustomType<T> {
    pub value: T,
}

impl<T> TestFrom<T> for CustomType<T> {
    fn from(value: T) -> Self {
        Self{value}
    }
}

impl<T> TestInto<T> for CustomType<T> {
    fn into(*self) -> T {
        self.value
    }
}

fn roundtrip<T>(value: T) -> T {
    let t = CustomType::from(value);
    t.into()
}

#[test]
pub fn test() {
    assert(roundtrip(123) == 123);
}

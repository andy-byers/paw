// poly_impl2.paw

pub trait TestFrom<T> {
    fn from(value: T) -> Self;
}

pub trait TestInto<T> {
    fn into(&self) -> T;
}

pub struct CustomType<T> {
    pub values: [T],
}

impl<T> TestFrom<[T]> for CustomType<T> {
    fn from(values: [T]) -> Self {
        Self{values}
    }
}

impl<T> TestInto<[T]> for CustomType<T> {
    fn into(&self) -> [T] {
        self.values
    }
}

fn roundtrip<T>(values: [T]) -> [T] {
    let t = CustomType::from(values);
    t.into()
}

#[test]
pub fn test() {
    let values = roundtrip([1, 2, 3]);
    assert(values.eq([1, 2, 3]));
}

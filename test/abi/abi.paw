struct ThreeInt8 {
    a: int8,
    b: int8,
    c: int8,
}

struct Int64 {
    a: int64,
}

struct TwoInt64 {
    a: int64,
    b: int64,
}

struct ThreeInt64 {
    a: int64,
    b: int64,
    c: int64,
}

struct Float32 {
    a: int32,
}

struct Int32Float32 {
    a: int32,
    b: float32,
}

struct Float32Int64 {
    a: float32,
    b: int64,
}

struct ThreeFloat64 {
    a: float64,
    b: float64,
    c: float64,
}

struct Int8Float64 {
    a: int8,
    b: float64,
}

#[extern = "c_ThreeInt8"] pub fn c_ThreeInt8(value: ThreeInt8) -> ThreeInt8;
#[extern = "c_Int64"] pub fn c_Int64(value: Int64) -> Int64;
#[extern = "c_TwoInt64"] pub fn c_TwoInt64(value: TwoInt64) -> TwoInt64;
#[extern = "c_ThreeInt64"] pub fn c_ThreeInt64(value: ThreeInt64) -> ThreeInt64;
#[extern = "c_Float32"] pub fn c_Float32(value: Float32) -> Float32;
#[extern = "c_Int32Float32"] pub fn c_Int32Float32(value: Int32Float32) -> Int32Float32;
#[extern = "c_Float32Int64"] pub fn c_Float32Int64(value: Float32Int64) -> Float32Int64;
#[extern = "c_ThreeFloat64"] pub fn c_ThreeFloat64(value: ThreeFloat64) -> ThreeFloat64;
#[extern = "c_Int8Float64"] pub fn c_Int8Float64(value: Int8Float64) -> Int8Float64;

pub fn paw_ThreeInt8(value: ThreeInt8) -> ThreeInt8 { c_ThreeInt8(value) }
pub fn paw_Int64(value: Int64) -> Int64 { c_Int64(value) }
pub fn paw_TwoInt64(value: TwoInt64) -> TwoInt64 { c_TwoInt64(value) }
pub fn paw_ThreeInt64(value: ThreeInt64) -> ThreeInt64 { c_ThreeInt64(value) }
pub fn paw_Float32(value: Float32) -> Float32 { c_Float32(value) }
pub fn paw_Int32Float32(value: Int32Float32) -> Int32Float32 { c_Int32Float32(value) }
pub fn paw_Float32Int64(value: Float32Int64) -> Float32Int64 { c_Float32Int64(value) }
pub fn paw_ThreeFloat64(value: ThreeFloat64) -> ThreeFloat64 { c_ThreeFloat64(value) }
pub fn paw_Int8Float64(value: Int8Float64) -> Int8Float64 { c_Int8Float64(value) }

// int_missing = 0
// sse_missing = 0
#[extern = "c_x86_64_many_args_00"]
pub fn c_x86_64_many_args_00(
    i1: int32, i2: int32,
    i3: int32, i4: int32,
    i5: int32,
    f1: float32, f2: float32,
    f3: float32, f4: float32,
    f5: float32, f6: float32,
    f7: float32,
    value: Float32Int64) -> Float32Int64;
pub fn paw_x86_64_many_args_00(
    i1: int32, i2: int32,
    i3: int32, i4: int32,
    i5: int32,
    f1: float32, f2: float32,
    f3: float32, f4: float32,
    f5: float32, f6: float32,
    f7: float32,
    value: Float32Int64) -> Float32Int64 
{ 
    c_x86_64_many_args_00(
        i1, i2,
        i3, i4,
        i5,
        f1, f2,
        f3, f4,
        f5, f6,
        f7,
        value) 
}


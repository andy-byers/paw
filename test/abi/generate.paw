impl Ty {
    fn fmt_paw(*self, ctx: *Context, f: *fmt::Formatter) -> fmt::Result<()> {
        match self {
            *Self::Unit => (),
            *Self::Int(kind) => match kind {
                IntKind::I8 => "int8".fmt(f)?,
                IntKind::I16 => "int16".fmt(f)?,
                IntKind::I32 => "int32".fmt(f)?,
                IntKind::I64 => "int64".fmt(f)?,
            },
            *Self::Float(kind) => match kind {
                FloatKind::F32 => "float32".fmt(f)?,
                FloatKind::F64 => "float64".fmt(f)?,
            },
            *Self::Struct(id) => {
                "S".fmt(f)?;
                id.value.fmt(f)?;
            },
        }
        Ok(())
    }

    fn fmt_c(*self, ctx: *Context, f: *fmt::Formatter) -> fmt::Result<()> {
        match self {
            *Self::Unit => (),
            *Self::Int(kind) => match kind {
                IntKind::I8 => "int8_t".fmt(f)?,
                IntKind::I16 => "int16_t".fmt(f)?,
                IntKind::I32 => "int32_t".fmt(f)?,
                IntKind::I64 => "int64_t".fmt(f)?,
            },
            *Self::Float(kind) => match kind {
                FloatKind::F32 => "float".fmt(f)?,
                FloatKind::F64 => "double".fmt(f)?,
            },
            *Self::Struct(id) => {
                "struct S".fmt(f)?;
                id.value.fmt(f)?;
            },
        }
        Ok(())
    }
}

struct Context {
    struct_defs: List<List<Ty>>,
    union_defs: List<List<List<Ty>>>,
    abi_paw: fmt::Formatter,
    abi_c: fmt::Formatter,
    abi_h: fmt::Formatter,
    driver_c: fmt::Formatter,
    indent: int64,
}

pub fn write_identity_fn_name(ctx: *Context, prefix: str, ty: *Ty, f: *fmt::Formatter) -> fmt::Result<()> {
    prefix.fmt(f)?;
    "_identity_".fmt(f)?;
    ty.fmt_paw(ctx, f)
}

pub fn write_identity_struct_type_c(ctx: *Context, id: StructId, f: *fmt::Formatter) -> fmt::Result<()> {
    "struct ".fmt(f)?;
    write_identity_struct_type_paw(ctx, id, f)
}

pub fn write_identity_struct_type_paw(ctx: *Context, id: StructId, f: *fmt::Formatter) -> fmt::Result<()> {
    f"S\{id.value}"?.fmt(f)
}

pub fn write_identity_fn_decl_c(ctx: *Context, prefix: str, ty: *Ty, f: *fmt::Formatter) -> fmt::Result<()> {
    ty.fmt_c(ctx, f)?;
    " ".fmt(f)?;
    write_identity_fn_name(ctx, prefix, ty, f)?;
    "(".fmt(f)?;
    ty.fmt_c(ctx, f)?;
    " value)".fmt(f)
}

pub fn write_identity_fn_decl_paw(ctx: *Context, prefix: str, ty: *Ty, f: *fmt::Formatter) -> fmt::Result<()> {
    "pub fn ".fmt(f)?;
    write_identity_fn_name(ctx, prefix, ty, f)?;
    "(value: ".fmt(f)?;
    ty.fmt_paw(ctx, f)?;
    ") -> ".fmt(f)?;
    ty.fmt_paw(ctx, f)?;
    "".fmt(f)
}

impl Context {
    pub fn new() -> Self {
        Self{
            struct_defs: List::new(),
            union_defs: List::new(),
            abi_paw: fmt::Formatter::new(),
            abi_c: fmt::Formatter::new(),
            abi_h: fmt::Formatter::new(),
            driver_c: fmt::Formatter::new(),
            indent: 0,
        }
    }

    pub fn lookup_struct(*self, id: StructId) -> *List<Ty> {
        &self.struct_defs[id.value as usize]
    }

    pub fn define_struct(*self, fields: List<Ty>) -> StructId {
        let value = self.struct_defs.len() as uint32;
        self.struct_defs.push(fields).unwrap();
        StructId{value}
    }

    fn write_identity_fn_defs_paw(*self, ty: *Ty, f: *fmt::Formatter) -> fmt::Result<()> {
        // write `extern` declaration of C function defined in "abi.c"
        "#[extern = \"".fmt(f)?;
        write_identity_fn_name(self, "c", ty, f)?;
        "\"]\n".fmt(f)?;
        write_identity_fn_decl_paw(self, "c", ty, f)?;
        ";\n".fmt(f)?;

        // write definition of Paw function (calls C function)
        write_identity_fn_decl_paw(self, "paw", ty, f)?;
        " {\n    ".fmt(f)?;
        write_identity_fn_name(self, "c", ty, f)?;
        "(value)\n}\n".fmt(f)
    }

    fn write_identity_fn_defs_c(*self, ty: *Ty, f: *fmt::Formatter) -> fmt::Result<()> {
        // write definition of C function
        write_identity_fn_decl_c(self, "c", ty, f)?;
        " {\n    return value;\n}\n".fmt(f)
    }

    fn write_identity_struct_def_c(*self, id: StructId, field_tys: *List<Ty>, f: *fmt::Formatter) -> fmt::Result<()> {
        f"struct S\{id.value} {\n"?.fmt(f)?;
        for (i, ty) in iter::zip(0usize.., field_tys) {
            "    ".fmt(f)?;
            ty.fmt_paw(self, f)?;
            f" v\{i};\n"?.fmt(f)?;
        }
        "}\n".fmt(f)
    }

    fn write_identity_struct_def_paw(*self, id: StructId, field_tys: *List<Ty>, f: *fmt::Formatter) -> fmt::Result<()> {
        f"struct S\{id.value} {\n"?.fmt(f)?;
        for (i, ty) in iter::zip(0usize.., field_tys) {
            f"    v\{i}: "?.fmt(f)?;
            ty.fmt_paw(self, f)?;
            ",\n".fmt(f)?;
        }
        "}\n".fmt(f)
    }

    pub fn write_identity_abi_paw(*self, tys: *List<Ty>, f: *fmt::Formatter) -> fmt::Result<()> {
        self.write_line("// abi.paw", f)?;
        for (i, field_tys) in iter::zip(0u32.., &self.struct_defs) {
            self.write_identity_struct_def_paw(StructId{value: i}, field_tys, f)?;
        }
        for ty in &tys {
            self.write_identity_fn_defs_paw(ty, &self.abi_paw)?;
        }
        Ok(())
    }

    pub fn write_identity_abi_h(*self, tys: *List<Ty>, f: *fmt::Formatter) -> fmt::Result<()> {
        self.write_line("// abi.h", f)?;
        self.write_line("#ifndef PAW_TEST_ABI_H\n", f)?;
        self.write_line("#define PAW_TEST_ABI_H\n", f)?;
        self.write_line("#include <stdint.h>\n", f)?;
        for (i, field_tys) in iter::zip(0u32.., &self.struct_defs) {
            self.write_identity_struct_def_c(StructId{value: i}, field_tys, f)?;
        }
        self.write_line("#endif // PAW_TEST_ABI_H\n", f)
    }

    pub fn write_identity_abi_c(*self, tys: *List<Ty>, f: *fmt::Formatter) -> fmt::Result<()> {
        self.write_line("// abi.c", f)?;
        self.write_line("#include \"abi.h\"\n", f);
        for ty in &tys {
            self.write_identity_fn_defs_c(ty, f)?;
        }
        Ok(())
    }

    fn increase_indentation_level(*self) {
        self.indent += 1;
    }

    fn decrease_indentation_level(*self) {
        assert(self.indent > 0);
        self.indent -= 1;
    }

    fn write_indent(*self, f: *fmt::Formatter) -> fmt::Result<()> {
        for i in 0..self.indent { f.write("    ")?; }
        Ok(())
    }

    fn write_line<I: IntoIterator<Item = *char>>(*self, iter: I, f: *fmt::Formatter) -> fmt::Result<()> {
        self.write_indent(f)?;
        for c in iter { f.write_char(*c)?; }
        f.write_char('\n')
    }

    pub fn write_identity_driver_c(*self, tys: *List<Ty>, f: *fmt::Formatter) -> fmt::Result<()> {
        self.write_line("// driver.c", f)?;
        self.write_line("#include \"abi.h\"", f)?;
        self.write_line("int main(void) {", f)?;
        self.increase_indentation_level();

        for ty in &tys {
            // write each testcase in a different scoping block
            self.write_line("{", f)?;
            self.increase_indentation_level();
            self.write_indent(f)?;
            ty.fmt_c(self, f)?;
            " a;".fmt(f)?;
            let a = Value::generate(ty);

            ty.fmt_c(self, f)?;
            " b = ".fmt(f)?;
            
            self.decrease_indentation_level();
            self.write_line("}", f)?;
        }

        self.decrease_indentation_level();
        self.write_line("}", f)
    }

    pub fn write_identity_test(*self, tys: List<Ty>) -> fmt::Result<()> {
        self.write_identity_abi_h(&tys, &self.abi_h)?;
        self.write_identity_abi_c(&tys, &self.abi_c)?;
        self.write_identity_abi_paw(&tys, &self.abi_paw)?;
        self.write_identity_driver_c(&tys, &self.driver_c);

        let abi_c = ptr::replace(&self.abi_c, fmt::Formatter::new());
        let abi_h = ptr::replace(&self.abi_h, fmt::Formatter::new());
        let abi_paw = ptr::replace(&self.abi_paw, fmt::Formatter::new());
        let driver_c = ptr::replace(&self.driver_c, fmt::Formatter::new());

        io::println(abi_h.string());
        io::println(abi_c.string());
        io::println(abi_paw.string());
        io::println(driver_c.string());

        Ok(())
    }
}

pub fn main() {
    let ctx = Context::new();
    ctx.write_identity_test(make_list([
        Ty::Int(IntKind::I32),
        Ty::Int(IntKind::I8),
    ])).unwrap();
}

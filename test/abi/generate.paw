use fmt;
use hashmap::HashMap;
use io;
use iter;
use list::List;
use ptr;

fn make_list<const N: usize, T>(values: [N]T) -> List<T> {
    List::from_array(values).unwrap()
}

enum IntKind {
    I8,
    I16,
    I32,
    I64,
}

enum FloatKind {
    F32,
    F64,
}

struct StructId {
    value: uint32,
}

impl Copy for IntKind {}
impl Copy for FloatKind {}
impl Copy for StructId {}

enum Ty {
    Unit,
    Int(IntKind),
    Float(FloatKind),
    Struct(StructId),
}

enum Value {
    Unit,
    Int(int64),
    Float(float64),
    Struct(List<Value>),
}

impl Value {
    pub fn generate(*self, ctx: *Context, ty: *Ty) -> Self {
        match ty {
            *Ty::Unit => self.generate_unit(ctx),
            *Ty::Int(kind) => self.generate_int(ctx, kind),
            *Ty::Float(kind) => self.generate_float(ctx, kind),
            *Ty::Struct(id) => self.generate_struct(ctx, id),
        }
    }

    fn generate_unit(*self, ctx: *Context) -> Self {
        Self::Unit
    }

    fn generate_int(*self, ctx: *Context, kind: IntKind) -> Self {
        Self::Int(1)
    }

    fn generate_float(*self, ctx: *Context, kind: FloatKind) -> Self {
        Self::Float(1.0)
    }

    fn generate_struct(*self, ctx: *Context, id: StructId) -> Self {
        let fields = List::new();
        let tys = ctx.lookup_struct(id);
        fields.reserve(tys.len()).unwrap();
        for ty in tys {
            fields.push(self.generate(ty)).unwrap();
        }
        Self::Struct(fields)
    }


use fmt;
use hashmap::HashMap;
use io;
use iter;
use list::List;
use ptr;

fn L<const N: usize, T>(values: [N]T) -> mem::Result<List<T>> {
    List::from_array(values)
}

enum IntKind {
    I8,
    I16,
    I32,
    I64,
}

enum FloatKind {
    F32,
    F64,
}

struct StructId {
    value: uint32,
}

impl Copy for IntKind {}
impl Copy for FloatKind {}
impl Copy for StructId {}

enum Ty {
    Unit,
    Int(IntKind),
    Float(FloatKind),
}

enum Value {
    Unit,
    I8(int8),
    I16(int16),
    I32(int32),
    I64(int64),
    F32(float32),
    F64(float64),
}

impl Value {
    pub fn generate(ctx: *Context, ty: *Ty) -> Self {
        match ty {
            *Ty::Unit => Self::generate_unit(ctx),
            *Ty::Int(kind) => Self::generate_int(ctx, kind),
            *Ty::Float(kind) => Self::generate_float(ctx, kind),
        }
    }

    fn generate_unit(ctx: *Context) -> Self {
        Self::Unit
    }

    fn generate_int(ctx: *Context, kind: IntKind) -> Self {
        match kind {
            IntKind::I8 => Self::I8(1),
            IntKind::I16 => Self::I16(2),
            IntKind::I32 => Self::I32(3),
            IntKind::I64 => Self::I64(4),
        }
    }

    fn generate_float(ctx: *Context, kind: FloatKind) -> Self {
        match kind {
            FloatKind::F32 => Self::F32(1.0),
            FloatKind::F64 => Self::F64(2.0),
        }
    }


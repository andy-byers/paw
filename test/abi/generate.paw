struct StructLayout {
    fields: List<Ty>,
}

impl StructLayout {
    pub fn new<const N: usize>(fields: [N]Ty) -> mem::Result<Self> {
        Ok(Self{fields: L(fields)?})
    }

    pub fn write_name(*self, f: *fmt::Formatter) -> fmt::Result<()> {
        for ty in &self.fields {
            match ty {
                *Ty::Unit => panic("Paw type `()` cannot be represented in standard C"),
                *Ty::Int(IntKind::I8) => f.write("I8")?,
                *Ty::Int(IntKind::I16) => f.write("I16")?,
                *Ty::Int(IntKind::I32) => f.write("I32")?,
                *Ty::Int(IntKind::I64) => f.write("I64")?,
                *Ty::Float(FloatKind::F32) => f.write("F32")?,
                *Ty::Float(FloatKind::F64) => f.write("F64")?,
            }
        }
        Ok(())
    }
}

struct Struct {
    fields: List<Value>,
}

impl Struct {
    pub fn generate(ctx: *Context, layout: *StructLayout) -> Self {
        let fields = List::new();
        for ty in &layout.fields {
            let field = Value::generate(ctx, ty);
            fields.push(field).unwrap();
        }
        Struct{fields}
    }
}

impl Ty {
    fn fmt_paw(*self, ctx: *Context, f: *fmt::Formatter) -> fmt::Result<()> {
        match self {
            *Self::Unit => (),
            *Self::Int(kind) => match kind {
                IntKind::I8 => "int8".fmt(f)?,
                IntKind::I16 => "int16".fmt(f)?,
                IntKind::I32 => "int32".fmt(f)?,
                IntKind::I64 => "int64".fmt(f)?,
            },
            *Self::Float(kind) => match kind {
                FloatKind::F32 => "float32".fmt(f)?,
                FloatKind::F64 => "float64".fmt(f)?,
            },
        }
        Ok(())
    }

    fn fmt_c(*self, ctx: *Context, f: *fmt::Formatter) -> fmt::Result<()> {
        match self {
            *Self::Unit => (),
            *Self::Int(kind) => match kind {
                IntKind::I8 => "int8_t".fmt(f)?,
                IntKind::I16 => "int16_t".fmt(f)?,
                IntKind::I32 => "int32_t".fmt(f)?,
                IntKind::I64 => "int64_t".fmt(f)?,
            },
            *Self::Float(kind) => match kind {
                FloatKind::F32 => "float".fmt(f)?,
                FloatKind::F64 => "double".fmt(f)?,
            },
        }
        Ok(())
    }
}

struct Context {
    struct_defs: List<StructLayout>,
    abi_paw: fmt::Formatter,
    abi_c: fmt::Formatter,
    abi_h: fmt::Formatter,
    driver_c: fmt::Formatter,
    indent: int64,
}

impl Context {
    pub fn new() -> Self {
        Self{
            struct_defs: List::new(),
            abi_paw: fmt::Formatter::new(),
            abi_c: fmt::Formatter::new(),
            abi_h: fmt::Formatter::new(),
            driver_c: fmt::Formatter::new(),
            indent: 0,
        }
    }

    pub fn lookup_struct(*self, id: StructId) -> *StructLayout {
        &self.struct_defs[id.value as usize]
    }

    pub fn define_struct(*self, layout: StructLayout) -> mem::Result<()> {
        self.struct_defs.push(layout)
    }

    pub fn write_fn_name(*self, prefix: str, layout: *StructLayout, f: *fmt::Formatter) -> fmt::Result<()> {
        prefix.fmt(f)?;
        "_abi_".fmt(f)?;
        layout.write_name(f)
    }

    pub fn write_fn_decl_c(*self, prefix: str, layout: *StructLayout, f: *fmt::Formatter) -> fmt::Result<()> {
        "struct ".fmt(f)?;
        layout.write_name(f)?;
        " ".fmt(f)?;
        self.write_fn_name(prefix, layout, f)?;
        "(struct ".fmt(f)?;
        layout.write_name(f)?;
        " value)".fmt(f)
    }

    pub fn write_fn_decl_paw(*self, prefix: str, layout: *StructLayout, f: *fmt::Formatter) -> fmt::Result<()> {
        "pub fn ".fmt(f)?;
        self.write_fn_name(prefix, layout, f)?;
        "(value: ".fmt(f)?;
        layout.write_name(f)?;
        ") -> ".fmt(f)?;
        layout.write_name(f)?;
        "".fmt(f)
    }

    fn write_fn_defs_paw(*self, layout: *StructLayout, f: *fmt::Formatter) -> fmt::Result<()> {
        // write `extern` declaration of C function defined in "abi.c"
        "#[extern = \"".fmt(f)?;
        self.write_fn_name("c", layout, f)?;
        "\"]\n".fmt(f)?;
        self.write_fn_decl_paw("c", layout, f)?;
        ";\n".fmt(f)?;

        // write definition of Paw function (calls C function)
        self.write_fn_decl_paw("paw", layout, f)?;
        " {\n    ".fmt(f)?;
        self.write_fn_name("c", layout, f)?;
        "(value)\n}\n".fmt(f)
    }

    fn write_fn_defs_c(*self, layout: *StructLayout, f: *fmt::Formatter) -> fmt::Result<()> {
        // write definition of C function
        self.write_fn_decl_c("c", layout, f)?;
        " {\n    return value;\n}\n".fmt(f)
    }

    fn write_struct_def_c(*self, layout: *StructLayout, f: *fmt::Formatter) -> fmt::Result<()> {
        "struct ".fmt(f)?;
        layout.write_name(f)?;
        " {\n".fmt(f)?;
        for (i, ty) in iter::zip(0usize.., &layout.fields) {
            "    ".fmt(f)?;
            ty.fmt_paw(self, f)?;
            f" v\{i};\n"?.fmt(f)?;
        }
        "}\n".fmt(f)
    }

    fn write_struct_def_paw(*self, layout: *StructLayout, f: *fmt::Formatter) -> fmt::Result<()> {
        "struct ".fmt(f)?;
        layout.write_name(f)?;
        " {\n".fmt(f)?;
        for (i, ty) in iter::zip(0usize.., &layout.fields) {
            f"    v\{i}: "?.fmt(f)?;
            ty.fmt_paw(self, f)?;
            ",\n".fmt(f)?;
        }
        "}\n".fmt(f)
    }

    pub fn write_abi_paw(*self, f: *fmt::Formatter) -> fmt::Result<()> {
        self.write_line("// abi.paw", f)?;
        for (i, layout) in iter::zip(0u32.., &self.struct_defs) {
            self.write_struct_def_paw(layout, f)?;
            self.write_fn_defs_paw(layout, f)?;
        }
        Ok(())
    }

    pub fn write_abi_h(*self, f: *fmt::Formatter) -> fmt::Result<()> {
        self.write_line("// abi.h", f)?;
        self.write_line("#ifndef PAW_TEST_ABI_H", f)?;
        self.write_line("#define PAW_TEST_ABI_H", f)?;
        self.write_line("#include <stdint.h>", f)?;
        for (i, layout) in iter::zip(0u32.., &self.struct_defs) {
            self.write_struct_def_c(layout, f)?;
        }
        self.write_line("#endif // PAW_TEST_ABI_H", f)
    }

    pub fn write_abi_c(*self, f: *fmt::Formatter) -> fmt::Result<()> {
        self.write_line("// abi.c", f)?;
        self.write_line("#include \"abi.h\"", f);
        for (i, layout) in iter::zip(0u32.., &self.struct_defs) {
            self.write_fn_defs_c(layout, f)?;
        }
        Ok(())
    }

    fn increase_indentation_level(*self) {
        self.indent += 1;
    }

    fn decrease_indentation_level(*self) {
        assert(self.indent > 0);
        self.indent -= 1;
    }

    fn write_indent(*self, f: *fmt::Formatter) -> fmt::Result<()> {
        for i in 0..self.indent { f.write("    ")?; }
        Ok(())
    }

    fn write_line<I: IntoIterator<Item = *char>>(*self, iter: I, f: *fmt::Formatter) -> fmt::Result<()> {
        self.write_indent(f)?;
        for c in iter { f.write_char(*c)?; }
        f.write_char('\n')
    }

    pub fn write_value(*self, value: *Value, f: *fmt::Formatter) -> fmt::Result<()> {
        match value {
            *Value::Unit => panic("Paw type `()` cannot be represented in standard C"),
            *Value::I8(v) => v.fmt(f),
            *Value::I16(v) => v.fmt(f),
            *Value::I32(v) => v.fmt(f),
            *Value::I64(v) => v.fmt(f),
            *Value::F32(v) => v.fmt(f),
            *Value::F64(v) => v.fmt(f),
        }
    }

    pub fn write_struct_initializer_c(*self, name: str, value: *Struct, layout: *StructLayout, f: *fmt::Formatter) -> fmt::Result<()> {
        "struct ".fmt(f)?;
        layout.write_name(f)?;
        f" \{name} const = {\n"?.fmt(f)?;
        self.increase_indentation_level();

        for (index, field) in iter::zip(0usize.., &value.fields) {
            self.write_indent(f)?;
            f".v\{index} = "?.fmt(f)?;
            self.write_value(field, f)?;
            ",\n".fmt(f)?;
        } 

        self.decrease_indentation_level();
        self.write_line("}", f)
    }

    pub fn write_driver_c(*self, f: *fmt::Formatter) -> fmt::Result<()> {
        self.write_line("// driver.c", f)?;
        self.write_line("#include \"abi.h\"", f)?;
        self.write_line("int main(void) {", f)?;
        self.increase_indentation_level();

        for layout in &self.struct_defs {
            // write each testcase in a different scoping block
            self.write_line("{", f)?;
            self.increase_indentation_level();

            // struct T const a = { ... };
            self.write_indent(f)?;
            let a = Struct::generate(self, layout);
            self.write_struct_initializer_c("a", &a, layout, f);

            // struct T b const = paw_abi_T(a);
            self.write_indent(f)?;
            "struct ".fmt(f)?;
            layout.write_name(f)?;
            " b = ".fmt(f)?;
            self.write_fn_name("paw", layout, f)?;
            "(a);\n".fmt(f)?;

// assert(a.v0 == b.v0);
// ...
// assert(a.vN == b.vN);
for (index, (value, ty)) in iter::zip(0usize.., iter::zip(&a.fields, &layout.fields)) {
}
            
            self.decrease_indentation_level();
            self.write_line("}", f)?;
        }

        self.decrease_indentation_level();
        self.write_line("}", f)
    }

    pub fn generate(*self) -> fmt::Result<()> {
        self.write_abi_h(&self.abi_h)?;
        self.write_abi_c(&self.abi_c)?;
        self.write_abi_paw(&self.abi_paw)?;
        self.write_driver_c(&self.driver_c);

        let abi_c = ptr::replace(&self.abi_c, fmt::Formatter::new());
        let abi_h = ptr::replace(&self.abi_h, fmt::Formatter::new());
        let abi_paw = ptr::replace(&self.abi_paw, fmt::Formatter::new());
        let driver_c = ptr::replace(&self.driver_c, fmt::Formatter::new());

        io::println(abi_h.string());
        io::println(abi_c.string());
        io::println(abi_paw.string());
        io::println(driver_c.string());

        Ok(())
    }
}

fn main_() -> fmt::Result<()> {
    let ctx = Context::new();

    ctx.define_struct(StructLayout::new([
        Ty::Int(IntKind::I8),
        Ty::Int(IntKind::I8),
        Ty::Int(IntKind::I8),
    ])?)?;

    ctx.define_struct(StructLayout::new([
        Ty::Int(IntKind::I64),
    ])?)?;

    ctx.define_struct(StructLayout::new([
        Ty::Int(IntKind::I64),
        Ty::Int(IntKind::I64),
    ])?)?;

    ctx.define_struct(StructLayout::new([
        Ty::Int(IntKind::I64),
        Ty::Int(IntKind::I64),
        Ty::Int(IntKind::I64),
    ])?)?;

    ctx.define_struct(StructLayout::new([
        Ty::Float(FloatKind::F32),
    ])?)?;

    ctx.define_struct(StructLayout::new([
        Ty::Int(IntKind::I32),
        Ty::Float(FloatKind::F32),
    ])?)?;

    ctx.define_struct(StructLayout::new([
        Ty::Float(FloatKind::F32),
        Ty::Int(IntKind::I64),
    ])?)?;

    ctx.define_struct(StructLayout::new([
        Ty::Float(FloatKind::F64),
        Ty::Float(FloatKind::F64),
        Ty::Float(FloatKind::F64),
    ])?)?;

    ctx.define_struct(StructLayout::new([
        Ty::Int(IntKind::I8),
        Ty::Float(FloatKind::F64),
    ])?)?;

    ctx.generate()
}

pub fn main() {
    main_().unwrap();
}

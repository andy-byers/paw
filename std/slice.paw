#[extern = "paw_slice_from_raw_parts"]
pub fn from_raw_parts<T>(ptr: *T, len: int) -> []T;

//#[extern = "paw_slice_from_raw_parts"]
//pub fn from_raw_parts_mut<T>(ptr: *mut T, len: int) -> []mut T;


impl<T> []T {
    #[extern = "paw_slice_Slice_len"]
    pub fn len(self) -> int;
} 


pub struct Iter<T> {
    ptr: *T,
    len: int,
}

impl<T> Copy for Iter<T> {}

impl<T> Iter<T> {
    pub fn new(inner: []T) -> Self {
        Self{
            ptr: inner.as_ptr(),
            len: inner.len(),
        }
    }
}

use ptr;

impl<T> Iterator for Iter<T> {
    type Item = *T;

    fn next(*self) -> Option<Self::Item> {
        if self.len > 0 {
            let current = self.ptr;
            self.ptr = ptr::add(current, 1); 
            self.len -= 1;
            Some(current)
        } else {
            None
        }        
    }
}

impl<T> IntoIterator for []T {
    type Item = *T;
    type IntoIter = Iter<T>;

    fn into_iter(self) -> Self::IntoIter {
        Iter::new(self)
    }
}



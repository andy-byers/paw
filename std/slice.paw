impl<T> IndexRange<Range<int>> for []T {
    type Output = T;
    fn index_range(*self, idx: Range<int>) -> []T {
        if idx.start < 0 || idx.start > self.len() 
                || idx.end < 0 || idx.end <= idx.start{
            panic("range index out of bounds");
        }
        from_raw_parts(
            ptr::add(self.as_ptr(), idx.start), 
            idx.end - idx.start)
    }
}

impl<T> IndexRange<RangeInclusive<int>> for []T {
    type Output = T;
    fn index_range(*self, idx: RangeInclusive<int>) -> []T {
        if idx.start < 0 || idx.start > self.len() 
                || idx.end < 0 || idx.end < idx.start{
            panic("range index out of bounds");
        }
        // NOTE: the `+ 1` below cannot overflow unless `idx` spans the entire
        //   address space, which is not possible 
        from_raw_parts(
            ptr::add(self.as_ptr(), idx.start), 
            idx.end - idx.start + 1)
    }
}

impl<T> IndexRange<RangeFrom<int>> for []T {
    type Output = T;
    fn index_range(*self, idx: RangeFrom<int>) -> []T {
        if idx.start < 0 || idx.start > self.len() {
            panic("range index out of bounds");
        }
        from_raw_parts(
            ptr::add(self.as_ptr(), idx.start), 
            self.len() - idx.start)
    }
}

impl<T> IndexRange<RangeTo<int>> for []T {
    type Output = T;
    fn index_range(*self, idx: RangeTo<int>) -> []T {
        if idx.end < 0 || idx.end > self.len() {
            panic("range index out of bounds");
        }
        from_raw_parts(
            self.as_ptr(), 
            idx.end)
    }
}

impl<T> IndexRange<RangeToInclusive<int>> for []T {
    type Output = T;
    fn index_range(*self, idx: RangeToInclusive<int>) -> []T {
        if idx.end < 0 || idx.end >= self.len() {
            panic("range index out of bounds");
        }
        from_raw_parts(
            self.as_ptr(), 
            idx.end + 1)
    }
}

impl<T> IndexRange<RangeFull> for []T {
    type Output = T;
    fn index_range(*self, idx: RangeFull) -> []T {
        *self
    }
}

// TODO: remove Clone bound. requires a way to prevent a stack variable from being dropped (pivot is read out of slice b/c otherwise it is hard to keep track of the pivot element once elements have been swapped in partition())
impl<T: Clone + Ord<T>> []T {
    pub fn sort_unstable(self) {
        self.quicksort(0, self.len() - 1);
    }

    fn quicksort(self, lo: int, hi: int) {
        if lo >= 0 && lo < hi {
            let (lt, gt) = self.partition(lo, hi);
            self.quicksort(lo, lt - 1);
            self.quicksort(gt + 1, hi);
        }
    }

    fn partition(self, lo: int, hi: int) -> (int, int) {
        let pivot = self[lo + (hi - lo) / 2].clone();
        let (lt, eq, gt) = (lo, lo, hi);

        while eq <= gt {
            match self[eq].cmp(&pivot) {
                Ordering::Less => {
                    ptr::swap(&self[eq], &self[lt]);
                    lt += 1;
                    eq += 1;
                },
                Ordering::Greater => {
                    ptr::swap(&self[eq], &self[gt]);
                    gt -= 1;
                },
                Ordering::Equal => {
                    eq += 1;
                },
            }
        }
        (lt, gt)
    }
} 


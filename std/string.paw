// A mutable string
pub struct String {
    inner: List<char>
}

pub use list::InsertError;

use list::List;
use slice;

impl String {
    pub fn new() -> Self {
        Self{inner: List::new()}
    }

    pub fn from_chars<T: ToSlice<char>>(chars: T) -> mem::Result<Self> {
        let s = Self::new();
        s.extend(chars.to_slice())?;
        Ok(s)
    }

    pub fn from_slice(text: []char) -> mem::Result<Self> {
        let s = Self::new();
        s.extend(text)?;
        Ok(s)
    }

    pub fn len(*self) -> usize {
        self.inner.len()
    }

    pub fn is_empty(*self) -> bool {
        self.len() == 0
    }

    pub fn capacity(*self) -> usize {
        self.inner.capacity()
    }

    pub fn as_str(*self) -> str {
        str::from_raw_parts(self.as_ptr(), self.len())
    }

    pub fn from_raw_parts(start: *char, length: usize, capacity: usize) -> Self {
        Self{inner: List::from_raw_parts(start, length, capacity)}
    }

    pub fn into_raw_parts(self) -> (*char, usize, usize) {
        let Self{inner} = self; // decompose
        inner.into_raw_parts()
    }

    pub fn get(*self, index: usize) -> Option<*char> {
        self.inner.get(index)
    }

    pub fn set(*self, index: usize, value: char) -> Option<char> {
        self.inner.set(index, value)
    }

    pub fn push(*self, value: char) -> mem::Result<()> {
        self.inner.push(value)
    }

    pub fn insert(*self, index: usize, value: char) -> Result<(), InsertError> {
        self.inner.insert(index, value)
    }

    pub fn remove(*self, index: usize) -> char {
        self.inner.remove(index)
    }

    pub fn pop(*self) -> char {
        self.inner.pop()
    }

    pub fn reserve(*self, len: usize) -> mem::Result<()> {
        self.inner.reserve(len)
    }

    pub fn extend(*self, data: []char) -> mem::Result<()> {
        self.inner.extend_from_slice(data)
    }
}

impl AsPtr<char> for String {
    fn as_ptr(*self) -> *char {
        if self.is_empty() {
            "".as_ptr()
        } else {
            self.inner.as_ptr()
        }
    }
}

impl ToSlice<char> for String {
    fn to_slice(*self) -> []char {
        slice::from_raw_parts(self.as_ptr(), self.len())
    }
}

impl Index<usize> for String {
    type Output = char;
    fn index(*self, index: usize) -> *char {
        &self.to_slice()[index]
    }
}

impl Hash for String {
    fn hash(*self) -> uint64 {
        self.to_slice().hash()
    }
}

impl Eq<Self> for String {
    fn eq(*self, rhs: *Self) -> bool {
        self.to_slice().eq(&rhs.to_slice())
    }
}

impl Ord<Self> for String {
    fn cmp(*self, rhs: *Self) -> Ordering {
        self.to_slice().cmp(&rhs.to_slice())
    }
}

pub use list::Iter;
//pub use list::IterMut;
pub use list::IntoIter;

impl IntoIterator for String {
    type Item = char;
    type IntoIter = IntoIter<char>;

    fn into_iter(self) -> Self::IntoIter {
        let Self{inner} = self;
        inner.into_iter()
    }
}

impl IntoIterator for *String {
    type Item = *char;
    type IntoIter = Iter<char>;

    fn into_iter(self) -> Self::IntoIter {
        self.to_slice().into_iter()
    }
}

//impl IntoIterator_ for *mut String {
//    type Item = *mut char;
//    type IntoIter = slice::IteratorMut<char>;
//
//    fn into_iter(self) -> Self::IntoIter {
//        self.to_slice_mut().into_iter()
//    }
//}


use io;

impl io::Write for String {
    fn write(*self, data: []char) -> io::Result<usize> {
        self.extend(data)?;
        Ok(data.len())
    }
}

use fmt;

impl fmt::Display for String {
    fn fmt(*self, f: *fmt::Formatter) -> fmt::Result<()> {
        f.write_slice(self.to_slice())
    }
} 

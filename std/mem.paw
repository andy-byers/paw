pub type Result<T> = prelude::Result<T, OutOfMemory>;

pub struct OutOfMemory;

impl Copy for OutOfMemory {}


#[extern]
pub fn sizeof<T>() -> usize;

#[extern]
pub fn alignof<T>() -> usize;


pub fn strideof<T>() -> usize {
    let size = sizeof::<T>();
    let alignment = alignof::<T>();
    (size + (alignment - 1)) & ~(alignment - 1)
}

fn compute_array_size<T>(count: usize) -> Result<usize> {
    let stride = strideof::<T>();
    if count <= USIZE_MAX / stride {
        Ok(count * stride)
    } else {
        Err(OutOfMemory)
    }
}

pub fn alloc<T>(count: usize) -> Result<*T> {
    let size = compute_array_size::<T>(count)?;
    Ok(raw_alloc(size)? as *T)
}

pub fn realloc<T>(ptr: *T, count: usize) -> Result<*T> {
    let size = compute_array_size::<T>(count)?;
    Ok(raw_realloc(ptr as *char, size)? as *T)
}

pub fn dealloc<T>(ptr: *T) {
    raw_dealloc(ptr as *char)
}


pub fn drop<T>(value: T) {}

pub fn drop_in_place<T>(ptr: *T) {}

#[extern = "paw_mem_forget"]
pub fn forget<T>(value: T);

#[extern = "malloc"] 
fn malloc_(size: usize) -> *char;

#[extern = "realloc"] 
fn realloc_(ptr: *char, size: usize) -> *char;

#[extern = "free"] 
fn free_(ptr: *char);

#[extern = "aligned_alloc"] 
fn aligned_alloc_(alignment: usize, size: usize) -> *char;

fn ptr_as_result<T>(ptr: *T) -> Result<*T> {
    if ptr as usize != 0 {
        Ok(ptr)
    } else {
        Err(OutOfMemory)
    }
}

fn raw_alloc(size: usize) -> Result<*char> {
    ptr_as_result(malloc_(size))
}

fn raw_realloc(ptr: *char, size: usize) -> Result<*char> {
    ptr_as_result(realloc_(ptr, size))
}

fn raw_dealloc(ptr: *char) {
    free_(ptr);
}

fn raw_aligned_alloc(alignment: usize, size: usize) -> Result<*char> {
    ptr_as_result(aligned_alloc_(alignment, size))
}


struct MaybeUninit<T> {
    inner: T,
}

impl<T> MaybeUninit<T> {
    #[extern = "paw_mem_MaybeUninit_new"]
    pub fn new() -> Self;

    pub fn assume_init(self) -> T {
        let Self{inner} = self;
        inner
    }
}

impl<T> AsPtr<T> for MaybeUninit<T> {
    fn as_ptr(*self) -> *T {
        &self.inner
    }
}



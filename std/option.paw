pub enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    pub fn is_some(*self) -> bool {
        !self.is_none()
    }

    pub fn is_none(*self) -> bool {
        match self {
            *None => true,
            *Some(_) => false,
        }
    }

    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Some(value) => value,
            None => default,
        }
    }

    pub fn unwrap(self) -> T {
        self.expect("failed to unwrap")
    }

    pub fn unwrap_none(self) -> () {
        self.expect_none("failed to unwrap none")
    }

    pub fn expect(self, message: str) -> T {
        match self {
            Some(value) => value,
            None => panic(message),
        }
    }

    pub fn expect_none(self, message: str) -> () {
        match self {
            Some(_) => panic(message),
            None => (),
        }
    }
}

pub use Option::*;

impl<T: Copy> Copy for Option<T> {}

pub type schar = int8;
pub type uchar = uint8;

pub type short = int16;
pub type ushort = uint16;

pub type int = int32;
pub type uint = uint32;

pub type long = int64;
pub type ulong = uint64;

pub type longlong = int64;
pub type ulonglong = uint64;

pub type size_t = usize;
pub type ssize_t = isize;

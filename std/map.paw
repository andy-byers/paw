pub struct Map<K: Hash + Equals, V>;

impl<K: Hash + Equals, V> [K: V] {
    pub fn length(self) -> int {
        #self
    }

    #[extern] pub fn get(self, key: K) -> Option<V>;

    pub fn set(self, key: K, value: V) -> Option<V> {
        let old_value = self.get(key);
        self[key] = value;
        old_value
    }

    #[extern] pub fn remove(self, key: K);

    pub fn get_or(self, key: K, default: V) -> V {
        match self.get(key) {
            Some(value) => value,
            None => default,
        }
    }

    pub fn contains(self, key: K) -> bool {
        match self.get(key) {
            Some(_) => true,
            None => false,
        }
    }

    // Wrappers around methods on type "K" to make them easier to call 
    // from generated code.
    pub fn key_eq(lhs: K, rhs: K) -> bool { lhs.eq(rhs) }
    pub fn key_hash(key: K) -> int { key.hash() }
}

impl<K: Hash + Equals, V> Default for [K: V] {
    fn default() -> Self {
        [:]
    }
}

impl<K: Hash + Equals, V> Iterate<MapIterator<K, V>, K> for [K: V] {
    fn iterator(self) -> MapIterator<K, V> {
        MapIterator::new(self)
    }
}


pub inline struct MapIterator<K: Hash + Equals, V> {
    map: [K: V],
    index: int,
}

impl<K: Hash + Equals, V> MapIterator<K, V> {
    pub fn new(map: [K: V]) -> Self {
        Self{map, index: -1}
    }
}

impl<K: Hash + Equals, V> Advance<K> for MapIterator<K, V> {
    #[extern] fn next(&self) -> Option<K>;
}


pub struct Map<K: Hash + Equals, V>: Iterate<MapIterator<K, V>, K> {
    pub fn length(self) -> int {
        #self
    }

    #[extern] pub fn get(self, key: K) -> Option<V>;

    pub fn set(self, key: K, value: V) {
        self[key] = value;
    }

    #[extern] pub fn remove(self, key: K);

    pub fn get_or(self, key: K, default: V) -> V {
        match self.get(key) {
            Some(value) => value,
            None => default,
        }
    }

    pub fn contains(self, key: K) -> bool {
        match self.get(key) {
            Some(_) => true,
            None => false,
        }
    }

    pub fn iterator(self) -> MapIterator<K, V> {
        MapIterator::new(self)
    }

    // Wrappers around methods on type "K" to make them easier to call 
    // from generated code.
    pub fn key_eq(lhs: K, rhs: K) -> bool { lhs.eq(rhs) }
    pub fn key_hash(key: K) -> int { key.hash() }
}

pub inline struct MapIterator<K: Hash + Equals, V>: Advance<K> {
    map: [K: V],
    index: int,

    pub fn new(map: [K: V]) -> Self {
        Self{map, index: -1}
    }

    #[extern] pub fn next(&self) -> Option<K>;
}


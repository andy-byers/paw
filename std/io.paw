impl Copy for Error {}


#[extern = "paw_io_stdin"] 
pub fn stdin() -> *File;

#[extern = "paw_io_stdout"] 
pub fn stdout() -> *File;

#[extern = "paw_io_stderr"] 
pub fn stderr() -> *File;


pub fn print<T: ToSlice<char>>(message: T) {
    stdout().write(message.to_slice()).unwrap();
}

use string_builder;

pub fn println<T: ToSlice<char>>(message: T) {
    let b = string_builder::Builder::new();
    b.append_slice(message.to_slice()).unwrap();
    b.append_char('\n').unwrap();
    print(b.string());
}


use ptr;
use slice;

fn skip_unchecked<T>(data: *[]T, amount: usize) {
    *data = slice::from_raw_parts(
        ptr::add(data.as_ptr(), amount as isize),
        data.len() - amount);
}

pub fn write_all<W: Write>(writer: *W, data: []char) -> Result<()> {
    while data.len() > 0 {
        let n = writer.write(data)?;
        skip_unchecked(&data, n);
    }
    Ok(())
}

pub fn read_exact<R: Read>(reader: *R, data: []char) -> Result<()> {
    while data.len() > 0 {
        let n = reader.read(data)?;
        skip_unchecked(&data, n);
    }
    Ok(())
}

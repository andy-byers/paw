use result;

pub trait Read {
    fn read(*self, data: []char) -> Result<usize>;
}

pub trait Write {
    fn write(*self, data: []char) -> Result<usize>;
}


pub type Result<T> = result::Result<T, Error>;

impl From<mem::OutOfMemory> for Error {
    fn from(value: mem::OutOfMemory) -> Self {
        Error::Other
    }
}

pub struct File {
    inner: *(),
}

impl File {
    #[extern = "paw_io_File_open"] 
    pub fn open(pathname: []char, mode: []char) -> Result<Self>;

    #[extern = "paw_io_File_seek"] 
    pub fn seek(*self, offset: int64, whence: Seek) -> Result<()>;

    #[extern = "paw_io_File_tell"] 
    pub fn tell(*self) -> Result<int64>;

    #[extern = "paw_io_File_flush"] 
    pub fn flush(*self) -> Result<()>;
}

impl Read for File {
    #[extern = "paw_io_File_read"] 
    fn read(*self, data: []char) -> Result<usize>;
}

impl Write for File {
    #[extern = "paw_io_File_write"] 
    fn write(*self, data: []char) -> Result<usize>;
}

impl Drop for File {
    #[extern = "paw_io_File_drop"]
    fn drop(*self);
}


pub enum Seek {
    Begin,
    Current,
    End,
}


pub enum Error {
    NotFound,
    TooLarge,
    PermissionDenied,
    AlreadyExists,
    NotOpened,
    NotSupported,
    InvalidArgument,
    Other,
}


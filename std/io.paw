impl Copy for Error {}


#[extern = "paw_io_stdin"] 
pub fn stdin() -> *File;

#[extern = "paw_io_stdout"] 
pub fn stdout() -> *File;

#[extern = "paw_io_stderr"] 
pub fn stderr() -> *File;


pub fn print<T: ToSlice<char>>(message: T) {
    stdout().write(message.to_slice()).unwrap();
}

use string_builder;

pub fn println<T: ToSlice<char>>(message: T) {
    let b = string_builder::Builder::new();
    b.append_slice(message.to_slice()).unwrap();
    b.append_char('\n').unwrap();
    print(b.string());
}

use result;

pub trait Read {
    fn read(&self, data: [char]) -> Result<int>;
}

pub trait Write {
    fn write(&self, data: [char]) -> Result<int>;
}


pub type Result<T> = result::Result<T, Error>;


pub struct File {
    inner: (),
}

impl File {
    #[extern_std] pub fn open(pathname: str, mode: str) -> Result<Self>;
    #[extern_std] pub fn seek(self, offset: int, whence: Seek) -> Result<()>;
    #[extern_std] pub fn tell(self) -> Result<int>;
    #[extern_std] pub fn flush(self) -> Result<()>;
}

impl Read for File {
    #[extern_std] fn read(&self, data: [char]) -> Result<int>;
}

impl Write for File {
    #[extern_std] fn write(&self, data: [char]) -> Result<int>;
}


pub inline enum Seek {
    Begin,
    Current,
    End,
}


pub inline enum Error {
    NotFound,
    TooLarge,
    PermissionDenied,
    AlreadyExists,
    NotOpened,
    NotSupported,
    InvalidArgument,
    Other,
}

impl Error {
    pub fn to_str(self) -> str {
        match self {
            Error::NotFound => "not found",
            Error::TooLarge => "too large",
            Error::PermissionDenied => "permission denied",
            Error::AlreadyExists => "already exists",
            Error::NotOpened => "not opened",
            Error::NotSupported => "not supported",
            Error::InvalidArgument => "invalid argument",
            Error::Other => "other error",
        }
    }
}


#[extern_std] pub fn stdin() -> File;
#[extern_std] pub fn stdout() -> File;
#[extern_std] pub fn stderr() -> File;

// string_builder.paw

pub use string::String;

use list::List;
use slice;
use ptr;

pub struct Builder {
    buffer: List<char>,
}

impl Builder {
    pub fn new() -> Self {
        Self{buffer: List::new()}
    }

    pub fn append<I: IntoIterator<Item = *char>>(*self, iter: I) -> mem::Result<()> {
        self.buffer.extend(iter)?;
        Ok(())
    }

    pub fn append_slice(*self, value: []char) -> mem::Result<()> {
        self.buffer.extend_from_slice(value)?;
        Ok(())
    }

    pub fn append_char(*self, value: char) -> mem::Result<()> {
        self.buffer.push(value)?;
        Ok(())
    }

    pub fn string(self) -> String {
        let buffer = ptr::replace(&self.buffer, List::new());
        let (start, length, capacity) = buffer.into_raw_parts();
        String::from_raw_parts(start, length, capacity)
    }
}


pub use mem;

use io;
use ptr;
use slice;

pub trait Drop {
    fn drop(*self);
}


pub trait Copy {}


pub trait Clone {
    fn clone(*self) -> Self;
}


pub trait Hash {
    fn hash(*self) -> int;
}


pub trait Add<Rhs> {
    type Output;

    fn add(*self, rhs: *Rhs) -> Self::Output;
}

pub trait Sub<Rhs> {
    type Output;

    fn sub(*self, rhs: *Rhs) -> Self::Output;
}

pub trait Mul<Rhs> {
    type Output;

    fn mul(*self, rhs: *Rhs) -> Self::Output;
}

pub trait Div<Rhs> {
    type Output;

    fn div(*self, rhs: *Rhs) -> Self::Output;
}

pub trait Rem<Rhs> {
    type Output;

    fn rem(*self, rhs: *Rhs) -> Self::Output;
}

pub trait BitAnd<Rhs> {
    type Output;

    fn bit_and(*self, rhs: *Rhs) -> Self::Output;
}

pub trait BitOr<Rhs> {
    type Output;

    fn bit_or(*self, rhs: *Rhs) -> Self::Output;
}

pub trait BitXor<Rhs> {
    type Output;

    fn bit_xor(*self, rhs: *Rhs) -> Self::Output;
}

pub trait Shl<Rhs> {
    type Output;

    fn shl(*self, rhs: *Rhs) -> Self::Output;
}

pub trait Shr<Rhs> {
    type Output;

    fn shr(*self, rhs: *Rhs) -> Self::Output;
}


pub trait Eq<Rhs> {
    fn eq(*self, rhs: *Rhs) -> bool;
}


pub enum Ordering {
    Less,
    Equal,
    Greater,
}

pub trait Ord<Rhs>: Eq<Rhs> {
    fn cmp(*self, rhs: *Rhs) -> Ordering;
}


pub trait Increment {
    fn increment(*self);
}


pub trait Default {
    fn default() -> Self;
}


pub trait From<T> {
    fn from(from: T) -> Self;
}


pub trait Into<T> {
    fn into(self) -> T;
}


pub trait AsPtr<T> {
    fn as_ptr(*self) -> *T;
}


pub trait ToSlice<T> {
    fn to_slice(*self) -> []T;
}


//pub trait ToSliceMut<T> {
//    fn to_slice_mut(*mut self) -> []mut T;
//}


pub trait Index<Idx> {
    type Output;
    fn index(*self, index: Idx) -> *Self::Output;
}


pub trait IntoIterator {
    type Item;
    type IntoIter: Iterator<Item = Self::Item>;

    fn into_iter(self) -> Self::IntoIter;
}

pub trait Iterator {
    type Item;

    fn next(*self) -> Option<Self::Item>;
}


pub trait Fn<Args> {
    type Output;

    fn call(*self, args: Args) -> Self::Output;
}

impl Hash for unit {
    fn hash(*self) -> int { 
        0 
    }
}

impl Eq<Self> for unit {
    fn eq(*self, rhs: *Self) -> bool { 
        true 
    }
}

impl Default for unit {
    fn default() -> Self {
        ()
    }
}


impl Hash for bool {
    fn hash(*self) -> int { 
        *self as int 
    }
}

impl Eq<Self> for bool {
    fn eq(*self, rhs: *Self) -> bool { 
        *self == *rhs 
    }
}

impl Default for bool {
    fn default() -> Self {
        false
    }
}


impl Hash for char { 
    fn hash(*self) -> int { 
        *self as int 
    }
}

impl Eq<Self> for char { 
    fn eq(*self, rhs: *Self) -> bool { 
        *self == *rhs 
    }
}

impl Ord<Self> for char {
    fn cmp(*self, rhs: *Self) -> Ordering { 
        if *self < *rhs {
            Ordering::Less
        } else if *self > *rhs {
            Ordering::Greater
        } else {
            Ordering::Equal
        }
    }
}

impl Increment for char {
    fn increment(*self) { 
        *self = (*self as int + 1) as char; 
    }
}

impl Default for char {
    fn default() -> Self {
        '\0'
    }
}


impl Add<Self> for int {
    type Output = Self;

    fn add(*self, rhs: *Self) -> Self {
        *self + *rhs
    }
}

impl Sub<Self> for int {
    type Output = Self;

    fn sub(*self, rhs: *Self) -> Self {
        *self - *rhs
    }
}

impl Mul<Self> for int {
    type Output = Self;

    fn mul(*self, rhs: *Self) -> Self {
        *self * *rhs
    }
}

impl Div<Self> for int {
    type Output = Self;

    fn div(*self, rhs: *Self) -> Self {
        *self / *rhs
    }
}

impl Rem<Self> for int {
    type Output = Self;

    fn rem(*self, rhs: *Self) -> Self {
        *self % *rhs
    }
}

impl BitAnd<Self> for int {
    type Output = Self;

    fn bit_and(*self, rhs: *Self) -> Self {
        *self & *rhs
    }
}

impl BitOr<Self> for int {
    type Output = Self;

    fn bit_or(*self, rhs: *Self) -> Self {
        *self | *rhs
    }
}

impl BitXor<Self> for int {
    type Output = Self;

    fn bit_xor(*self, rhs: *Self) -> Self {
        *self ^ *rhs
    }
}

impl Shl<Self> for int {
    type Output = Self;

    fn shl(*self, rhs: *Self) -> Self {
        *self << *rhs
    }
}

impl Shr<Self> for int {
    type Output = Self;

    fn shr(*self, rhs: *Self) -> Self {
        *self >> *rhs
    }
}

// TODO: constants overflow int64
impl Hash for int { 
    fn hash(*self) -> int { 
        // SplitMix64 step from https://en.wikipedia.org/wiki/Xorshift 
        let x = *self + -7046029254386353131; // 0x9E3779B97F4A7C15
        x = (x ^ (x >> 30)) * -4658895280553007687; // 0xBF58476D1CE4E5B9
        x = (x ^ (x >> 27)) * -7723592293110705685; // 0x94D049BB133111EB
        x ^ (x >> 31)
    }
}

impl Eq<Self> for int { 
    fn eq(*self, rhs: *Self) -> bool { 
        *self == *rhs 
    }
}

impl Ord<Self> for int {
    fn cmp(*self, rhs: *Self) -> Ordering { 
        if *self < *rhs {
            Ordering::Less
        } else if *self > *rhs {
            Ordering::Greater
        } else {
            Ordering::Equal
        }
    }
}

impl Increment for int {
    fn increment(*self) { 
        *self += 1; 
    }
}

impl Default for int {
    fn default() -> Self {
        0
    }
}


impl Add<Self> for float {
    type Output = Self;

    fn add(*self, rhs: *Self) -> Self {
        *self + *rhs
    }
}

impl Sub<Self> for float {
    type Output = Self;

    fn sub(*self, rhs: *Self) -> Self {
        *self - *rhs
    }
}

impl Mul<Self> for float {
    type Output = Self;

    fn mul(*self, rhs: *Self) -> Self {
        *self * *rhs
    }
}

impl Div<Self> for float {
    type Output = Self;

    fn div(*self, rhs: *Self) -> Self {
        *self / *rhs
    }
}

// TODO: consider using something like "PartialEq" here b/c of NaNs
impl Eq<Self> for float { 
    fn eq(*self, rhs: *Self) -> bool { 
        *self == *rhs 
    }
}

impl Ord<Self> for float {
    fn cmp(*self, rhs: *Self) -> Ordering { 
        if *self < *rhs {
            Ordering::Less
        } else if *self > *rhs {
            Ordering::Greater
        } else {
            Ordering::Equal
        }
    }
}

impl Default for float {
    fn default() -> Self {
        0.0
    }
}


impl Copy for str {}

impl Clone for str {
    fn clone(*self) -> Self {
        *self
    }
}

impl AsPtr<char> for str {
    #[extern = "paw_ops_str_AsPtr_as_ptr"]
    fn as_ptr(*self) -> *char;
}

impl ToSlice<char> for str {
    fn to_slice(*self) -> []char {
        slice::from_raw_parts(self.as_ptr(), self.len())
    }
}

impl Ord<Self> for str {
    fn cmp(*self, rhs: *Self) -> Ordering { 
        if *self < *rhs {
            Ordering::Less
        } else if *self > *rhs {
            Ordering::Greater
        } else {
            Ordering::Equal
        }
    }
}

impl Index<int> for str {
    type Output = char;
    fn index(*self, index: int) -> *char {
        check_bounds(index, self.len(), false);
        ptr::add(self.as_ptr(), index)
    }
}

impl Hash for str { 
    fn hash(*self) -> int {
        self.to_slice().hash()
    }
}

impl Eq<Self> for str { 
    fn eq(*self, rhs: *Self) -> bool { 
        *self == *rhs
    }
}

impl Default for str {
    fn default() -> Self {
        ""
    }
}

impl IntoIterator for str {
    type Item = *char;
    type IntoIter = slice::Iter<char>;
    fn into_iter(self) -> Self::IntoIter {
        self.to_slice().into_iter()
    }
}


impl<T> Copy for []T {}

impl<T> AsPtr<T> for []T {
    #[extern = "paw_ops_Slice_AsPtr_as_ptr"]
    fn as_ptr(*self) -> *T;
}

impl<T> Index<int> for []T {
    type Output = T;
    fn index(*self, index: int) -> *T {
        check_bounds(index, self.len(), false);
        ptr::add(self.as_ptr(), index)
    }
}

impl<T> ToSlice<T> for []T {
    fn to_slice(*self) -> []T {
        *self
    }
}

impl Hash for []char {
    fn hash(*self) -> int {
        builtin_hash_bytes(self.as_ptr(), self.len(), 0)
    }
}

impl Ord<Self> for []char {
    fn cmp(*self, rhs: *Self) -> Ordering {
        let r = builtin_rawcmp(self.as_ptr(), self.len(), 
            rhs.as_ptr(), rhs.len());
        match builtin_rawcmp(self.as_ptr(), self.len(), 
                rhs.as_ptr(), rhs.len()) {
            r if r < 0 => Ordering::Less,
            r if r > 0 => Ordering::Greater,
            _ => Ordering::Equal,
        }
    }
}

impl<T: Eq<T>> Eq<Self> for []T {
    fn eq(*self, rhs: *Self) -> bool {
        if self.len() != rhs.len() {
            return false;
        }
        for i in 0..self.len() {
            if !self[i].eq(&rhs[i]) {
                return false;
            }
        }
        true
    }
}



    fn clone(*self) -> Self { 
        *self 
    }
}


pub struct Range<T> {
    pub start: T,
    pub end: T,
}

impl<T: Clone + Ord<T> + Increment> IntoIterator for Range<T> {
    type Item = T;
    type IntoIter = RangeIter<T>;

    fn into_iter(self) -> Self::IntoIter {
        let Self{start, end} = self;
        RangeIter{start, end}
    }
}


pub struct RangeInclusive<T> {
    pub start: T,
    pub end: T,
}

impl<T: Clone + Ord<T> + Increment> IntoIterator for RangeInclusive<T> {
    type Item = T;
    type IntoIter = RangeInclusiveIter<T>;

    fn into_iter(self) -> Self::IntoIter {
        let Self{start, end} = self;
        RangeInclusiveIter{start, end, done: false}
    }
}


pub struct RangeFrom<T> {
    pub start: T,
}

impl<T: Clone + Ord<T> + Increment> IntoIterator for RangeFrom<T> {
    type Item = T;
    type IntoIter = RangeFromIter<T>;

    fn into_iter(self) -> Self::IntoIter {
        let Self{start} = self;
        RangeFromIter{start}
    }
}


pub struct RangeTo<T> {
    pub end: T,
}


pub struct RangeToInclusive<T: Ord<T>> {
    pub end: T,
}


pub struct RangeFull;


pub struct RangeIter<T> {
    start: T,
    end: T,
}

impl<T: Clone + Ord<T> + Increment> Iterator for RangeIter<T> {
    type Item = T;

    fn next(*self) -> Option<Self::Item> {
        match self.start.cmp(&self.end) {
            Ordering::Less => {
                let current = self.start.clone();
                self.start.increment();
                Some(current)
            },
            _ => None,
        }
    }
}


pub struct RangeInclusiveIter<T> {
    start: T,
    end: T,
    done: bool,
}

impl<T: Clone + Ord<T> + Increment> Iterator for RangeInclusiveIter<T> {
    type Item = T;

    fn next(*self) -> Option<Self::Item> {
        if self.done { return None; } 
        match self.start.cmp(&self.end) {
            Ordering::Less => {
                let current = self.start.clone();
                self.start.increment();
                Some(current)
            },
            Ordering::Equal => {
                self.done = true;
                Some(self.start.clone())
            },
            Ordering::Greater => {
                self.done = true;
                None
            },
        }
    }
}


pub struct RangeFromIter<T> {
    start: T,
}

impl<T: Clone + Ord<T> + Increment> Iterator for RangeFromIter<T> {
    type Item = T;

    fn next(*self) -> Option<Self::Item> {
        let current = self.start.clone();
        self.start.increment();
        Some(current)
    }
}


// From https://en.wikipedia.org/wiki/Xorshift#Initialization
fn mix64(x: uint64) -> uint64 {
	x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9;
	x = (x ^ (x >> 27)) * 0x94D049BB133111EB;
	return x ^ (x >> 31);
}

fn builtin_hash_bytes(bytes: *char, length: usize, hash: uint64) -> uint64
{
    let next_u64 = |p, n| {
        let u = 0u64;
        ptr::copy_nonoverlapping(p, &u as *char, n);
        u
    };

    let N = mem::sizeof::<uint64>();
    let h = mix64(hash ^ length as uint64);
    while (length >= N) {
        let x = next_u64(bytes, N);

        h ^= mix64(x);
        h = mix64(h);

        bytes = ptr::add(bytes, N as isize);
        length -= N;
    }
    let x = next_u64(bytes, length);
    mix64(h ^ mix64(x))
}

// Allows "*hs" to be equal to "0 as *char" if "*hs_len" is equal to 0.
fn builtin_rawcmp(
        lhs: *char, lhs_len: usize, 
        rhs: *char, rhs_len: usize) -> int64 {
    let r = ptr::memcmp(lhs, rhs, minmax(lhs_len, rhs_len).0);
    if r != 0 { return r }
    lhs_len as int64 - rhs_len as int64
}


impl<T> From<T> for T {
    fn from(value: T) -> Self {
        value
    }
}

impl<X, Y: From<X>> Into<Y> for X {
    fn into(self) -> Y {
        Y::from(self)
    }
}

impl<I: Iterator> IntoIterator for I {
    type Item = I::Item;
    type IntoIter = I;

    fn into_iter(self) -> I {
        self
    }
}


#[core_item]
pub struct ManuallyDrop<T> {
    pub value: T,
}

impl<T> ManuallyDrop<T> {
    pub fn drop(*self) {
        mem::drop_in_place(&self.value);
    }
}


// TODO: This is a helper to make range indexing more ergonomic until Index can be specialized for Range* types (need unsized types so Index can return a slice, i.e. slices need to be a pointer type)
pub trait IndexRange<Idx> {
    type Output;
    fn index_range(*self, index: Idx) -> []Self::Output;
}

// NOTE: below this line are the many impls of various core traits for integer/float types

impl Copy for int8 {}
impl Clone for int8 { fn clone(*self) -> Self { *self } }
impl Add<Self> for int8 { type Output = Self; fn add(*self, rhs: *Self) -> Self { *self + *rhs } }
impl Sub<Self> for int8 { type Output = Self; fn sub(*self, rhs: *Self) -> Self { *self - *rhs } }
impl Mul<Self> for int8 { type Output = Self; fn mul(*self, rhs: *Self) -> Self { *self * *rhs } }
impl Div<Self> for int8 { type Output = Self; fn div(*self, rhs: *Self) -> Self { *self / *rhs } }
impl Rem<Self> for int8 { type Output = Self; fn rem(*self, rhs: *Self) -> Self { *self % *rhs } }
impl BitAnd<Self> for int8 { type Output = Self; fn bit_and(*self, rhs: *Self) -> Self { *self & *rhs } }
impl BitOr<Self> for int8 { type Output = Self; fn bit_or(*self, rhs: *Self) -> Self { *self | *rhs } }
impl BitXor<Self> for int8 { type Output = Self; fn bit_xor(*self, rhs: *Self) -> Self { *self ^ *rhs } }
impl Shl<Self> for int8 { type Output = Self; fn shl(*self, rhs: *Self) -> Self { *self << *rhs } }
impl Shr<Self> for int8 { type Output = Self; fn shr(*self, rhs: *Self) -> Self { *self >> *rhs } }
impl Eq<Self> for int8 { fn eq(*self, rhs: *Self) -> bool { *self == *rhs } }
impl Increment for int8 { fn increment(*self) { *self += 1; } }
impl Default for int8 { fn default() -> Self { 0 } }


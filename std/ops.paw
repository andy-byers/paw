pub trait Hash {
    fn hash(self) -> int;
}


pub trait Equals {
    fn eq(self, rhs: Self) -> bool;
}


pub trait Compare {
    fn lt(self, rhs: Self) -> bool;
    fn le(self, rhs: Self) -> bool;
}


pub trait Increment {
    fn increment(&self);
}


pub trait Iterate<I: Advance<T>, T> {
    fn iterator(self) -> I;
}


pub trait Advance<T> {
    fn next(&self) -> Option<T>;
}


pub inline struct Range<T: Compare + Increment> {
    pub start: T,
    pub end: T,
}

impl<T: Compare + Increment> Range<T> {
    pub fn contains(self, value: T) -> bool {
        self.start.le(value) && value.lt(self.end)
    }
}

impl<T: Compare + Increment> Iterate<RangeIterator<T>, T> for Range<T> {
    fn iterator(self) -> RangeIterator<T> {
        RangeIterator::new(self)
    }
}


pub inline struct RangeFrom<T: Compare + Increment> {
    pub start: T,
}

impl<T: Compare + Increment> RangeFrom<T> {
    pub fn contains(self, value: T) -> bool {
        self.start.le(value)
    }
}

impl<T: Compare + Increment> Iterate<RangeFromIterator<T>, T> for RangeFrom<T> {
    fn iterator(self) -> RangeFromIterator<T> {
        RangeFromIterator::new(self)
    }
}


pub inline struct RangeTo<T: Compare> {
    pub end: T,
}

impl<T: Compare> RangeTo<T> {
    pub fn contains(self, value: T) -> bool {
        value.lt(self.end)
    }
}


pub inline struct RangeFull;

impl RangeFull {
    pub fn contains<T>(self, value: T) -> bool {
        true
    }
}


pub inline struct RangeInclusive<T: Compare + Increment> {
    pub start: T,
    pub end: T,
}

impl<T: Compare + Increment> RangeInclusive<T> {
    pub fn contains(self, value: T) -> bool {
        self.start.le(value) && value.le(self.end)
    }
}

impl<T: Compare + Increment> Iterate<RangeInclusiveIterator<T>, T> for RangeInclusive<T> {
    fn iterator(self) -> RangeInclusiveIterator<T> {
        RangeInclusiveIterator::new(self)
    }
}


pub inline struct RangeToInclusive<T: Compare> {
    pub end: T,
}

impl<T: Compare> RangeToInclusive<T> {
    pub fn contains(self, value: T) -> bool {
        value.le(self.end)
    }
}


pub inline struct RangeIterator<T: Compare + Increment> {
    end: T,
    iter: T,
}

impl<Ty: Compare + Increment> RangeIterator<Ty> {
    pub fn new(range: Range<Ty>) -> Self {
        Self{iter: range.start, end: range.end}
    }
}

impl<Ty: Compare + Increment> Advance<Ty> for RangeIterator<Ty> {
    fn next(&self) -> Option<Ty> {
        if self.iter.lt(self.end) {
            let iter = self.iter;
            self.iter.increment();
            Some(iter)
        } else {
            None
        }
    }
}


pub inline struct RangeFromIterator<T: Compare + Increment> {
    iter: T,
}

impl<T: Compare + Increment> RangeFromIterator<T> {
    pub fn new(range: RangeFrom<T>) -> Self {
        Self{iter: range.start}
    }
}

impl<T: Compare + Increment> Advance<T> for RangeFromIterator<T> {
    fn next(&self) -> Option<T> {
        let iter = self.iter;
        self.iter.increment();
        Some(iter)
    }
}


pub inline struct RangeInclusiveIterator<T: Compare + Increment> {
    end: T,
    iter: Option<T>,
}

impl<T: Compare + Increment> RangeInclusiveIterator<T> {
    pub fn new(range: RangeInclusive<T>) -> Self {
        Self{iter: Some(range.start), end: range.end}
    }
}

impl<T: Compare + Increment> Advance<T> for RangeInclusiveIterator<T> {
    fn next(&self) -> Option<T> {
        let iter = self.iter?;
        if iter.lt(self.end) {
            let copy = iter;
            copy.increment();
            self.iter = Some(copy);
        } else {
            self.iter = None;
        }
        Some(iter)
    }
}


impl Ord<Self> for int8 { fn cmp(*self, rhs: *Self) -> Ordering { int64::cmp(&(*self as int64), &(*rhs as int64)) } }
impl Ord<Self> for int16 { fn cmp(*self, rhs: *Self) -> Ordering { int64::cmp(&(*self as int64), &(*rhs as int64)) } }
impl Ord<Self> for int32 { fn cmp(*self, rhs: *Self) -> Ordering { int64::cmp(&(*self as int64), &(*rhs as int64)) } }
impl Ord<Self> for isize { fn cmp(*self, rhs: *Self) -> Ordering { int64::cmp(&(*self as int64), &(*rhs as int64)) } }

impl Ord<Self> for int64 {
    fn cmp(*self, rhs: *Self) -> Ordering { 
        if *self < *rhs {
            Ordering::Less
        } else if *self > *rhs {
            Ordering::Greater
        } else {
            Ordering::Equal
        }
    }
}


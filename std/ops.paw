pub struct Range<T> {
    pub start: T,
    pub end: T,
}

impl<T: Compare<T>> Range<T> {
    pub fn contains(*self, value: *T) -> bool {
        self.start.le(value) && value.lt(&self.end)
    }
}

impl<T: Clone + Compare<T> + Increment> Iterator for Range<T> {
    type Item = T;

    fn next(*self) -> Option<Self::Item> {
        if self.start.lt(&self.end) {
            let current = self.start.clone();
            self.start.increment();
            Some(current)
        } else {
            None
        }
    }
}


pub struct RangeFrom<T> {
    pub start: T,
}

impl<T: Compare<T>> RangeFrom<T> {
    pub fn contains(*self, value: *T) -> bool {
        self.start.le(value)
    }
}

impl<T: Clone + Increment> Iterator for RangeFrom<T> {
    type Item = T;

    fn next(*self) -> Option<Self::Item> {
        let current = self.start.clone();
        self.start.increment();
        Some(current)
    }
}


pub struct RangeTo<T: Compare<T>> {
    pub end: T,
}

impl<T: Compare<T>> RangeTo<T> {
    pub fn contains(*self, value: *T) -> bool {
        value.lt(&self.end)
    }
}


pub struct RangeFull;

impl RangeFull {
    pub fn contains<T>(*self, value: *T) -> bool {
        true
    }
}


// TODO: `done` should not be public
pub struct RangeInclusive<T> {
    pub start: T,
    pub end: T,
    pub done: bool,
}

impl<T> RangeInclusive<T> {
    pub fn new(start: T, end: T) -> Self {
        Self{start, end, done: false}
    }

    pub fn start(*self) -> T {
        self.start
    }

    pub fn end(*self) -> T {
        self.end
    }
}

impl<T: Compare<T>> RangeInclusive<T> {
    pub fn contains(*self, value: *T) -> bool {
        self.start.le(value) && value.le(&self.end)
    }
}

impl<T: Clone + Compare<T> + Increment> Iterator for RangeInclusive<T> {
    type Item = T;

    fn next(*self) -> Option<Self::Item> {
        if self.done { return None; } 
        if self.start.lt(&self.end) {
            let current = self.start.clone();
            self.start.increment();
            Some(current)
        } else if (self.start.le(&self.end)) {
            self.done = true;
            Some(self.start.clone())
        } else {
            self.done = true;
            None
        }
    }
}


pub struct RangeToInclusive<T: Compare<T>> {
    pub end: T,
}

impl<T: Compare<T>> RangeToInclusive<T> {
    pub fn contains(*self, value: *T) -> bool {
        value.le(&self.end)
    }
}


fn check_bounds(index: int, length: int, allow_end: bool) {
    if index < 0 || index > length - allow_end as int {
        panic("index out of bounds");
    }
}


#[extern = "paw_builtin_hash_bytes"]
fn builtin_hash_bytes(bytes: *char, length: int, seed: int) -> int;

// Allows "*hs" to be equal to "0 as *char" if "*hs_len" is equal to 0.
#[extern = "paw_builtin_rawcmp"]
fn builtin_rawcmp(
    lhs: *char, lhs_len: int, 
    rhs: *char, rhs_len: int) -> int;


impl<T> From<T> for T {
    fn from(value: T) -> Self {
        value
    }
}

impl<X, Y: From<X>> Into<Y> for X {
    fn into(self) -> Y {
        Y::from(self)
    }
}

impl<I: Iterator> IntoIterator for I {
    type Item = I::Item;
    type IntoIter = I;

    fn into_iter(self) -> I {
        self
    }
}


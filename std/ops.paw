pub use mem;

use ptr;
use slice;

pub trait Drop {
    fn drop(*self);
}


pub trait Copy {}


pub trait Clone {
    fn clone(*self) -> Self;
}


pub trait Hash {
    fn hash(*self) -> uint64;
}


pub trait Add<Rhs> {
    type Output;

    fn add(*self, rhs: *Rhs) -> Self::Output;
}

pub trait Sub<Rhs> {
    type Output;

    fn sub(*self, rhs: *Rhs) -> Self::Output;
}

pub trait Mul<Rhs> {
    type Output;

    fn mul(*self, rhs: *Rhs) -> Self::Output;
}

pub trait Div<Rhs> {
    type Output;

    fn div(*self, rhs: *Rhs) -> Self::Output;
}

pub trait Rem<Rhs> {
    type Output;

    fn rem(*self, rhs: *Rhs) -> Self::Output;
}

pub trait BitAnd<Rhs> {
    type Output;

    fn bit_and(*self, rhs: *Rhs) -> Self::Output;
}

pub trait BitOr<Rhs> {
    type Output;

    fn bit_or(*self, rhs: *Rhs) -> Self::Output;
}

pub trait BitXor<Rhs> {
    type Output;

    fn bit_xor(*self, rhs: *Rhs) -> Self::Output;
}

pub trait Shl<Rhs> {
    type Output;

    fn shl(*self, rhs: *Rhs) -> Self::Output;
}

pub trait Shr<Rhs> {
    type Output;

    fn shr(*self, rhs: *Rhs) -> Self::Output;
}


pub trait Eq<Rhs> {
    fn eq(*self, rhs: *Rhs) -> bool;
}


pub enum Ordering {
    Less,
    Equal,
    Greater,
}

pub trait Ord<Rhs>: Eq<Rhs> {
    fn cmp(*self, rhs: *Rhs) -> Ordering;
}


pub trait Increment {
    fn increment(*self);
}


pub trait Default {
    fn default() -> Self;
}


pub trait From<T> {
    fn from(from: T) -> Self;
}


pub trait Into<T> {
    fn into(self) -> T;
}


pub trait AsPtr<T> {
    fn as_ptr(*self) -> *T;
}


pub trait ToSlice<T> {
    fn to_slice(*self) -> []T;
}


//pub trait ToSliceMut<T> {
//    fn to_slice_mut(*mut self) -> []mut T;
//}


pub trait Index<Idx> {
    type Output;
    fn index(*self, index: Idx) -> *Self::Output;
}


pub trait IntoIterator {
    type Item;
    type IntoIter: Iterator<Item = Self::Item>;

    fn into_iter(self) -> Self::IntoIter;
}

pub trait Iterator {
    type Item;

    fn next(*self) -> Option<Self::Item>;
}


pub trait Fn<Args> {
    type Output;

    fn call(*self, args: Args) -> Self::Output;
}

impl Hash for unit {
    fn hash(*self) -> uint64 { 
        0 
    }
}

impl Eq<Self> for unit {
    fn eq(*self, rhs: *Self) -> bool { 
        true 
    }
}

impl Default for unit {
    fn default() -> Self {
        ()
    }
}


impl Hash for bool {
    fn hash(*self) -> uint64 { 
        *self as uint64 
    }
}

impl Eq<Self> for bool {
    fn eq(*self, rhs: *Self) -> bool { 
        *self == *rhs 
    }
}

impl Default for bool {
    fn default() -> Self {
        false
    }
}


impl Hash for char { 
    fn hash(*self) -> uint64 { 
        *self as uint64 
    }
}

impl Eq<Self> for char { 
    fn eq(*self, rhs: *Self) -> bool { 
        *self == *rhs 
    }
}

impl Ord<Self> for char {
    fn cmp(*self, rhs: *Self) -> Ordering { 
        if *self < *rhs {
            Ordering::Less
        } else if *self > *rhs {
            Ordering::Greater
        } else {
            Ordering::Equal
        }
    }
}

impl Increment for char {
    fn increment(*self) { 
        *self = (*self as int8 + 1) as char; 
    }
}

impl Default for char {
    fn default() -> Self {
        '\0'
    }
}


impl Copy for str {}

impl Clone for str {
    fn clone(*self) -> Self {
        *self
    }
}

impl AsPtr<char> for str {
    #[extern = "paw_ops_str_AsPtr_as_ptr"]
    fn as_ptr(*self) -> *char;
}

impl ToSlice<char> for str {
    fn to_slice(*self) -> []char {
        slice::from_raw_parts(self.as_ptr(), self.len())
    }
}

impl Ord<Self> for str {
    fn cmp(*self, rhs: *Self) -> Ordering { 
        if *self < *rhs {
            Ordering::Less
        } else if *self > *rhs {
            Ordering::Greater
        } else {
            Ordering::Equal
        }
    }
}

impl Index<usize> for str {
    type Output = char;
    fn index(*self, index: usize) -> *char {
        if index > self.len() {
            panic("index out of bounds");
        }
        assert(index <= ISIZE_MAX as usize);
        ptr::add(self.as_ptr(), index as isize)
    }
}

impl Hash for str { 
    fn hash(*self) -> uint64 {
        self.to_slice().hash()
    }
}

impl Eq<Self> for str { 
    fn eq(*self, rhs: *Self) -> bool { 
        *self == *rhs
    }
}

impl Default for str {
    fn default() -> Self {
        ""
    }
}

impl IntoIterator for str {
    type Item = *char;
    type IntoIter = slice::Iter<char>;
    fn into_iter(self) -> Self::IntoIter {
        self.to_slice().into_iter()
    }
}


impl<T> Copy for []T {}

impl<T> AsPtr<T> for []T {
    #[extern = "paw_ops_Slice_AsPtr_as_ptr"]
    fn as_ptr(*self) -> *T;
}

impl<T> Index<usize> for []T {
    type Output = T;
    fn index(*self, index: usize) -> *T {
        if index > self.len() {
            panic("index out of bounds");
        }
        assert(index < ISIZE_MAX as usize);
        ptr::add(self.as_ptr(), index as isize)
    }
}

impl<T> ToSlice<T> for []T {
    fn to_slice(*self) -> []T {
        *self
    }
}

impl Hash for []char {
    fn hash(*self) -> uint64 {
        builtin_hash_bytes(self.as_ptr(), self.len(), 0)
    }
}

impl Ord<Self> for []char {
    fn cmp(*self, rhs: *Self) -> Ordering {
        let r = builtin_rawcmp(self.as_ptr(), self.len(), 
            rhs.as_ptr(), rhs.len());
        match builtin_rawcmp(self.as_ptr(), self.len(), 
                rhs.as_ptr(), rhs.len()) {
            r if r < 0 => Ordering::Less,
            r if r > 0 => Ordering::Greater,
            _ => Ordering::Equal,
        }
    }
}

impl<T: Eq<T>> Eq<Self> for []T {
    fn eq(*self, rhs: *Self) -> bool {
        if self.len() != rhs.len() {
            return false;
        }
        for i in 0..self.len() {
            if !self[i].eq(&rhs[i]) {
                return false;
            }
        }
        true
    }
}


impl Copy for () {}
impl Copy for bool {}
impl Copy for char {}

impl<T> ToSlice<T> for []T {
    fn to_slice(*self) -> []T {
        *self
    }
}

impl Hash for []char {
    fn hash(*self) -> int {
        builtin_hash_bytes(self.as_ptr(), self.len(), 0)
    }
}

impl Compare<Self> for []char {
    fn lt(*self, rhs: *Self) -> bool {
        builtin_rawcmp(self.as_ptr(), self.len(), 
            rhs.as_ptr(), rhs.len()) < 0
    }

    fn le(*self, rhs: *Self) -> bool {
        builtin_rawcmp(self.as_ptr(), self.len(), 
            rhs.as_ptr(), rhs.len()) <= 0
    }
}

// TODO: would be nice to figure out a way to replace with "builtin_rawcmp(...) == 0"
impl<T: Equals<T>> Equals<Self> for []T {
    fn eq(*self, rhs: *Self) -> bool {
        if self.len() != rhs.len() {
            return false;
        }
        for i in 0..self.len() {
            if !self[i].eq(&rhs[i]) {
                return false;
            }
        }
        true
    }
}



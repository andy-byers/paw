#[extern = "paw_math_sin"] 
pub fn sin(f: float64) -> float64;

#[extern = "paw_math_cos"] 
pub fn cos(f: float64) -> float64;

#[extern = "paw_math_tan"]
pub fn tan(f: float64) -> float64;

#[extern = "paw_math_asin"]
pub fn asin(f: float64) -> float64;

#[extern = "paw_math_acos"]
pub fn acos(f: float64) -> float64;

#[extern = "paw_math_atan"]
pub fn atan(f: float64) -> float64;

#[extern = "paw_math_atan2"]
pub fn atan2(a: float64, b: float64) -> float64;

#[extern = "paw_math_is_nan"]
pub fn is_nan(f: float64) -> bool;

#[extern = "paw_math_is_finite"]
pub fn is_finite(f: float64) -> bool;

#[extern = "paw_math_is_negative"]
pub fn is_negative(f: float64) -> bool;

#[extern_std] pub const PI: float;
#[extern_std] pub const NAN: float;
#[extern_std] pub const INFINITY: float;

#[extern_std] pub fn sin(f: float) -> float;
#[extern_std] pub fn cos(f: float) -> float;
#[extern_std] pub fn tan(f: float) -> float;
#[extern_std] pub fn asin(f: float) -> float;
#[extern_std] pub fn acos(f: float) -> float;
#[extern_std] pub fn atan(f: float) -> float;
#[extern_std] pub fn atan2(a: float, b: float) -> float;

#[extern_std] pub fn is_nan(f: float) -> bool;
#[extern_std] pub fn is_finite(f: float) -> bool;
#[extern_std] pub fn is_negative(f: float) -> bool;

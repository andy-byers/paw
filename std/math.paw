#[extern = "paw_math_PI"] 
pub const PI: float;

#[extern = "paw_math_NAN"] 
pub const NAN: float;

#[extern = "paw_math_INFINITY"] 
pub const INFINITY: float;

#[extern = "paw_math_sin"] 
pub fn sin(f: float) -> float;

#[extern = "paw_math_cos"] 
pub fn cos(f: float) -> float;

#[extern = "paw_math_tan"]
pub fn tan(f: float) -> float;

#[extern = "paw_math_asin"]
pub fn asin(f: float) -> float;

#[extern = "paw_math_acos"]
pub fn acos(f: float) -> float;

#[extern = "paw_math_atan"]
pub fn atan(f: float) -> float;

#[extern = "paw_math_atan2"]
pub fn atan2(a: float, b: float) -> float;

#[extern = "paw_math_is_nan"]
pub fn is_nan(f: float) -> bool;

#[extern = "paw_math_is_finite"]
pub fn is_finite(f: float) -> bool;

#[extern = "paw_math_is_negative"]
pub fn is_negative(f: float) -> bool;

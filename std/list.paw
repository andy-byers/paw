const DEFAULT_CAPACITY: usize = 4;


pub struct List<T> {
    pointer: *T,
    length: usize,
    capacity: usize,
}

use array;
use mem;
use ptr;
use slice;

fn is_zst<T>() -> bool {
    mem::sizeof::<T>() == 0
}

impl<T> List<T> {
    pub fn new() -> Self {
        Self::from_raw_parts(ptr::dangling(), 0, 0)
    }

    pub fn len(*self) -> usize {
        self.length
    }

    pub fn capacity(*self) -> usize {
        self.capacity
    }

    pub fn get(*self, index: usize) -> Option<*T> {
        self.check_bounds(index)?;
        Some(self.gep(index))
    }

    pub fn set(*self, index: usize, value: T) -> Option<T> {
        self.check_bounds(index)?;
        Some(ptr::replace(self.gep(index), value))
    }

    pub fn push(*self, value: T) -> mem::Result<()> {
        match self.try_push(value) {
            Ok(()) => Ok(()),
            Err(_) => Err(mem::OutOfMemory),
        }
    }

    pub fn insert(*self, index: usize, value: T) -> Result<(), InsertError> {
        match self.try_insert(index, value) {
            Ok(()) => Ok(()),
            Err((v, e)) => Err(e),
        }
    }

    pub fn try_push(*self, value: T) -> Result<(), T> {
        if self.ensure_many(1).is_err() {
            return Err(value);
        }

        let p = self.gep(self.length);
        ptr::write(p, value);
        self.length += 1;
        Ok(())
    }

    pub fn try_insert(*self, index: usize, value: T) -> Result<(), (T, InsertError)> {
        if self.ensure_many(1).is_err() {
            return Err((value, InsertError::OutOfMemory));
        }

        if index > self.length {
            return Err((value, InsertError::OutOfBounds));
        }

        let p = self.gep(index);
        ptr::copy(p, ptr::add(p, 1), 
            self.length - index);
        ptr::write(p, value);
        self.length += 1;
        Ok(())
    }

    pub fn remove(*self, index: usize) -> T {
        self.ensure_bounds(index);
        let p = self.gep(index);
        let value = ptr::read(p);
        ptr::copy(ptr::add(p, 1), p, 
            self.length - index - 1);
        self.length -= 1;
        value
    }

    pub fn pop(*self) -> T {
        if self.length == 0 {
            panic("pop from empty list\n");
        }
        self.length -= 1;
        ptr::read(self.gep(self.length))
    }

    pub fn reserve(*self, capacity: usize) -> mem::Result<()> {
        if capacity > self.capacity {
            self.grow_copy(capacity)?;
        }
        Ok(())
    }

    pub fn from_raw_parts(pointer: *T, length: usize, capacity: usize) -> Self {
        // use the maximum capacity for ZSTs to avoid the need for reallocation
        if is_zst::<T>() { capacity = USIZE_MAX; }
        Self{pointer, length, capacity}
    }

    pub fn into_raw_parts(self) -> (*T, usize, usize) {
        let Self{pointer, length, capacity} = self;
        (pointer, length, capacity)
    }

    fn check_bounds(*self, index: usize) -> Option<()> {
        if index < self.length {
            Some(())
        } else {
            None
        }
    }

    fn ensure_bounds(*self, index: usize) {
        match self.check_bounds(index) {
            None => panic("index out of bounds\n"),
            _ => (),
        }
    }

    fn next_capacity(minimum: usize) -> usize {
        let grow = minimum / 2 + 1;
        if minimum <= USIZE_MAX - grow {
            minimum + grow
        } else {
            USIZE_MAX
        }
    }

    fn grow_copy(*self, capacity: usize) -> mem::Result<()> {
        let n = Self::next_capacity(capacity);
        let p = mem::alloc::<T>(n)?;
        ptr::copy_nonoverlapping(self.pointer, p, self.length);
        self.capacity = n;
        self.pointer = p;
        Ok(())
    }

    fn grow_resize(*self, capacity: usize) -> mem::Result<()> {
        let n = Self::next_capacity(capacity);
        self.pointer = mem::realloc::<T>(self.pointer, n)?;
        self.capacity = n;
        Ok(())
    }

    fn ensure_one(*self) -> mem::Result<()> {
        assert(self.length <= self.capacity);
        if self.length == self.capacity {
            if self.length == USIZE_MAX {
                return Err(mem::OutOfMemory);
            }
            self.grow_resize(self.length + 1)?;
        }
        Ok(())
    }

    fn ensure_many(*self, count: usize) -> mem::Result<()> {
        assert(self.length <= self.capacity);
        if self.capacity < count 
                || self.length > self.capacity - count {
            if self.length > USIZE_MAX - count {
                return Err(mem::OutOfMemory);
            }
            self.grow_copy(self.length + count)?;
        }
        Ok(())
    }

    fn gep(*self, index: usize) -> *T {
        ptr::add(self.as_ptr(), index as isize)
    }

    pub fn with_capacity(capacity: usize) -> mem::Result<Self> {
        let result = Self::new();
        result.reserve(capacity)?;
        Ok(result)
    }

    pub fn from_array<const LENGTH: usize>(arr: [LENGTH]T) -> mem::Result<Self> {
        let result = Self::with_capacity(LENGTH)?;
        for value in arr {
            result.push(value).unwrap();
        }
        Ok(result)
    }
}


pub enum InsertError {
    OutOfMemory,
    OutOfBounds,
}


impl<T> Drop for List<T> {
    fn drop(*self) {
        if ptr::needs_drop::<T>() {
            for r in 0..self.length {
                let index = self.length - r - 1;
                mem::drop_in_place(self.gep(index));
            }
        }

        if !is_zst::<T>() {
            if self.capacity != 0 {
                mem::dealloc(self.pointer);
            }
        }
    }
}

impl<T> Index<usize> for List<T> {
    type Output = T;
    fn index(*self, index: usize) -> *T {
        match self.get(index) {
            Some(value) => value,
            None => panic("index out of bounds for list\n"),
        }
    }
}

impl<T> ToSlice<T> for List<T> {
    fn to_slice(*self) -> []T {
        slice::from_raw_parts(self.as_ptr(), self.len())
    }
}

impl<T> AsPtr<T> for List<T> {
    fn as_ptr(*self) -> *T {
        self.pointer
    }
}

impl<T> Default for List<T> {
    fn default() -> Self {
        Self::new()
    }
}


pub use slice::Iter;
//pub use slice::IterMut;

pub struct IntoIter<T> {
    inner: List<T>,
    index: usize,
}

impl<T> IntoIter<T> {
    pub fn new(inner: List<T>) -> Self {
        Self{inner, index: 0}
    }
}

impl<T> Drop for IntoIter<T> {
    fn drop(*self) {
        for i in self.index..self.inner.len() {
            mem::drop_in_place(self.inner.gep(i));
        }

        // prevent elements from being dropped again
        self.inner.length = 0;
    }
}

impl<T> Iterator for IntoIter<T> {
    type Item = T;

    fn next(*self) -> Option<Self::Item> {
        if self.index < self.inner.len() {
            let p = &self.inner[self.index];
            self.index += 1;
            Some(ptr::read(p))
        } else {
            None
        }        
    }
}

impl<T> IntoIterator for List<T> {
    type Item = T;
    type IntoIter = IntoIter<T>;

    fn into_iter(self) -> Self::IntoIter {
        IntoIter::new(self)
    }
}

impl<T> IntoIterator for *List<T> {
    type Item = *T;
    type IntoIter = Iter<T>;

    fn into_iter(self) -> Self::IntoIter {
        self.to_slice().into_iter()
    }
}


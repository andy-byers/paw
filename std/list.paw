impl<T: Clone> List<T> {
    pub fn extend<I: IntoIterator<Item = *T>>(*self, iter: I) -> mem::Result<()> {
        for value in iter {
            self.push(value.clone())?;
        }
        Ok(())
    }
}

impl<T: Copy> List<T> {
    pub fn extend_from_slice(*self, slice: []T) -> mem::Result<()> {
        self.ensure_many(slice.len())?;

        ptr::copy(slice.as_ptr(), 
            ptr::add(self.start, self.length), 
            slice.len());
        self.length += slice.len();
        Ok(())
    }
}


impl<T> IndexRange<Range<int>> for List<T> {
    type Output = T;
    fn index_range(*self, idx: Range<int>) -> []T {
        call_index_range(&self.to_slice(), idx)
    }
}

impl<T> IndexRange<RangeInclusive<int>> for List<T> {
    type Output = T;
    fn index_range(*self, idx: RangeInclusive<int>) -> []T {
        call_index_range(&self.to_slice(), idx)
    }
}

impl<T> IndexRange<RangeFrom<int>> for List<T> {
    type Output = T;
    fn index_range(*self, idx: RangeFrom<int>) -> []T {
        call_index_range(&self.to_slice(), idx)
    }
}

impl<T> IndexRange<RangeTo<int>> for List<T> {
    type Output = T;
    fn index_range(*self, idx: RangeTo<int>) -> []T {
        call_index_range(&self.to_slice(), idx)
    }
}

impl<T> IndexRange<RangeToInclusive<int>> for List<T> {
    type Output = T;
    fn index_range(*self, idx: RangeToInclusive<int>) -> []T {
        call_index_range(&self.to_slice(), idx)
    }
}

impl<T> IndexRange<RangeFull> for List<T> {
    type Output = T;
    fn index_range(*self, idx: RangeFull) -> []T {
        call_index_range(&self.to_slice(), idx)
    }
}

fn call_index_range<R: IndexRange<Idx>, Idx>(r: *R, index: Idx) -> []R::Output {
    r.index_range(index)
}


use io;

impl io::Write for List<char> {
    fn write(*self, data: []char) -> io::Result<int> {
        self.extend_from_slice(data)?;
        Ok(data.len())
    }
}


impl<T: Eq<T>> Eq<Self> for List<T> {
    fn eq(*self, rhs: *Self) -> bool {
        if self.len() != rhs.len() {
            return false;
        }
        for i in 0..self.len() {
            if !self[i].eq(&rhs[i]) {
                return false;
            }
        }
        true
    }
}


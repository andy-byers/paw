impl<T: Clone> List<T> {
    pub fn extend<I: IntoIterator<Item = *T>>(*self, iter: I) -> mem::Result<()> {
        for value in iter {
            self.push(value.clone())?;
        }
        Ok(())
    }

    pub fn resize(*self, len: usize, value: T) -> mem::Result<()> {
        if len > self.len() {
            self.reserve(len)?;
            for i in self.len()..len {
                let elem = self.gep(i);
                ptr::write(elem, value.clone());
            }
        } else if ptr::needs_drop::<T>() {
            for i in len..self.len() {
                mem::drop_in_place(self.gep(i));
            }
        }
        self.length = len;
        Ok(())
    }
}

impl<T: Copy> List<T> {
    pub fn extend_from_slice(*self, slice: []T) -> mem::Result<()> {
        self.ensure_many(slice.len())?;

        ptr::copy(slice.as_ptr(), 
            ptr::add(self.pointer, self.length as isize),
            slice.len());
        self.length += slice.len();
        Ok(())
    }
}


impl<T> IndexRange<Range<usize>> for List<T> {
    type Output = T;
    fn index_range(*self, idx: Range<usize>) -> []T {
        call_index_range(&self.to_slice(), idx)
    }
}

impl<T> IndexRange<RangeInclusive<usize>> for List<T> {
    type Output = T;
    fn index_range(*self, idx: RangeInclusive<usize>) -> []T {
        call_index_range(&self.to_slice(), idx)
    }
}

impl<T> IndexRange<RangeFrom<usize>> for List<T> {
    type Output = T;
    fn index_range(*self, idx: RangeFrom<usize>) -> []T {
        call_index_range(&self.to_slice(), idx)
    }
}

impl<T> IndexRange<RangeTo<usize>> for List<T> {
    type Output = T;
    fn index_range(*self, idx: RangeTo<usize>) -> []T {
        call_index_range(&self.to_slice(), idx)
    }
}

impl<T> IndexRange<RangeToInclusive<usize>> for List<T> {
    type Output = T;
    fn index_range(*self, idx: RangeToInclusive<usize>) -> []T {
        call_index_range(&self.to_slice(), idx)
    }
}

impl<T> IndexRange<RangeFull> for List<T> {
    type Output = T;
    fn index_range(*self, idx: RangeFull) -> []T {
        call_index_range(&self.to_slice(), idx)
    }
}

fn call_index_range<R: IndexRange<Idx>, Idx>(r: *R, index: Idx) -> []R::Output {
    r.index_range(index)
}


use io;

impl io::Write for List<char> {
    fn write(*self, data: []char) -> io::Result<usize> {
        self.extend_from_slice(data)?;
        Ok(data.len())
    }
}


use iter;

impl<T: Eq<T>> Eq<Self> for List<T> {
    fn eq(*self, rhs: *Self) -> bool {
        if self.len() != rhs.len() {
            return false;
        }
        for (x, y) in iter::zip(self, rhs) {
            if !x.eq(y) { return false }
        }
        true
    }
}


pub struct List<T>;

impl<T> [T] {
    // Transform negative indices into offsets from the end of the list,
    // where more negative means farther away from the end.
    fn absolute_index(self, index: int) -> Option<int> {
        if index < 0 { 
            index += #self; 
        }
        if 0 <= index && index < #self {
            Some(index)
        } else {
            None
        }
    }

    pub fn length(self) -> int {
        #self
    }

    pub fn get(self, index: int) -> Option<T> {
        match self.absolute_index(index) {
            Some(i) => Some(self[i]),
            None => None,
        }
    }

    pub fn get_or(self, index: int, default: T) -> T {
        match self.get(index) {
            Some(value) => value,
            None => default,
        }
    }

    #[extern] pub fn push(self, value: T);
    #[extern] pub fn pop(self) -> T;
    #[extern] pub fn insert(self, index: int, value: T);
    #[extern] pub fn remove(self, index: int) -> T;
}

use str_builder;

impl<T: Default> [T] {
    pub fn with_length(length: int) -> Self {
        let result = [];
        for i in 0..length {
            result.push(T::default());
        }
        result
    }
}

impl [char] {
    pub fn from_str(value: str) -> Self {
        let result = [];
        for i in 0..#value {
            result.push(value[i]);
        }
        result
    }

    pub fn as_str(self) -> str {
        let b = str_builder::Builder::new();
        for c in self {
            b.append_char(c);
        }
        b.string()
    }
}

impl<T> Default for [T] {
    fn default() -> Self {
        []
    }
}

impl<T> Iterate<ListIterator<T>, T> for [T] {
    fn iterator(self) -> ListIterator<T> {
        ListIterator::new(self)
    }
}


pub inline struct ListIterator<T> {
    list: [T],
    index: int,
}

impl<T> ListIterator<T> {
    pub fn new(list: [T]) -> Self {
        Self{list, index: 0}
    }
}

impl<T> Advance<T> for ListIterator<T> {
    fn next(&self) -> Option<T> {
        if self.index < #self.list {
            let i = self.index;
            self.index = i + 1;
            Some(self.list[i])
        } else {
            None
        }
    }
}

use ops::Equals;

impl<T: Equals> Equals for [T] {
    fn eq(self, rhs: Self) -> bool {
        if #self != #rhs {
            return false;
        }
        for i in 0..#self {
            if !self[i].eq(rhs[i]) {
                return false;
            }
        }
        true
    }
}


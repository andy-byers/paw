pub use string::String;

use array;
use list::List;
use mem;
use ptr;
use result;
use slice;
use string_builder::Builder as StringBuilder;


pub trait Display {
    fn fmt(*self, f: *Formatter) -> Result<()>;
}


pub enum Error {
    OutOfMemory,
    InvalidBase,
}

use Error::*;

impl From<mem::OutOfMemory> for Error {
    fn from(value: mem::OutOfMemory) -> Self {
        Error::OutOfMemory
    }
}


pub type Result<T> = result::Result<T, Error>;


pub struct Formatter {
    b: StringBuilder,
}

impl Formatter {
    pub fn new() -> Self {
        Self{b: StringBuilder::new()}
    }

    pub fn write<I: IntoIterator<Item = *char>>(*self, iter: I) -> Result<()> {
        for p in iter { 
            self.write_char(*p)?; 
        }
        Ok(())
    }

    pub fn write_slice(*self, values: []char) -> Result<()> {
        Ok(self.b.append_slice(values)?)
    }

    pub fn write_char(*self, value: char) -> Result<()> {
        Ok(self.b.append_char(value)?)
    }

    pub fn string(self) -> String {
        let Self{b} = self;
        b.string()
    }
}

#[extern = "paw_fmt_write_float"]
fn write_float_to(value: float, precision: int, output: *char, output_len: int) -> int;


impl Display for int {
    fn fmt(*self, f: *Formatter) -> Result<()> {
        let temp = array::zeros::<32, char>();
        let negative = *self < 0;
        let end = temp.len();
        let idx = end - 1;

        if *self == INT_MIN {
            let int64_min = "-9223372036854775808";
            return f.write_slice(int64_min.to_slice());
        }
        let u = if negative { -*self } else { *self };
        let FIRST_DIGIT: int = '0' as int;
        loop {
            temp[idx] = (u % 10 + FIRST_DIGIT) as char;
            idx -= 1;
            u /= 10;
            if u == 0 { 
                break; 
            }
        }
        if negative {
            temp[idx] = '-';
        } else {
            idx += 1;
        }

        f.write_slice(slice::from_raw_parts(
            &temp[idx], end - idx))
    }
} 

impl Display for float {
    fn fmt(*self, f: *Formatter) -> Result<()> {
        let temp = array::zeros::<32, char>();
        let len = write_float_to(*self, 17, &temp[0], temp.len());
        f.write_slice(slice::from_raw_parts(&temp[0], len))
    }
} 

impl Display for str {
    fn fmt(*self, f: *Formatter) -> Result<()> {
        f.write_slice(self.to_slice())
    }
} 

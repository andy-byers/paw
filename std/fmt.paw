pub use string::String;

use mem;
use ptr;
use result;
use string_builder;


pub trait Display {
    fn fmt(*self, f: *Formatter) -> mem::Result<()>;
}


pub enum Error {
    OutOfMemory,
    InvalidBase,
}

use Error::*;

impl Into<Error> for mem::OutOfMemory {
    fn into(self) -> Error {
        Error::OutOfMemory
    }
}


pub type Result<T> = result::Result<T, Error>;


pub struct Formatter {
    b: string_builder::Builder,
}

impl Formatter {
    pub fn new() -> Self {
        Self{b: string_builder::Builder::new()}
    }

    pub fn append_<I: IntoIterator<Item = *char>>(*self, iter: I) -> Result<()> {
        for p in iter {
            self.append_char(*p)?;
        }
        Ok(())
    }

    pub fn append<T: ToSlice<char>>(*self, value: T) -> Result<()> {
        Ok(())
    }

    pub fn append_char(*self, value: char) -> Result<()> {
        // TODO: need error conversion
//        self.b.append_char(value)?;
        Ok(())
    }

    pub fn append_int_radix(*self, value: int, base: int) -> Result<()> {
        if base < 1 || base > 36 { return Err(InvalidBase); }
        Ok(())
    }

    pub fn append_int(*self, value: int) -> Result<()> {
        self.append_int_radix(value, 10)
    }

    pub fn append_float(*self, value: int) -> Result<()> {
        Ok(())
    }

    pub fn string(self) -> String {
        let b = ptr::replace(&self.b, string_builder::Builder::new());
        b.string()
    }
}

// TODO: ITEM_* variables could be made "const" if "mem::*of()" were made into intrinsics or (if this ever gets implemented) trait-associated constants (like <K as StrideOf>::Value)

// HashMap layout:
//
// The data buffer backing a HashMap object is split into 2 sections: the
// metadata region and the items region. Both regions contains an entry
// for each available slot in the hash map, i.e. each section has a length
// equal to the hash map capacity. A metadata entry consists of a flag
// indicating if the entry is used as well as the highest 7 bits of the
// key hash for that entry. Each item entry consists of an instance of 
// the `Item<K, V>` structure.


use ptr;
use slice;

const GROWTH_EXPONENT: usize = 1;
const LOAD_LENGTH: usize = 7;
const LOAD_CAPACITY: usize = 8;


pub struct HashMap<K: Hash + Eq<K>, V> {
    buffer: *char,
    length: usize,
    capacity: usize,
}


const FINGERPRINT_WIDTH: usize = 7;
const TOMBSTONE_VALUE: uint8 = 1;
const VACANT_VALUE: uint8 = 0;

struct Metadata {
    data: uint8,
}

impl Copy for Metadata {}

enum State {
    Occupied,
    Vacant,
    Erased,
}

impl Metadata {
    pub fn is_used(*self) -> bool {
        self.data & 1 != 0
    }

    pub fn clear_used_flag(*self) {
        self.data = Self::encode(self.fingerprint(), false);
    }

    pub fn set_used_flag(*self) {
        self.data = Self::encode(self.fingerprint(), true);
    }

    pub fn fingerprint(*self) -> Fingerprint {
        Fingerprint::new(self.data >> 1)
    }

    pub fn set_fingerprint(*self, fingerprint: Fingerprint) {
        self.data = Self::encode(fingerprint, self.is_used());
    }

    // Determine the state of the entry represented by this metadata
    pub fn state(self) -> State {
        if self.is_used() {
            State::Occupied
        } else if self.fingerprint().as_int() == TOMBSTONE_VALUE {
            State::Erased
        } else {
            State::Vacant
        }
    }

    fn encode(fingerprint: Fingerprint, is_used: bool) -> uint8 {
        (fingerprint.as_int() << 1) | is_used as uint8
    }
}


struct Fingerprint {
    value: uint8,
}

impl Copy for Fingerprint {}

impl Fingerprint {
    pub fn new(value: uint8) -> Self {
        assert(value < (1 << FINGERPRINT_WIDTH as uint8));
        Self{value}
    }

    pub fn from_hash(hash: uint64) -> Self {
        // use the `FINGERPRINT_WIDTH` highest-order bits from the hash
        let SHIFT: usize = mem::sizeof::<uint64>() * 8 - FINGERPRINT_WIDTH;
        Self::new((hash >> SHIFT as uint64) as uint8)
    }

    pub fn as_int(self) -> uint8 {
        self.value
    }
}

impl Eq<Self> for Fingerprint {
    fn eq(*self, rhs: *Self) -> bool {
        self.as_int() == rhs.as_int()
    }
}


struct Item<K, V> {
    pub key: K,
    pub value: V,
}


struct ItemInfo<K, V> {
    pub metadata: *Metadata,
    pub item: Item<K, V>,
}


struct Cursor<K, V> {
    metadata: *Metadata,
    items: []Item<K, V>,
    index: usize,
}

impl<K, V> Copy for Cursor<K, V> {}

impl<K, V> Cursor<K, V> {
    pub fn new(metadata: *Metadata, items: []Item<K, V>, index: usize) -> Self {
        Self{metadata, items, index}
    }

    pub fn is_valid(*self) -> bool {
        self.index < self.items.len()
    }

    pub fn metadata(*self) -> *Metadata {
        ptr::add(self.metadata, self.index as isize)
    }

    pub fn prefix(*self) -> Fingerprint {
        self.metadata().fingerprint()
    }

    pub fn key(*self) -> *K {
        &self.items[self.index].key
    }

    pub fn value(*self) -> *V {
        &self.items[self.index].value
    }

    pub fn state(*self) -> State {
        self.metadata().state()
    }

    pub fn is_occupied(*self) -> bool {
        match self.state() {
            State::Occupied => true,
            _ => false,
        }
    }

    pub fn is_erased(*self) -> bool {
        match self.state() {
            State::Erased => true,
            _ => false,
        }
    }

    pub fn is_vacant(*self) -> bool {
        match self.state() {
            State::Vacant => true,
            _ => false,
        }
    }

    pub fn set_key(*self, key: K, hash: uint64) {
        let f = Fingerprint::from_hash(hash);
        self.metadata().set_fingerprint(f);
        self.metadata().set_used_flag();
        *self.key() = key;
    }

    pub fn set_value(*self, value: V) {
        *self.value() = value;
    }

    pub fn set_occupied(*self, prefix: Fingerprint) {
        self.metadata().set_fingerprint(prefix);
        self.metadata().set_used_flag();
    }

    pub fn set_vacant(*self) {
        let prefix = Fingerprint::new(VACANT_VALUE);
        self.metadata().set_fingerprint(prefix);
        self.metadata().clear_used_flag();
    }

    pub fn set_erased(*self) {
        let prefix = Fingerprint::new(TOMBSTONE_VALUE);
        self.metadata().set_fingerprint(prefix);
        self.metadata().clear_used_flag();
    }

    pub fn next(*self) {
        if self.index < self.items.len() {
            self.index += 1;
        }
    }

    pub fn next_wrapping(*self) {
        self.index = (self.index + 1) & (self.items.len() - 1);
    }
}


impl<K: Hash + Eq<K>, V> HashMap<K, V> {
    pub fn new() -> Self {
        Self{
            buffer: ptr::null::<char>(),
            length: 0,
            capacity: 0,
        }
    }

    pub fn from_array<const N: usize>(values: [N](K, V)) -> mem::Result<Self> {
        let result = Self::new();
        for (k, v) in values {
            result.insert(k, v)?;
        }
        Ok(result)
    }

    pub fn len(*self) -> usize {
        self.length
    }

    pub fn capacity(*self) -> usize {
        self.capacity
    }

    pub fn get(*self, key: *K) -> Option<*V> {
        match self.lookup(key, key.hash()) {
            Some(c) => Some(c.value()),
            None => None,
        }
    }

    pub fn insert(*self, key: K, value: V) -> mem::Result<Option<V>> {
        self.ensure_one()?;

        let erased = None;
        let hash = key.hash();
        let cursor = self.cursor(hash);
        let prefix = Fingerprint::from_hash(hash);

        let counter = 0;
        while counter < self.capacity 
                && !cursor.is_vacant() {
            if cursor.is_erased() {
                if erased.is_none() {
                    erased = Some(cursor);
                }
            } else if cursor.prefix().eq(&prefix)
                    && cursor.key().eq(&key) {
                value = ptr::replace(cursor.value(), value);
                return Ok(Some(value));
            }
            cursor.next_wrapping();
            counter += 1;
        }
        self.length += 1;
        cursor = match erased {
            None => cursor,
            Some(c) => c,
        };
        cursor.set_occupied(prefix);
        ptr::write(cursor.key(), key);
        ptr::write(cursor.value(), value);
        Ok(None)
    }

    pub fn remove(*self, key: *K) -> Option<V> {
        match self.lookup(key, key.hash()) {
            Some(c) => {
                let v = ptr::read(c.value());
                c.set_erased();
                self.length -= 1;
                Some(v)
            },
            None => None,
        }
    }

    pub fn get_or(*self, key: *K, default: *V) -> *V {
        match self.get(key) {
            Some(value) => value,
            None => default,
        }
    }

    pub fn contains(*self, key: *K) -> bool {
        match self.get(key) {
            Some(_) => true,
            None => false,
        }
    }

    // Requires that "capacity" be a valid HashMap capacity (i.e. a power-of-2
    // for which "compute_buffer_size(capacity)" returns "Ok(...)").
    fn compute_items_offset(capacity: usize) -> usize {
        align_up(capacity, mem::alignof::<Item<K, V>>())
    }

    fn item_at_index(items: *Item<K, V>, index: usize) -> *Item<K, V> {
        ptr::add(items, index as isize) 
    }

    fn compute_buffer_size(capacity: usize) -> mem::Result<usize> {
        let ITEM_ALIGNMENT: usize = mem::alignof::<Item<K, V>>();
        let ITEM_STRIDE: usize = mem::strideof::<Item<K, V>>();

        if capacity > USIZE_MAX - ITEM_ALIGNMENT {
            return Err(mem::OutOfMemory);
        }
        let offset = Self::compute_items_offset(capacity);
        if capacity > USIZE_MAX / ITEM_STRIDE
                || offset > USIZE_MAX - capacity * ITEM_STRIDE {
            return Err(mem::OutOfMemory);
        }
        Ok(offset + capacity * ITEM_STRIDE)
    }

    fn items_region(*self) -> []Item<K, V> {
        let items_offset = Self::compute_items_offset(self.capacity);
        let p = ptr::add(self.buffer, items_offset as isize) as *Item<K, V>;
        slice::from_raw_parts(p, self.capacity)
    }

    fn cursor(*self, hash: uint64) -> Cursor<K, V> {
        let items = self.items_region();
        let index = hash & (self.capacity as uint64 - 1);
        Cursor::new(self.buffer as *Metadata, items, index as usize)
    }

    fn lookup(*self, key: *K, hash: uint64) -> Option<Cursor<K, V>> {
        if self.length == 0 { return None; }
        let prefix = Fingerprint::from_hash(hash);
        let cursor = self.cursor(hash);
        for _ in 0..self.capacity {
            match cursor.state() {
                State::Occupied => {
                    if cursor.prefix().eq(&prefix)
                            && cursor.key().eq(key) {
                        return Some(cursor);
                    }
                },
                State::Vacant => break,
                State::Erased => (),
            }
            cursor.next_wrapping();
        }
        None
    }

    fn ensure_one(*self) -> mem::Result<()> {
        let ITEM_ALIGNMENT: usize = mem::alignof::<Item<K, V>>();
        let ITEM_STRIDE: usize = mem::strideof::<Item<K, V>>();
        let GROWTH_FACTOR: usize = 1 << GROWTH_EXPONENT;

        let free_slots = self.capacity / LOAD_CAPACITY 
            * (LOAD_CAPACITY - LOAD_LENGTH);
        if self.length < self.capacity - free_slots {
            return Ok(());
        }
        if self.capacity > USIZE_MAX / GROWTH_FACTOR {
            return Err(mem::OutOfMemory);
        }
        let capacity = if self.capacity > 0 {
            self.capacity * GROWTH_FACTOR
        } else {
            LOAD_CAPACITY
        };

        // capacity must always be a power of 2
        assert(is_aligned(capacity, capacity));

        let buffer = mem::alloc(Self::compute_buffer_size(capacity)?)?;
        ptr::memset(buffer, 0 as char, capacity); // clear metadata
        let map = HashMap{buffer, capacity, length: self.length};

        let cursor = self.cursor(0);
        while cursor.is_valid() {
            if cursor.is_occupied() {
                let key = ptr::read(cursor.key());
                let value = ptr::read(cursor.value());
                
                map.insert(key, value)
                    .expect("failed unexpected allocation")
                    .expect_none("detected hash map corruption");
            }
            cursor.next();
        }

        mem::dealloc(self.buffer);
        self.buffer = buffer;
        self.capacity = capacity;
        Ok(())
    }
}

impl<K: Hash + Eq<K>, V> Index<*K> for HashMap<K, V> {
    type Output = V;

    // Panics if key cannot be found in the hash map.
    fn index(*self, index: *K) -> *V {
        self.get(index).unwrap()
    }
}

impl<K: Hash + Eq<K>, V> Default for HashMap<K, V> {
    fn default() -> Self {
        Self::new()
    }
}


fn is_aligned(x: usize, a: usize) -> bool {
    x & (a - 1) == 0
}

fn align_up(x: usize, a: usize) -> usize {
    (x + (a - 1)) & ~(a - 1)
}




pub struct Iter<K: Hash + Eq<K>, V> {
    cursor: Cursor<K, V>,
}

impl<K: Hash + Eq<K>, V> Iter<K, V> {
    pub fn new(inner: *HashMap<K, V>) -> Self {
        Self{cursor: inner.cursor(0)}
    }
}

impl<K: Hash + Eq<K>, V> Iterator for Iter<K, V> {
    type Item = (*K, *V);

    fn next(*self) -> Option<Self::Item> {
        while self.cursor.is_valid() {
            let c = self.cursor;
            self.cursor.next();
            if c.is_occupied() {
                return Some((c.key(), c.value()));
            }
        }
        None
    }
}


pub struct IntoIter<K: Hash + Eq<K>, V> {
    inner: HashMap<K, V>,
    cursor: Cursor<K, V>,
}

impl<K: Hash + Eq<K>, V> IntoIter<K, V> {
    pub fn new(inner: HashMap<K, V>) -> Self {
        let cursor = inner.cursor(0);
        Self{inner, cursor}
    }
}

impl<K: Hash + Eq<K>, V> Drop for IntoIter<K, V> {
    fn drop(*self) {
        // prevent Drop from being called on elements
        self.inner.length = 0;
    }
}

impl<K: Hash + Eq<K>, V> Iterator for IntoIter<K, V> {
    type Item = (K, V);

    fn next(*self) -> Option<Self::Item> {
        while self.cursor.is_valid() {
            let c = self.cursor;
            self.cursor.next();
            if c.is_occupied() {
                return Some((
                    ptr::read(c.key()), 
                    ptr::read(c.value()),
                ));
            }
        }
        None
    }
}

impl<K: Hash + Eq<K>, V> IntoIterator for HashMap<K, V> {
    type Item = (K, V);
    type IntoIter = IntoIter<K, V>;

    fn into_iter(self) -> Self::IntoIter {
        IntoIter::new(self)
    }
}

impl<K: Hash + Eq<K>, V> IntoIterator for *HashMap<K, V> {
    type Item = (*K, *V);
    type IntoIter = Iter<K, V>;

    fn into_iter(self) -> Self::IntoIter {
        Iter::new(self)
    }
}


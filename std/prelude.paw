pub use ops::*;
pub use option::*;
pub use result::*;


pub const CHAR_MAX: char = '\xFF';
pub const CHAR_MIN: char = '\x00';


pub const INT_MAX: int = 0x7FFFFFFFFFFFFFFF;
pub const INT_MIN: int = -INT_MAX - 1;

impl str {
    #[extern = "paw_str_from_raw_parts"] 
    pub fn from_raw_parts(ptr: *char, len: int) -> Self;

    #[extern = "paw_str_len"] 
    pub fn len(self) -> int;

    #[extern = "paw_str_parse_int"] 
    pub fn parse_int(self) -> Option<int>;

    #[extern = "paw_str_parse_int_radix"] 
    pub fn parse_int_radix(self, base: int) -> Option<int>;

    #[extern = "paw_str_parse_float"] 
    pub fn parse_float(self) -> Option<float>;

    #[extern = "paw_str_find"] 
    pub fn find(self, target: Self) -> Option<int>;

    #[extern = "paw_str_starts_with"] 
    pub fn starts_with(self, prefix: Self) -> bool;

    #[extern = "paw_str_ends_with"] 
    pub fn ends_with(self, suffix: Self) -> bool;
}

use slice::ToSlice;

pub fn panic<T: ToSlice<char>>(message: T) -> ! {
    panic_handler(message.to_slice());
}

#[extern = "paw_panic_handler"] 
pub fn panic_handler(message: []char) -> !;

pub fn assert(cond: bool) {
    if !cond {
        panic("assertion failure");
    }
}


pub use ops::*;
pub use option::*;
pub use result::*;


pub const INT8_MIN: int8 = -INT8_MAX - 1;
pub const INT16_MIN: int16 = -INT16_MAX - 1;
pub const INT32_MIN: int32 = -INT32_MAX - 1;
pub const INT64_MIN: int64 = -INT64_MAX - 1;
pub const ISIZE_MIN: isize = -ISIZE_MAX - 1;

pub const INT8_MAX: int8 = 0x7F;
pub const INT16_MAX: int16 = 0x7FFF;
pub const INT32_MAX: int32 = 0x7FFFFFFF;
pub const INT64_MAX: int64 = 0x7FFFFFFFFFFFFFFF;
pub const ISIZE_MAX: isize = 0x7FFFFFFFFFFFFFFF;

pub const UINT8_MAX: uint8 = 0xFF;
pub const UINT16_MAX: uint16 = 0xFFFF;
pub const UINT32_MAX: uint32 = 0xFFFFFFFF;
pub const UINT64_MAX: uint64 = 0xFFFFFFFFFFFFFFFF;
pub const USIZE_MAX: usize = 0xFFFFFFFFFFFFFFFF;


impl str {
    #[extern = "paw_str_from_raw_parts"] 
    pub fn from_raw_parts(ptr: *char, len: usize) -> Self;

    #[extern = "paw_str_len"] 
    pub fn len(self) -> usize;

    pub fn is_empty(self) -> bool {
        self.len() == 0
    }

    pub fn parse_int(self) -> Result<int64, ParseIntError> {
        self.parse_int_radix(10)
    }

    pub fn parse_uint(self) -> Result<uint64, ParseIntError> {
        self.parse_uint_radix(10)
    }

    pub fn parse_int_radix(self, base: int64) -> Result<int64, ParseIntError> {
        if self.is_empty() { 
            return Err(ParseIntError::Empty); 
        }
        let minus = self[0] == '-';
        if minus || self[0] == '+' {
            self = skipchar(self);
        }
        
        let u = parse_uint_radix_nonempty(self, base)?;
        if u > INT64_MAX as uint64 + minus as uint64 {
            Err(ParseIntError::Overflow)
        } else if minus {
            Ok(-u as int64)
        } else {
            Ok(u as int64)
        }
    }

    pub fn parse_uint_radix(self, base: int64) -> Result<uint64, ParseIntError> {
        if self.is_empty() { 
            return Err(ParseIntError::Empty); 
        }
        if self[0] == '+' {
            self = skipchar(self);
        }
        
        parse_uint_radix_nonempty(self, base)
    }

    pub fn parse_float(self) -> Result<float64, ParseFloatError> {
        if self.is_empty() {
            return Err(ParseFloatError::Empty);
        }
        let f = 0.0;
        if internal_parse_float(self, &f) == -1 {
            Err(ParseFloatError::InvalidChar)
        } else {
            Ok(f)
        }
    }

    #[extern = "paw_str_find"] 
    pub fn find(self, target: Self) -> Option<usize>;

    pub fn starts_with(self, prefix: Self) -> bool {
        self.len() >= prefix.len()
            && ptr::memcmp(prefix.as_ptr(), self.as_ptr(), prefix.len()) == 0
    }

    pub fn ends_with(self, suffix: Self) -> bool {
        if self.len() < suffix.len() { return false }
        let p = ptr::add(self.as_ptr(), (self.len() - suffix.len()) as isize);
        ptr::memcmp(suffix.as_ptr(), p, suffix.len()) == 0
    }
}

use slice::ToSlice;

pub fn panic<T: ToSlice<char>>(message: T) -> ! {
    panic_handler(message.to_slice());
}

#[extern = "paw_panic_handler"] 
pub fn panic_handler(message: []char) -> !;

pub fn assert(cond: bool) {
    if !cond {
        panic("assertion failure");
    }
}


pub enum ParseIntError {
    Empty,
    InvalidChar,
    InvalidBase,
    Overflow,
}

impl Copy for ParseIntError {}

impl Eq<Self> for ParseIntError {
    fn eq(*self, rhs: *Self) -> bool {
        match (*self, *rhs) {
            (ParseIntError::Empty, ParseIntError::Empty)
            | (ParseIntError::InvalidChar, ParseIntError::InvalidChar)
            | (ParseIntError::InvalidBase, ParseIntError::InvalidBase)
            | (ParseIntError::Overflow, ParseIntError::Overflow) => true,
            _ => false,
        }
    } 
}

pub enum ParseFloatError {
    Empty,
    InvalidChar,
}

impl Copy for ParseFloatError {}

impl Eq<Self> for ParseFloatError {
    fn eq(*self, rhs: *Self) -> bool {
        match (*self, *rhs) {
            (ParseFloatError::Empty, ParseFloatError::Empty)
            | (ParseFloatError::InvalidChar, ParseFloatError::InvalidChar) => true,
            _ => false,
        }
    } 
}

use ptr;

fn skipchar(s: str) -> str {
    str::from_raw_parts(
        ptr::add(s.as_ptr(), 1),
        s.len() - 1)
}

fn char_to_digit(c: char) -> uint64 {
    if '0' <= c && c <= '9' {
        (c as uint8 - '0' as uint8) as uint64
    } else if 'a' <= c && c <= 'z' {
        (c as uint8 - 'a' as uint8 + 10) as uint64
    } else if 'A' <= c && c <= 'Z' {
        (c as uint8 - 'A' as uint8 + 10) as uint64
    } else {
        UINT64_MAX
    }
}

fn parse_uint_radix_nonempty(text: str, base: int64) -> Result<uint64, ParseIntError>
{
    let b = base as uint64;
    if b < 2 || b > 36 {
        return Err(ParseIntError::InvalidBase);
    }

    let value = 0;
    for c in text {
        let v = char_to_digit(*c);
        if v >= b {
            return Err(ParseIntError::InvalidChar);
        }
        if value > (UINT64_MAX - v) / b {
            return Err(ParseIntError::Overflow);
        }
        value = value * b + v;
    }
    Ok(value)
}

#[extern = "paw_internal_parse_float"] 
fn internal_parse_float(text: str, out: *float64) -> int32;


pub use ops::*;
pub use list::*;
pub use map::*;
pub use option::*;
pub use result::*;

pub struct unit: Hash + Equals {
    pub fn to_str(self) -> str { "()" }
    pub fn hash(self) -> int { 0 }
    pub fn eq(self, rhs: Self) -> bool { true }
}

pub struct bool: Hash + Equals {
    pub fn to_str(self) -> str {
        if self {
            "true"
        } else {
            "false"
        }
    }

    pub fn hash(self) -> int { self as int }
    pub fn eq(self, rhs: Self) -> bool { self == rhs }
}

pub struct char: Hash + Equals + Compare + Increment {
    #[extern_std] pub fn to_str(self) -> str;

    pub fn hash(self) -> int { self as int }
    pub fn eq(self, rhs: Self) -> bool { self == rhs }
    pub fn lt(self, rhs: Self) -> bool { self < rhs }
    pub fn le(self, rhs: Self) -> bool { self <= rhs }
    pub fn increment(&self) { 
        // TODO: consider allowing integer arithmetic on type "char"
        // TODO: would look like: "self += 1 as char;"
        self = (self as int + 1) as char; 
    }
}

pub struct int: Hash + Equals + Compare + Increment {
    #[extern_std] pub fn to_str(self) -> str;

    pub fn hash(self) -> int { self }
    pub fn eq(self, rhs: Self) -> bool { self == rhs }
    pub fn lt(self, rhs: Self) -> bool { self < rhs }
    pub fn le(self, rhs: Self) -> bool { self <= rhs }
    pub fn increment(&self) { self += 1; }
}

pub struct float: Hash + Equals + Compare {
    #[extern_std] pub fn to_str(self) -> str;
    #[extern_std] pub fn hash(self) -> int;

    pub fn eq(self, rhs: Self) -> bool { self == rhs }
    pub fn lt(self, rhs: Self) -> bool { self < rhs }
    pub fn le(self, rhs: Self) -> bool { self <= rhs }
}

pub struct str: Hash + Equals + Compare {
    #[extern_std] pub fn parse_int(self) -> Option<int>;
    #[extern_std] pub fn parse_int_radix(self, base: int) -> Option<int>;
    #[extern_std] pub fn parse_float(self) -> Option<float>;
    #[extern_std] pub fn split(self, sep: str) -> [str];
    #[extern_std] pub fn join(self, seq: [str]) -> str;
    #[extern_std] pub fn find(self, target: str) -> Option<int>;
    #[extern_std] pub fn starts_with(self, prefix: str) -> bool;
    #[extern_std] pub fn ends_with(self, suffix: str) -> bool;
    #[extern_std] pub fn hash(self) -> int;

    pub fn to_str(self) -> str { self }
    pub fn eq(self, rhs: Self) -> bool { self == rhs }
    pub fn lt(self, rhs: Self) -> bool { self < rhs }
    pub fn le(self, rhs: Self) -> bool { self <= rhs }
}


#[extern_std] pub fn print(message: str);
#[extern_std] pub fn println(message: str);
#[extern_std] pub fn assert(cond: bool);
#[extern_std] pub fn panic(message: str) -> !;


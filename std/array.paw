use slice;


#[extern]
pub fn repeat<const N: usize, T: Copy>(value: T) -> [N]T;

#[extern]
pub fn uninit<const N: usize, T>() -> [N]T;

#[extern]
pub fn zeros<const N: usize, T>() -> [N]T;


impl<const N: usize, T> [N]T {
    pub fn len(*self) -> usize {
        N
    }
}

impl<const N: usize, T> AsPtr<T> for [N]T {
    fn as_ptr(*self) -> *T {
        self as *char as *T
    }
}

impl<const N: usize, T> ToSlice<T> for [N]T {
    fn to_slice(*self) -> []T {
        slice::from_raw_parts(self.as_ptr(), N)
    }
}

impl<const N: usize, T> Index<usize> for [N]T {
    type Output = T;
    fn index(*self, index: usize) -> *T {
        &self.to_slice()[index]
    }
}

impl<const N: usize, T> IndexRange<Range<usize>> for [N]T {
    type Output = T;
    fn index_range(*self, idx: Range<usize>) -> []T {
        call_index_range(&self.to_slice(), idx)
    }
}

impl<const N: usize, T> IndexRange<RangeInclusive<usize>> for [N]T {
    type Output = T;
    fn index_range(*self, idx: RangeInclusive<usize>) -> []T {
        call_index_range(&self.to_slice(), idx)
    }
}

impl<const N: usize, T> IndexRange<RangeFrom<usize>> for [N]T {
    type Output = T;
    fn index_range(*self, idx: RangeFrom<usize>) -> []T {
        call_index_range(&self.to_slice(), idx)
    }
}

impl<const N: usize, T> IndexRange<RangeTo<usize>> for [N]T {
    type Output = T;
    fn index_range(*self, idx: RangeTo<usize>) -> []T {
        call_index_range(&self.to_slice(), idx)
    }
}

impl<const N: usize, T> IndexRange<RangeToInclusive<usize>> for [N]T {
    type Output = T;
    fn index_range(*self, idx: RangeToInclusive<usize>) -> []T {
        call_index_range(&self.to_slice(), idx)
    }
}

impl<const N: usize, T> IndexRange<RangeFull> for [N]T {
    type Output = T;
    fn index_range(*self, idx: RangeFull) -> []T {
        call_index_range(&self.to_slice(), idx)
    }
}

fn call_index_range<R: IndexRange<Idx>, Idx>(r: *R, index: Idx) -> []R::Output {
    r.index_range(index)
}


pub struct IntoIter<const N: usize, T> {
    inner: [N]T,
    index: usize,
}

use ptr;

impl<const N: usize, T> Iterator for IntoIter<{N}, T> {
    type Item = T;

    fn next(*self) -> Option<Self::Item> {
        if self.index < N {
            let value = ptr::read(&self.inner[self.index]);
            self.index += 1;
            Some(value)
        } else {
            None
        }        
    }
}

impl<const N: usize, T> IntoIterator for [N]T {
    type Item = T;
    type IntoIter = IntoIter<{N}, T>;

    fn into_iter(self) -> Self::IntoIter {
        IntoIter{inner: self, index: 0}
    }
}

impl<const N: usize, T> IntoIterator for *[N]T {
    type Item = *T;
    type IntoIter = slice::Iter<T>;

    fn into_iter(self) -> Self::IntoIter {
        self.to_slice().into_iter()
    }
}


